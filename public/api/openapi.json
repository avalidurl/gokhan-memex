{
  "openapi": "3.1.0",
  "info": {
    "title": "API index",
    "version": "2026-11-14",
    "description": "Seven product APIs are published on this host under /ishtar, /curb, /launch, /plaintext, /accumulator, /numetal and /status. Those paths are proxied to the live workers. The HTML pages do not take a payment. A 402 on a paid path is the worker's challenge and still names the worker host. The remaining entries are the former-domain archive (numetal.xyz, gokhan.vc). Contact: contact@gokhan.vc.",
    "contact": {
      "email": "contact@gokhan.vc",
      "url": "https://gokhanturhan.com/"
    },
    "x-guidance": "Free reads on this host are health checks, fee JSON, status, and the catalog files. They are not payment routes. The paid discovery probe on this host is POST /curb/v1/pay: a bare POST returns HTTP 402 before body validation. The challenge resource URL is still https://curb.numetal.xyz/v1/pay because that worker signs its own host. POST /ishtar/api/chat/ask and POST /launch/api/v1/health are not listed here: a probe of those paths on this host currently receives a Cloudflare challenge instead of the worker 402. Contact: contact@gokhan.vc."
  },
  "servers": [
    {
      "url": "https://api.gokhanturhan.com"
    }
  ],
  "paths": {
