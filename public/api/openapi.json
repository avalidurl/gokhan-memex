    "/ishtar/": {
      "get": {
        "operationId": "free_ishtar_docs",
        "summary": "Ishtar API index page. Not a payment route.",
        "security": [],
        "responses": {
          "200": {
            "description": "HTML index"
          }
        }
      }
    },
    "/curb/v1/pay": {
      "post": {
        "operationId": "curb_discovery_pay",
        "summary": "CURB discovery probe. Bare POST returns 402. No side effects. Real settlement is POST /curb/v1/matches/{id}/pay.",
        "x-payment-info": {
          "protocols": [
            {
              "x402": {}
            }
          ],
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.10"
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "note": {
                    "type": "string",
                    "description": "Optional. Ignored on an unpaid probe."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "402": {
            "description": "Payment Required"
          },
          "200": {
            "description": "Paid probe acknowledgement",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "probe",
                    "message"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "probe": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
