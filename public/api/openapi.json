            "description": "Upstream body, passed through"
          }
        },
        "security": [],
        "operationId": "free_plaintext_health_get"
      }
    },
    "/accumulator/api/wishlist": {
      "get": {
        "summary": "Proxied accumulator wishlist. A check on 2026-11-14 returned a Cloudflare challenge; the origin GET returned 200.",
        "responses": {
