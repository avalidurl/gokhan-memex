                      "description": "How far back the sample history reaches."
                    },
                    "samples": {
                      "type": "integer"
                    },
                    "stale": {
                      "type": "boolean",
                      "description": "true when the reading came from the sample history because upstream was unreachable."
                    },
                    "insufficient_history": {
                      "type": "boolean",
                      "description": "Present when no baseline old enough exists yet."
                    },
                    "reset_detected": {
