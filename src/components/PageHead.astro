---
/** Page header as a boxed container: crumb trail in the header bar, title and lead inside, optional tag row. */
import Tags from '@/components/Tags.astro'

interface Crumb { label: string; href?: string }
interface Props { crumbs: Crumb[]; title: string; lead?: string; stamp?: string; tags?: string[]; count?: string | number; variant?: string }
const { crumbs, title, lead, stamp, tags, count, variant = '' } = Astro.props
const [first, ...rest] = crumbs
---

<section class={`cx hd ${variant}`.trim()} aria-label={title}>
  <div class="cx-h">
    <b>{first.href ? <a href={first.href}>{first.label}</a> : first.label}</b>
    {rest.length > 0 && <span class="trail">{rest.map((c, i) => <>{i > 0 && ' / '}{c.href ? <a href={c.href}>{c.label}</a> : c.label}</>)}</span>}
    {count !== undefined && <em>{count}</em>}
  </div>
  <div class="cx-b">
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
    {stamp && <span class="stamp">{stamp}</span>}
  </div>
  {tags && tags.length > 0 && <div class="cx-r tagrow"><span>Tags</span><span><Tags tags={tags} /></span></div>}
</section>
