---
interface Props {
  url: string
  width?: string | number
  height?: string | number
  autoplay?: boolean
  controls?: boolean
  start?: number
}

const { 
  url, 
  height = 'auto',
  autoplay = false,
  controls = true,
  start = 0
} = Astro.props

function extractYouTubeId(url: string): string | null {
  try {
    const regex = /(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?)\/|.*[?&]v=)|youtu\.be\/)([^"&?\/\s]{11})/
    const match = url.match(regex)
    return match ? match[1] : null
  } catch {
    return null
  }
}

const videoId = extractYouTubeId(url)

const params = new URLSearchParams()
if (!autoplay) params.append('autoplay', '0')
if (!controls) params.append('controls', '0')
if (start > 0) params.append('start', start.toString())
params.append('rel', '0')
params.append('modestbranding', '1')

const embedUrl = videoId ? 
  `https://www.youtube-nocookie.com/embed/${videoId}?${params.toString()}` : 
  null

const aspectHeight = height === 'auto' ? 'aspect-video' : ''
const uniqueId = `youtube-${Math.random().toString(36).substring(2, 11)}`
---

<div class="my-6 not-prose">
  {embedUrl ? (
    <div 
      class="youtube-lazy-container relative"
      data-src={embedUrl}
      data-id={uniqueId}
      data-height={height !== 'auto' ? height : ''}
      data-aspect={aspectHeight}
    >
      <div class={`youtube-placeholder rounded-2xl bg-muted border border-border flex items-center justify-center ${aspectHeight}`} style={height !== 'auto' ? `height: ${height}px` : ''}>
        <div class="text-center p-6">
          <div class="w-14 h-14 rounded-full bg-[var(--btn-bg)] mx-auto mb-3 flex items-center justify-center shadow-md">
            <div class="w-0 h-0 border-l-[10px] border-r-0 border-t-[6px] border-b-[6px] border-l-white border-t-transparent border-b-transparent ml-1"></div>
          </div>
          <button
            class="mt-2 rounded-full border border-primary bg-card px-5 py-2 font-sans text-[14px] font-semibold text-primary hover:bg-primary hover:text-primary-foreground transition-colors"
            onclick="this.parentElement.parentElement.parentElement.querySelector('.youtube-loader').click()"
          >
            Load YouTube Player
          </button>
        </div>
      </div>
      
      <button class="youtube-loader hidden" data-target={uniqueId}></button>
      
      <div class="youtube-iframe-container hidden overflow-hidden rounded-2xl border border-border bg-card">
      </div>
    </div>
  ) : (
    <div class="overflow-hidden rounded-2xl border border-border bg-card">
      <div class="p-6 text-center">
        <p class="text-muted-foreground mb-4">
          Unable to embed YouTube video
        </p>
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center rounded-full border border-[var(--btn-bg)] bg-[var(--btn-bg)] px-5 py-2 font-sans text-[14px] font-semibold text-[var(--btn-fg)] hover:bg-[var(--btn-hover)] hover:border-[var(--btn-hover)] no-underline hover:opacity-90"
        >
          Watch on YouTube
        </a>
      </div>
    </div>
  )}
  
  <div class="mt-2">
    <a 
      href={url} 
      target="_blank" 
      rel="noopener noreferrer"
      class="text-xs text-muted-foreground hover:text-primary no-underline"
    >
      Watch on YouTube ↗
    </a>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          loadYouTubeEmbed(entry.target);
          observer.unobserve(entry.target);
        }
      });
    }, { rootMargin: '50px' });

    document.querySelectorAll('.youtube-lazy-container').forEach(container => {
      observer.observe(container);
      const loader = container.querySelector('.youtube-loader');
      if (loader) {
        loader.addEventListener('click', () => {
          loadYouTubeEmbed(container);
          observer.unobserve(container);
        });
      }
    });

    function loadYouTubeEmbed(container: Element) {
      const src = (container as HTMLElement).dataset.src;
      const height = (container as HTMLElement).dataset.height;
      const aspectHeight = (container as HTMLElement).dataset.aspect;
      const placeholder = container.querySelector('.youtube-placeholder');
      const iframeContainer = container.querySelector('.youtube-iframe-container');
      if (!src || !placeholder || !iframeContainer) return;

      const iframeWrapper = document.createElement('div');
      if (aspectHeight) {
        iframeWrapper.className = `w-full ${aspectHeight}`;
      } else if (height) {
        iframeWrapper.style.height = `${height}px`;
        iframeWrapper.className = 'w-full';
      } else {
        iframeWrapper.className = 'w-full aspect-video';
      }

      const iframe = document.createElement('iframe');
      iframe.className = 'w-full h-full';
      iframe.src = src;
      iframe.setAttribute('frameborder', '0');
      iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');
      iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
      iframe.setAttribute('allowfullscreen', 'true');
      iframe.title = 'YouTube video player';
      iframe.loading = 'eager';
      
      placeholder.innerHTML = `
        <div class="text-center p-6">
          <div class="animate-spin w-8 h-8 border-2 border-primary border-t-transparent rounded-full mx-auto mb-3"></div>
          <div class="text-sm text-muted-foreground">Loading YouTube player...</div>
        </div>
      `;
      
      iframeWrapper.appendChild(iframe);
      iframeContainer.appendChild(iframeWrapper);
      
      iframe.onload = () => {
        placeholder.classList.add('hidden');
        iframeContainer.classList.remove('hidden');
      };
      setTimeout(() => {
        placeholder.classList.add('hidden');
        iframeContainer.classList.remove('hidden');
      }, 5000);
    }
  });
</script>
