---
/**
 * Same-origin subscribe. The Pages function writes the address and sends the confirmation.
 */
interface Props { where?: 'index' | 'post' }
const { where = 'post' } = Astro.props
---
<form
  method="POST"
  action="/newsletter/subscribe"
  class={`subscribe subscribe-${where}`}
  id={where === 'index' ? 'subscribe' : undefined}
>
  <input
    type="email"
    name="email"
    required
    placeholder="you@email.com"
    autocomplete="email"
    aria-label="Email"
  />
  <input type="hidden" name="site" value="memex" />
  <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp" />
  <button type="submit">Subscribe</button>
</form>

<style>
  .subscribe {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    max-width: 440px;
    margin: 0;
  }
  .subscribe-index {
    margin: 0 0 2rem;
  }
  .subscribe-post {
    margin: 0 auto;
  }
  .subscribe input[type="email"] {
    flex: 1;
    min-width: 190px;
    padding: 0.5rem 0.7rem;
    font: inherit;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--ink, currentColor);
    background: var(--card, transparent);
    border: 1px solid var(--line, currentColor);
    border-radius: 6px;
  }
  .subscribe input[type="email"]::placeholder {
    color: var(--dim, gray);
  }
  .subscribe button {
    padding: 0.5rem 0.85rem;
    font: inherit;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--paper, #fff);
    background: var(--link, #002fa7);
    border: 1px solid var(--link, #002fa7);
    border-radius: 6px;
    cursor: pointer;
  }
  .subscribe button:hover,
  .subscribe button:focus-visible {
    background: transparent;
    color: var(--link, #002fa7);
  }
  .hp {
    position: absolute;
    left: -9999px;
    top: -9999px;
  }
</style>
