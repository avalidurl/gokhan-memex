---
/**
 * The email list ran on feedhub. That service is offline.
 * The journal stays on this site; RSS is the follow path.
 */
interface Props { where?: 'index' | 'post' }
const { where = 'post' } = Astro.props
---
<p
  class={`subscribe subscribe-${where}`}
  id={where === 'index' ? 'subscribe' : undefined}
>
  The email list is offline. Follow the journal by <a href="/rss.xml">RSS</a>.
</p>

<style>
  .subscribe {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    max-width: 440px;
    margin: 0;
  }
  .subscribe-index {
    margin: 0 0 2rem;
  }
  .subscribe-post {
    margin: 0 auto;
  }
  .subscribe input[type="email"] {
    flex: 1;
    min-width: 190px;
    padding: 5px 12px;
    font: inherit;
    font-size: 14px;
    line-height: 20px;
    color: var(--ink, currentColor);
    background: transparent;
    border: 1px solid var(--ink, currentColor);
    border-radius: 0;
  }
  .subscribe input[type="email"]::placeholder {
    color: var(--dim, gray);
  }
  .subscribe button {
    padding: 5px 16px;
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
    color: var(--paper, #fff);
    background: var(--ink, #111);
    border: 1px solid var(--ink, #111);
    border-radius: 0;
    cursor: pointer;
  }
  .subscribe button:hover,
  .subscribe button:focus-visible {
    background: transparent;
    color: var(--ink, #111);
  }
</style>
