---
import ThemeToggle from './ThemeToggle.astro'
import SearchComponent from './Search.astro'

interface Props {
  docNo?: string
  docRev?: string
}

const { docNo = 'MX-000' } = Astro.props

const currentPath = Astro.url.pathname
const isArticle = currentPath.startsWith('/journal/') && currentPath !== '/journal/' && currentPath !== '/journal'

const navigation = [
  { name: 'Journal', href: '/journal/' },
  { name: 'Newsletter', href: '/newsletter/' },
  { name: 'Publishing', href: '/publishing/' },
  { name: 'Venture', href: 'https://gokhan.vc', external: true },
  { name: 'Ishtar', href: 'https://ishtar.numetal.xyz', external: true },
  { name: 'CURB', href: 'https://curb.numetal.xyz', external: true },
  { name: 'CLINAMEN', href: 'https://ubu.numetal.xyz', external: true },
  { name: 'Plaintext', href: 'https://plaintext.numetal.xyz', external: true },
  { name: 'Reclaim', href: 'https://reclaim.numetal.xyz', external: true },
  { name: 'Numetal Lab', href: 'https://numetal.xyz', external: true },
  { name: 'CV', href: '/cv/' }
]
---

<header class="top-header">
  <div class="bar">
    <!-- Left side: Logo/Name or Back button -->
    <div class="flex items-center gap-2.5">
      {isArticle ? (
        <a
          href="/journal"
          class="pill-btn"
          aria-label="Back to Journal"
        >
          ← Journal
        </a>
      ) : (
        <a
          class="logo"
          href="/"
        >
          Gökhan <span>Turhan</span>
          <small class="hidden sm:inline">{docNo}</small>
        </a>
      )}
    </div>

    <!-- Center: Navigation Links (Desktop only, not on article pages) -->
    {!isArticle && (
      <nav class="hidden md:flex flex-1 flex-wrap items-center gap-x-3.5 gap-y-1 min-w-0" aria-label="Main navigation">
        {navigation.map((item) => {
          const active = !item.external && (currentPath === item.href || currentPath.startsWith(item.href.replace(/\/$/, '') + '/'))
          return (
            <a
              href={item.href}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
              class={`nav-link ${active ? 'is-active' : ''}`}
            >
              {item.name}{item.external && <span class="nav-ext" aria-hidden="true">↗</span>}
            </a>
          )
        })}
      </nav>
    )}

    <!-- Right side: Actions -->
    <div class="controls">
      <div class="seg" role="group" aria-label="Site controls">
        <button
          id="search-button"
          class="seg-btn"
          aria-label="Search"
          title="Search (⌘K)"
          type="button"
        >
          Search
        </button>
        <ThemeToggle />
      </div>

      {!isArticle && (
        <button
          id="mobile-menu-button"
          class="pill-btn mobile-only-btn md:hidden"
          aria-label="Toggle menu"
          aria-controls="mobile-menu"
          aria-expanded="false"
          type="button"
        >
          <span id="menu-icon">Menu</span>
          <span id="close-icon" class="hidden">Close</span>
        </button>
      )}
    </div>
  </div>
</header>

{!isArticle && (
  <div
    id="mobile-menu"
    class="fixed inset-0 z-50 hidden overflow-y-auto md:hidden mobile-sheet"
    aria-hidden="true"
  >
    <div class="mobile-sheet-top">
      <a class="logo" href="/">Gökhan <span>Turhan</span></a>
      <button
        id="mobile-menu-close"
        class="pill-btn"
        type="button"
        aria-label="Close menu"
      >
        Close ×
      </button>
    </div>
    <nav class="mm-nav flex flex-col px-6 py-4" aria-label="Mobile navigation">
      {navigation.map((item) => {
        const active = !item.external && (currentPath === item.href || currentPath.startsWith(item.href.replace(/\/$/, '') + '/'))
        return (
          <a
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
            class={`mobile-menu-link ${active ? 'is-active' : ''}`}
          >
            <span>{item.name}</span>
            {item.external && <span class="nav-ext" aria-hidden="true">↗</span>}
          </a>
        )
      })}
      <a
        href="/rss.xml"
        class="mobile-menu-link"
      >
        <span>RSS Feed</span>
      </a>
    </nav>
  </div>
)}

<!-- Search Modal -->
<SearchComponent />

<script is:inline>
  (() => {
    function initNavigation() {
      const button = document.getElementById('mobile-menu-button')
      const closeBtn = document.getElementById('mobile-menu-close')
      const menu = document.getElementById('mobile-menu')
      const menuIcon = document.getElementById('menu-icon')
      const closeIcon = document.getElementById('close-icon')

      if (!(button instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return
      if (button.dataset.initialized === 'true') return
      button.dataset.initialized = 'true'

      const setOpen = (open) => {
        button.setAttribute('aria-expanded', open ? 'true' : 'false')
        menu.setAttribute('aria-hidden', open ? 'false' : 'true')
        menu.classList.toggle('hidden', !open)
        menuIcon?.classList.toggle('hidden', open)
        closeIcon?.classList.toggle('hidden', !open)
        document.body.style.overflow = open ? 'hidden' : ''
      }

      setOpen(false)

      button.addEventListener('click', () => {
        const isOpen = button.getAttribute('aria-expanded') === 'true'
        setOpen(!isOpen)
      })

      closeBtn?.addEventListener('click', () => setOpen(false))

      menu.querySelectorAll('.mobile-menu-link').forEach((link) => {
        link.addEventListener('click', () => setOpen(false))
      })

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setOpen(false)
      })

      window.addEventListener('pageshow', () => setOpen(false))
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initNavigation, { once: true })
    } else {
      initNavigation()
    }

    document.addEventListener('astro:page-load', initNavigation)
  })()
</script>

<style>
  .top-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--header-bg);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 11px 20px;
    flex-wrap: wrap;
  }

  .logo {
    font-family: var(--font-sans);
    font-weight: 700;
    letter-spacing: 0.01em;
    text-decoration: none;
    color: var(--ink);
    font-size: 16px;
    white-space: nowrap;
  }

  .logo:hover {
    color: var(--ink);
  }

  .logo span {
    color: var(--acc);
  }

  .logo small {
    font-weight: 500;
    color: var(--mut);
    font-size: 11.5px;
    margin-left: 6px;
    letter-spacing: 0.04em;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: 13.5px;
    color: var(--mut);
    text-decoration: none;
    white-space: nowrap;
    padding: 3px 0;
    transition: color 0.15s;
  }

  .nav-link:hover {
    color: var(--acc);
  }

  .nav-link.is-active {
    color: var(--acc);
    font-weight: 600;
  }

  .nav-ext {
    margin-left: 2px;
    font-size: 0.82em;
    opacity: 0.65;
  }

  .controls {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .seg {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 999px;
    overflow: hidden;
    font-size: 13px;
    background: var(--card-bg);
  }

  .seg-btn {
    border: 0;
    border-right: 1px solid var(--line);
    background: none;
    padding: 6px 13px;
    cursor: pointer;
    color: var(--mut);
    font-family: var(--font-sans);
    font-size: 12.5px;
    font-weight: 500;
    transition: color 0.15s, background 0.15s;
  }

  .seg-btn:hover {
    color: var(--acc);
    background: var(--soft-hover);
  }

  .pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--card-bg);
    color: var(--mut);
    padding: 6px 14px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }

  .pill-btn:hover {
    border-color: var(--acc);
    color: var(--acc);
    background: var(--soft-hover);
  }

  .mobile-sheet {
    background: var(--bg);
  }

  .mobile-sheet-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px solid var(--line);
  }

  .mobile-menu-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    padding: 14px 4px;
    font-family: var(--font-serif);
    font-size: 20px;
    color: var(--ink);
    text-decoration: none;
  }

  .mobile-menu-link:hover,
  .mobile-menu-link.is-active {
    color: var(--acc);
  }

  @media (min-width: 768px) {
    .mobile-only-btn { display: none !important; }
  }
</style>

<!-- Site-wide hover link popups -->
<script src="/popups.js" defer></script>
