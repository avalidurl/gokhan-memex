---
import Card from '@/components/ui/Card.astro'
import CardContent from '@/components/ui/CardContent.astro'

export interface Props {
  name: string
  url: string
  description: string
}

const { name, url, description } = Astro.props
---

<a
  href={url}
  target={url.startsWith('http') ? '_blank' : undefined}
  rel={url.startsWith('http') ? 'noopener noreferrer' : undefined}
  class="block no-underline"
>
  <Card class="cursor-pointer h-full hover:border-primary transition-colors">
    <CardContent class="p-6">
      <div class="flex items-start justify-between mb-2.5">
        <h3 class="font-serif text-[20px] font-bold leading-[1.28] text-foreground m-0">{name}</h3>
        <span class="text-muted-foreground flex-shrink-0 ml-2" aria-hidden="true">↗</span>
      </div>
      <p class="text-sm text-muted-foreground mb-4">
        {description}
      </p>
      <div class="inline-flex items-center text-sm font-semibold text-primary">
        {url.startsWith('mailto:') ? 'Contact' : 
         url.startsWith('http') ? 'Visit' : 'View'}
        →
      </div>
    </CardContent>
  </Card>
</a>
