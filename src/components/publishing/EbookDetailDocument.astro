---
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { Ebook } from '@/data/ebooks'

const { ebook } = Astro.props as { ebook: Ebook }

const publishedLabel = new Date(ebook.publishedOn).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})

const summarySentences = ebook.summarySentences?.length ? ebook.summarySentences : [ebook.blurb]
---

<BaseLayout
  title={ebook.title}
  description={ebook.description}
  image={ebook.socialImage ?? ebook.coverImage}
  breadcrumbOverride={{
    items: [
      { label: 'Publishing', href: '/publishing/' },
      { label: 'E-books', href: '/publishing/ebooks/' },
    ],
    currentPage: ebook.title,
  }}
>
  <div class="ebook-document mx-auto max-w-5xl px-5 py-10 lg:py-14">
    <section class="grid gap-8 rounded-2xl border border-border bg-card p-6 sm:p-8 lg:grid-cols-[300px_1fr] lg:items-start">
      <div class="lg:sticky lg:top-24">
        <img
          src={ebook.coverImage}
          alt={`Cover art for ${ebook.title}`}
          class="w-full rounded-xl border border-border object-cover shadow-sm"
        />
      </div>

      <div>
        <div class="kicker-pill mb-3">Publishing / E-books</div>
        <h1 class="mb-3">{ebook.title}</h1>
        <p class="mb-4 max-w-2xl font-serif text-[19px] text-muted-foreground">{ebook.subtitle}</p>

        <div class="mb-5 flex flex-wrap gap-2 text-xs">
          <span class="rounded-full border border-border bg-muted px-3 py-1 font-medium text-foreground">{ebook.author}</span>
          <span class="rounded-full border border-border bg-muted px-3 py-1 text-muted-foreground">{publishedLabel}</span>
          <span class="rounded-full border border-border bg-muted px-3 py-1 text-muted-foreground">{ebook.pageCount} pages</span>
          <span class="rounded-full border border-border bg-muted px-3 py-1 text-muted-foreground">{ebook.lineCount} lines</span>
        </div>

        <p class="font-serif max-w-3xl text-[18px] leading-relaxed text-foreground/90">{ebook.blurb}</p>

        <div class="mt-7 flex flex-wrap gap-2.5">
          <a
            href={ebook.browserEditionUrl}
            class="inline-flex items-center rounded-full border border-[var(--btn-bg)] bg-[var(--btn-bg)] px-5 py-2.5 text-[14px] font-semibold text-[var(--btn-fg)] hover:bg-[var(--btn-hover)] hover:border-[var(--btn-hover)] no-underline hover:opacity-90 transition-opacity"
          >
            Open HTML edition
          </a>
          <a
            href={ebook.epubUrl}
            class="tile"
            download
          >
            Download EPUB
          </a>
          <a
            href={ebook.staticHtmlUrl}
            class="inline-flex items-center rounded-full border border-border bg-background px-4 py-2 text-[13.5px] font-semibold text-muted-foreground no-underline hover:border-primary hover:text-primary transition-colors"
            target="_blank"
            rel="noopener"
          >
            Raw HTML export ↗
          </a>
          {ebook.sourceTextUrl ? (
            <a
              href={ebook.sourceTextUrl}
              class="inline-flex items-center rounded-full border border-border bg-background px-4 py-2 text-[13.5px] font-semibold text-muted-foreground no-underline hover:border-primary hover:text-primary transition-colors"
              download
            >
              Download source text
            </a>
          ) : null}
          {ebook.fontUrl ? (
            <a
              href={ebook.fontUrl}
              class="inline-flex items-center rounded-full border border-border bg-background px-4 py-2 text-[13.5px] font-semibold text-muted-foreground no-underline hover:border-primary hover:text-primary transition-colors"
              download
            >
              Download font
            </a>
          ) : null}
        </div>
      </div>
    </section>

    <section class="mt-8 grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
      <div class="rounded-2xl border border-border bg-card p-6 sm:p-7">
        <p class="doc-eyebrow mb-3">Info</p>
        <div class="space-y-4">
          {summarySentences.map((sentence) => (
            <p class="font-serif mb-0 text-[17.5px] leading-relaxed text-foreground/90">{sentence}</p>
          ))}
        </div>
      </div>

      <div class="rounded-2xl border border-border bg-card p-6 sm:p-7">
        <h2 class="mb-4 font-serif text-[23px] font-bold">Table of Contents</h2>
        <ol class="space-y-2 text-[15.5px] leading-7 pl-5 m-0">
          {ebook.toc.map((entry) => (
            <li>
              <a href={`${ebook.browserEditionUrl}#${entry.anchor}`} class="doc-link">
                {entry.number}. {entry.title}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .ebook-document { color: var(--ink); }
  .ebook-document .doc-eyebrow {
    color: var(--acc);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .ebook-document .doc-link {
    color: var(--acc);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ebook-document .doc-link:hover { color: var(--acc-dark); }
</style>
