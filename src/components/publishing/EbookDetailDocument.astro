---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHead from '@/components/PageHead.astro'
import Tags from '@/components/Tags.astro'
import type { Ebook } from '@/data/ebooks'
import { works } from '@/data/works'

const { ebook } = Astro.props as { ebook: Ebook }
const publishedLabel = new Date(ebook.publishedOn).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
const summarySentences = ebook.summarySentences?.length ? ebook.summarySentences : [ebook.blurb]
const work = works.find((w) => w.kind === 'E-book' && w.slug === ebook.slug)!
const others = works.filter((w) => w !== work)
---

<BaseLayout title={ebook.title} description={ebook.description} image={ebook.socialImage ?? ebook.coverImage}>
  <div class="es">
    <PageHead crumbs={[{ label: 'Publishing', href: '/publishing/' }, { label: 'E-books', href: '/publishing/ebooks/' }, { label: ebook.title }]} title={ebook.title} lead={ebook.subtitle} tags={work.tags} />

    <div class="pgrid">
      <div class="pmain">
        <section class="cx" aria-label="About">
          <div class="cx-h"><b>About</b><span>{ebook.author} · {publishedLabel}</span></div>
          <div class="cx-b body">
            <p>{ebook.blurb}</p>
            {summarySentences.filter((t) => t !== ebook.blurb).map((t) => <p>{t}</p>)}
          </div>
        </section>

        <section class="cx" aria-label="Table of contents">
          <div class="cx-h"><b>Table of contents</b><em>{String(ebook.toc.length).padStart(2, '0')}</em></div>
          {ebook.toc.map((entry) => (
            <div class="cx-r"><span>{entry.number}</span><span><a href={`${ebook.browserEditionUrl}#${entry.anchor}`}>{entry.title}</a></span></div>
          ))}
        </section>

        <section class="cx" aria-label="Cover">
          <div class="cx-h"><b>Cover</b></div>
          <div class="cx-b"><img src={ebook.coverImage} alt={`Cover art for ${ebook.title}`} class="work-cover" /></div>
        </section>
      </div>

      <aside class="pside">
        <section class="cx" aria-label="Facts">
          <div class="cx-h"><b>Facts</b><span>E-book</span></div>
          <div class="cx-r"><span>Author</span><span>{ebook.author}</span></div>
          <div class="cx-r"><span>Published</span><span>{publishedLabel}</span></div>
          <div class="cx-r"><span>Length</span><span>{ebook.pageCount} pages · {ebook.lineCount} lines</span></div>
          {ebook.protocols?.length > 0 && <div class="cx-r"><span>Protocols</span><span>{ebook.protocols.join(' · ')}</span></div>}
          <div class="cx-r"><span>Tags</span><span><Tags tags={work.tags} /></span></div>
        </section>

        <section class="cx" aria-label="Read and download">
          <div class="cx-h"><b>Read</b><span>and download</span></div>
          <div class="cx-r"><span>Read</span><span><a href={ebook.browserEditionUrl}>HTML edition</a></span></div>
          <div class="cx-r"><span>EPUB</span><span><a href={ebook.epubUrl} download>Download EPUB</a></span></div>
          <div class="cx-r"><span>Raw</span><span><a href={ebook.staticHtmlUrl} target="_blank" rel="noopener">Raw HTML export</a></span></div>
          {ebook.sourceTextUrl && <div class="cx-r"><span>Source</span><span><a href={ebook.sourceTextUrl} download>Source text</a></span></div>}
          {ebook.fontUrl && <div class="cx-r"><span>Font</span><span><a href={ebook.fontUrl} download>Download font</a></span></div>}
        </section>

        <section class="cx" aria-label="More publishing">
          <div class="cx-h"><b>Publishing</b><span>other works</span></div>
          {others.map((w) => <div class="cx-r"><span>{w.kind}</span><span><a href={w.href}>{w.title}</a></span></div>)}
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .ebook-document {
    color: var(--ink);
    /* R2 — running prose. The R4 identifiers inside (eyebrows, doc numbers,
       line numbers, labels) re-assert the data face themselves. */
    font-family: var(--font-text);
  }

  .ebook-document .doc-eyebrow {
    color: var(--dim);
    font-family: var(--font-data);
    font-size: 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ebook-document .doc-link {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }

  .ebook-document .doc-link:visited {
    color: var(--dim);
  }
</style>
