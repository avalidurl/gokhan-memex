---
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { Ebook } from '@/data/ebooks'
import { loadEbookLines, paginateEbookLines, loadAsemicData, groupIntoVerses, paginateVerses } from '@/lib/ebook-reader'

const { ebook } = Astro.props as { ebook: Ebook }

const lines = loadEbookLines(ebook)
const isVerseMode = Boolean(ebook.asemicDataPath && ebook.linesPerVerse)

const asemicData = isVerseMode ? loadAsemicData(ebook.asemicDataPath!) : undefined
const verses = isVerseMode ? groupIntoVerses(lines, ebook.linesPerVerse!, asemicData) : undefined
const versePages = isVerseMode ? paginateVerses(verses!, ebook.linesPerPage / ebook.linesPerVerse!) : undefined

const pages = isVerseMode ? null : paginateEbookLines(lines, ebook.linesPerPage)
const pageJumpLinks = isVerseMode
  ? versePages!.filter((p) => p.pageNumber === 1 || p.pageNumber % 5 === 0)
  : pages!.filter((p) => p.pageNumber === 1 || p.pageNumber % 5 === 0)
const cantoStartLines = new Map(ebook.toc.map((entry) => [entry.startLine, entry]))
---

<BaseLayout
  title={`${ebook.title} | Read Online`}
  description={`Read ${ebook.title} online in HTML with page-numbered sections.`}
  image={ebook.coverImage}
  breadcrumbOverride={{
    items: [
      { label: 'Publishing', href: '/publishing/' },
      { label: 'E-books', href: '/publishing/ebooks/' },
      { label: ebook.title, href: `/publishing/ebooks/${ebook.slug}/` },
    ],
    currentPage: 'Read online',
  }}
>
  {isVerseMode && (
    <style set:html={`
      @font-face {
        font-family: 'TheGuyWithComputeRaga';
        src: url('/publishing/ebooks/the-guy-with-compute/font.ttf') format('truetype');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
    `} />
  )}

  <div id="top" class="reader-document mx-auto max-w-5xl px-5 py-10 lg:py-14">
    <section class="rounded-2xl border border-border bg-card p-6 sm:p-8">
      <div class="grid gap-8 lg:grid-cols-[220px_1fr]">
        <img
          src={ebook.coverImage}
          alt={`Cover art for ${ebook.title}`}
          class="w-full rounded-xl border border-border object-cover shadow-sm"
        />

        <div>
          <div class="kicker-pill mb-3">Online Reader</div>
          <h1 class="mb-3">{ebook.title}</h1>
          <p class="mb-3 max-w-2xl font-serif text-[19px] text-muted-foreground">{ebook.subtitle}</p>
          <p class="font-serif mb-5 text-[17.5px] leading-relaxed text-foreground/90">{ebook.blurb}</p>

          <div class="mb-6 flex flex-wrap gap-2 text-xs">
            <span class="rounded-full border border-border bg-muted px-3 py-1 font-medium text-foreground">By {ebook.author}</span>
            <span class="rounded-full border border-border bg-muted px-3 py-1 text-muted-foreground">{ebook.pageCount} pages</span>
            <span class="rounded-full border border-border bg-muted px-3 py-1 text-muted-foreground">{ebook.lineCount} numbered lines</span>
          </div>

          <div class="rounded-xl border border-border bg-muted/50 p-4 mb-6">
            <p class="doc-eyebrow mb-1.5">Inside cover</p>
            <p class="mb-0.5 font-serif text-lg font-bold text-foreground">{ebook.title}</p>
            <p class="mb-1 text-sm text-muted-foreground">{ebook.subtitle}</p>
            <p class="mb-0 text-sm text-foreground/90">{ebook.author}</p>
            {ebook.website ? <p class="mb-0 text-sm text-muted-foreground">{ebook.website}</p> : null}
          </div>

          <div class="flex flex-wrap gap-2.5">
            <a href={ebook.epubUrl} class="tile" download>Download EPUB</a>
            <a href={ebook.staticHtmlUrl} class="inline-flex items-center rounded-full border border-border bg-background px-4 py-2 text-[13.5px] font-semibold text-muted-foreground no-underline hover:border-primary hover:text-primary transition-colors" target="_blank" rel="noopener">Raw HTML export ↗</a>
            {ebook.sourceTextUrl ? (
              <a href={ebook.sourceTextUrl} class="inline-flex items-center rounded-full border border-border bg-background px-4 py-2 text-[13.5px] font-semibold text-muted-foreground no-underline hover:border-primary hover:text-primary transition-colors" download>Download source text</a>
            ) : null}
            {ebook.fontUrl ? (
              <a href={ebook.fontUrl} class="inline-flex items-center rounded-full border border-border bg-background px-4 py-2 text-[13.5px] font-semibold text-muted-foreground no-underline hover:border-primary hover:text-primary transition-colors" download>Download font</a>
            ) : null}
          </div>
        </div>
      </div>
    </section>

    <div class="mt-6 grid gap-6 lg:grid-cols-2">
      <nav class="rounded-2xl border border-border bg-card p-6">
        <p class="doc-eyebrow mb-3">Page numbers</p>
        <div class="flex flex-wrap gap-2">
          {pageJumpLinks.map((page) => (
            <a href={`#page-${page.pageNumber}`} class="rounded-full border border-border bg-background px-3 py-1 text-xs font-semibold text-muted-foreground no-underline hover:border-primary hover:text-primary transition-colors">Page {page.pageNumber}</a>
          ))}
        </div>
      </nav>

      <nav class="rounded-2xl border border-border bg-card p-6">
        <h2 class="mb-3 font-serif text-[22px] font-bold">Table of Contents</h2>
        <ol class="space-y-1.5 pl-5 text-[15px] leading-6 text-foreground/90 m-0">
          {ebook.toc.map((entry) => (
            <li>
              <a href={`#${entry.anchor}`} class="doc-link">{entry.number}. {entry.title}</a>
            </li>
          ))}
        </ol>
      </nav>
    </div>

    <div class="mt-8 space-y-6">
      {isVerseMode ? (
        versePages!.map((page) => (
          <section id={`page-${page.pageNumber}`} class="rounded-2xl border border-border bg-card p-6 sm:p-8">
            <div class="flex items-center justify-between gap-4 border-b border-border pb-4">
              <div>
                <p class="doc-eyebrow mb-1">Page {page.pageNumber}</p>
                <p class="text-xs text-muted-foreground m-0">
                  Lines {String(page.verses[0]?.lines[0]?.number ?? 0).padStart(4, '0')} to {String(page.verses[page.verses.length - 1]?.lines.at(-1)?.number ?? 0).padStart(4, '0')}
                </p>
              </div>
              <a href="#top" class="doc-link text-sm">Back to top ↑</a>
            </div>

            <div class="mt-6 space-y-8">
              {page.verses.map((verse) => {
                const firstLine = verse.lines[0]
                const cantoEntry = cantoStartLines.get(firstLine?.number ?? -1)

                return (
                  <div>
                    {cantoEntry ? (
                      <div id={cantoEntry.anchor} class="mb-4 scroll-mt-24 border-b border-border pb-3">
                        <p class="doc-eyebrow mb-1">Canto {cantoEntry.number}</p>
                        <h2 class="m-0">{cantoEntry.title}</h2>
                      </div>
                    ) : null}
                    <article class="verse-spread">
                      <div class="verse-asemic">
                        {verse.asemic?.map((row) => <div>{row}</div>)}
                      </div>
                      <div class="verse-english font-serif">
                        {verse.lines.map((line) => (
                          <p class="grid grid-cols-[3.75rem_1fr] gap-4 text-[16.5px] mb-1.5">
                            <span class="doc-line-number">{String(line.number).padStart(4, '0')}</span>
                            <span>{line.text}</span>
                          </p>
                        ))}
                      </div>
                    </article>
                  </div>
                )
              })}
            </div>
          </section>
        ))
      ) : (
        pages!.map((page) => (
          <section id={`page-${page.pageNumber}`} class="rounded-2xl border border-border bg-card p-6 sm:p-8">
            <div class="flex items-center justify-between gap-4 border-b border-border pb-4">
              <div>
                <p class="doc-eyebrow mb-1">Page {page.pageNumber}</p>
                <p class="text-xs text-muted-foreground m-0">
                  Lines {String(page.lines[0]?.number ?? 0).padStart(4, '0')} to {String(page.lines[page.lines.length - 1]?.number ?? 0).padStart(4, '0')}
                </p>
              </div>
              <a href="#top" class="doc-link text-sm">Back to top ↑</a>
            </div>

            <div class="mt-6 space-y-2.5 font-serif">
              {page.lines.map((line) => {
                const cantoEntry = cantoStartLines.get(line.number)
                return (
                  <div class="space-y-2.5">
                    {cantoEntry ? (
                      <div id={cantoEntry.anchor} class="mb-2 mt-4 scroll-mt-24 border-b border-border pb-3">
                        <p class="doc-eyebrow mb-1">Canto {cantoEntry.number}</p>
                        <h2 class="m-0">{cantoEntry.title}</h2>
                      </div>
                    ) : null}
                    <p class="grid grid-cols-[3.75rem_1fr] gap-4 text-[17px] mb-0">
                      <span class="doc-line-number">{String(line.number).padStart(4, '0')}</span>
                      <span>{line.text}</span>
                    </p>
                  </div>
                )
              })}
            </div>
          </section>
        ))
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .reader-document { color: var(--ink); }
  .reader-document .doc-eyebrow {
    color: var(--acc);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .reader-document .doc-link {
    color: var(--acc);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .reader-document .doc-link:hover { color: var(--acc-dark); }
  .reader-document .doc-line-number {
    color: var(--mut);
    font-family: var(--font-data);
    font-size: 12px;
    letter-spacing: 0.04em;
    min-width: 3.75rem;
    padding-top: 0.2em;
  }
  .verse-spread {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 36px;
    align-items: start;
  }
  .verse-asemic {
    font-family: 'TheGuyWithComputeRaga', var(--font-data);
    font-size: 34px;
    line-height: 1.55;
    letter-spacing: 0.06em;
    color: var(--ink);
    font-feature-settings: 'liga' 0, 'clig' 0;
    font-variant-numeric: lining-nums;
  }
  .verse-asemic div { margin: 0.05em 0; }
  @media (max-width: 760px) {
    .verse-spread { grid-template-columns: 1fr; gap: 14px; }
  }
</style>
