---
import Button from './ui/Button.astro'
---

<div id="privacy-notice" class="privacy-card fixed bottom-4 left-4 right-4 md:left-auto md:right-5 z-50 max-w-sm md:max-w-sm p-4 hidden">
  <div class="flex items-start gap-3">
    <div class="flex-1">
      <p class="text-[13.5px] leading-relaxed text-foreground mb-3">
        This site uses Google Analytics to track usage and improve content. You can opt out anytime. 
        <a href="/privacy" class="text-primary underline underline-offset-2">Learn more</a>
      </p>
      <div class="flex gap-2">
        <Button variant="outline" size="sm" id="decline-privacy" class="text-xs h-8 px-3.5">
          Opt Out
        </Button>
        <Button size="sm" id="accept-privacy" class="text-xs h-8 px-3.5">
          Keep Analytics
        </Button>
      </div>
    </div>
    <Button variant="ghost" size="sm" id="close-privacy" class="h-7 w-7 p-0 flex-shrink-0 rounded-full">
      <span aria-hidden="true">×</span>
      <span class="sr-only">Close</span>
    </Button>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const notice = document.getElementById('privacy-notice')
    const acceptBtn = document.getElementById('accept-privacy')
    const declineBtn = document.getElementById('decline-privacy')
    const closeBtn = document.getElementById('close-privacy')
    
    const privacyChoice = localStorage.getItem('privacy-choice')
    const isPublishingRoute = window.location.pathname.startsWith('/publishing/')
    const isSmallScreen = window.matchMedia('(max-width: 640px)').matches
    const showDelay = isPublishingRoute || isSmallScreen ? 8000 : 2000
    
    if (!privacyChoice) {
      setTimeout(() => {
        notice?.classList.remove('hidden')
      }, showDelay)
    }
    
    acceptBtn?.addEventListener('click', () => {
      localStorage.setItem('privacy-choice', 'accepted')
      hideNotice()
      if (typeof window.enableGoogleAnalytics === 'function') {
        window.enableGoogleAnalytics()
      }
    })
    
    declineBtn?.addEventListener('click', () => {
      localStorage.setItem('privacy-choice', 'declined')
      hideNotice()
      if (typeof window.disableGoogleAnalytics === 'function') {
        window.disableGoogleAnalytics()
      }
    })
    
    closeBtn?.addEventListener('click', () => {
      localStorage.setItem('privacy-choice', 'accepted')
      hideNotice()
    })
    
    function hideNotice() {
      notice?.classList.add('hidden')
    }
  })
</script>

<style>
  .privacy-card {
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: 0 14px 36px rgba(15, 23, 48, 0.14);
  }

  @media (max-width: 640px) {
    #privacy-notice {
      bottom: 0.75rem;
      left: 0.75rem;
      right: 0.75rem;
      max-width: none;
      padding: 0.9rem;
    }

    #privacy-notice p {
      margin-bottom: 0.75rem;
    }

    #privacy-notice .flex.gap-2 {
      flex-wrap: wrap;
    }
  }
</style>
