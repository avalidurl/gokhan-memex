---
import type { BreadcrumbItem } from '@/lib/breadcrumbs'

export type { BreadcrumbItem }

interface Props {
  items: BreadcrumbItem[]
  currentPage: string
}

const { items, currentPage } = Astro.props
---

<nav aria-label="breadcrumb" class="mb-4 overflow-x-auto pb-1">
  <ol class="flex min-w-max items-center gap-2 whitespace-nowrap font-sans text-[13px] text-muted-foreground">
    <li>
      <a
        href="/"
        class="hover:text-primary transition-colors"
        aria-label="Home"
      >
        Index
      </a>
    </li>

    {items.map((item) => (
      <>
        <li class="flex-shrink-0 opacity-60" aria-hidden="true">/</li>
        <li class="flex-shrink-0">
          <a
            href={item.href}
            class="hover:text-primary transition-colors"
          >
            {item.label}
          </a>
        </li>
      </>
    ))}

    {currentPage && (
      <>
        <li class="flex-shrink-0 opacity-60" aria-hidden="true">/</li>
        <li class="max-w-[14rem] truncate text-foreground font-medium sm:max-w-none" title={currentPage}>
          {currentPage}
        </li>
      </>
    )}
  </ol>
</nav>
