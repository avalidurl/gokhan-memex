---
export interface Props {
  name: string
  url: string
  description: string
  category?: string
}

const { name, url, description } = Astro.props
const isExternal = url.startsWith('http')
---

<a 
  href={url} 
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener" : undefined}
  class="block rounded-2xl border border-border bg-card p-5 no-underline hover:border-primary transition-colors group"
>
  <div class="flex-1">
    <h3 class="font-serif text-[20px] font-bold leading-[1.28] text-foreground group-hover:text-primary m-0">
      {name}
    </h3>
    <p class="text-sm text-muted-foreground mt-1.5 mb-0">{description}</p>
  </div>
</a>
