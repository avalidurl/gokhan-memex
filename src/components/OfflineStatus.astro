---
// Offline Status Component
---

<div id="offline-status" class="fixed bottom-4 right-4 z-50 max-w-sm hidden">
  <div id="offline-notification" class="status-toast p-4 mb-2 hidden">
    <div class="flex items-center justify-between gap-3">
      <div>
        <p class="font-semibold text-sm m-0">You're offline</p>
        <p class="text-xs text-muted-foreground m-0">Cached content still available</p>
      </div>
      <button onclick="this.parentElement.parentElement.classList.add('hidden')" class="opacity-70 hover:opacity-100 px-1">
        <span aria-hidden="true">×</span>
      </button>
    </div>
  </div>

  <div id="online-notification" class="status-toast p-4 mb-2 hidden">
    <div class="flex items-center justify-between gap-3">
      <div>
        <p class="font-semibold text-sm m-0">Back online</p>
        <p class="text-xs text-muted-foreground m-0">All content synced</p>
      </div>
      <button onclick="this.parentElement.parentElement.classList.add('hidden')" class="opacity-70 hover:opacity-100 px-1">
        <span aria-hidden="true">×</span>
      </button>
    </div>
  </div>

  <div id="cache-notification" class="status-toast p-4 mb-2 hidden">
    <div class="flex items-center justify-between gap-3">
      <div class="flex-1">
        <p class="font-semibold text-sm m-0">Content cached</p>
        <p class="text-xs text-muted-foreground m-0">Available for offline reading</p>
      </div>
      <button onclick="this.parentElement.parentElement.classList.add('hidden')" class="opacity-70 hover:opacity-100 px-1">
        <span aria-hidden="true">×</span>
      </button>
    </div>
  </div>

  <div id="sw-update-notification" class="status-toast p-4 mb-2 hidden">
    <div class="flex items-center justify-between gap-3">
      <div class="flex-1">
        <p class="font-semibold text-sm m-0">Update available</p>
        <p class="text-xs text-muted-foreground m-0">Refresh to get the latest version</p>
      </div>
      <div class="ml-2 flex items-center gap-2">
        <button 
          onclick="offlineStatus.applyUpdate()" 
          class="rounded-full border border-primary bg-primary px-3 py-1 text-xs font-semibold text-primary-foreground hover:opacity-90"
        >
          Update
        </button>
        <button 
          onclick="this.closest('#sw-update-notification').classList.add('hidden')" 
          class="opacity-70 hover:opacity-100 px-1"
        >
          <span aria-hidden="true">×</span>
        </button>
      </div>
    </div>
  </div>

  <div id="offline-reading-btn" class="hidden">
    <a 
      href="/offline/" 
      class="status-toast flex items-center p-3.5 no-underline hover:border-primary transition-colors"
    >
      <div>
        <p class="font-semibold text-sm text-foreground m-0">Offline Reading</p>
        <p class="text-xs text-muted-foreground m-0">Browse cached content</p>
      </div>
    </a>
  </div>
</div>

<style>
  .status-toast {
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: 16px;
    color: var(--ink);
    box-shadow: 0 12px 32px rgba(42, 26, 30, 0.14);
  }
</style>

<script>
  declare global {
    interface Window {
      offlineStatus: OfflineStatusManager;
      serviceWorkerManager: any;
    }
  }

  class OfflineStatusManager {
    statusElement: HTMLElement | null;
    isVisible: boolean;
    hideTimeout: number | null;

    constructor() {
      this.statusElement = null;
      this.isVisible = false;
      this.hideTimeout = null;
      this.init();
    }

    init() {
      this.statusElement = document.getElementById('offline-status');
      if (!this.statusElement) return;

      this.setupEventListeners();
      this.updateStatus();
    }

    setupEventListeners() {
      window.addEventListener('online', () => this.handleOnline());
      window.addEventListener('offline', () => this.handleOffline());

      window.addEventListener('message', (event) => {
        if (event.data?.source === 'service-worker-manager') {
          this.handleServiceWorkerMessage(event.data);
        }
      });

      if (!navigator.onLine) {
        this.handleOffline();
      }
    }

    handleOnline() {
      this.showNotification('online-notification', 3000);
      this.hideElement('offline-reading-btn');
    }

    handleOffline() {
      this.showNotification('offline-notification', 5000);
      this.showElement('offline-reading-btn');
    }

    handleServiceWorkerMessage(message: any) {
      switch (message.type) {
        case 'post-cached':
          this.showNotification('cache-notification', 3000);
          break;
        case 'sw-update-available':
          this.showNotification('sw-update-notification', 0);
          break;
        case 'sw-installed':
          this.showCacheNotification();
          break;
      }
    }

    showNotification(elementId: string, duration = 0) {
      const notification = document.getElementById(elementId);
      if (!notification) return;

      this.statusElement?.classList.remove('hidden');
      this.isVisible = true;
      notification.classList.remove('hidden');

      if (duration > 0) {
        setTimeout(() => {
          notification.classList.add('hidden');
          this.checkVisibility();
        }, duration);
      }
    }

    showElement(elementId: string) {
      const element = document.getElementById(elementId);
      if (!element) return;

      this.statusElement?.classList.remove('hidden');
      element.classList.remove('hidden');
      this.isVisible = true;
    }

    hideElement(elementId: string) {
      const element = document.getElementById(elementId);
      if (!element) return;

      element.classList.add('hidden');
      this.checkVisibility();
    }

    checkVisibility() {
      const visibleElements = this.statusElement?.querySelectorAll(':not(.hidden)') || [];
      if (visibleElements.length <= 1) {
        this.hideStatus();
      }
    }

    hideStatus() {
      if (this.hideTimeout) {
        clearTimeout(this.hideTimeout);
      }

      this.hideTimeout = window.setTimeout(() => {
        this.statusElement?.classList.add('hidden');
        this.isVisible = false;
      }, 1000);
    }

    updateStatus() {
      if (!navigator.onLine) {
        this.handleOffline();
      }
    }

    async applyUpdate() {
      try {
        const serviceWorkerManager = window.serviceWorkerManager;
        if (serviceWorkerManager) {
          await serviceWorkerManager.applyUpdate();
        }
      } catch (error) {
        console.error('Failed to apply update:', error);
        alert('Failed to apply update. Please refresh the page manually.');
      }
    }

    showCacheNotification() {
      this.showNotification('cache-notification', 4000);
    }
  }

  let offlineStatus;
  document.addEventListener('DOMContentLoaded', () => {
    offlineStatus = new OfflineStatusManager();
    window.offlineStatus = offlineStatus;
  });
</script>
