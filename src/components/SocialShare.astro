---
interface Props {
  title: string
  url: string
  description?: string
}

const { title, url } = Astro.props
const encodedTitle = encodeURIComponent(title)
const encodedUrl = encodeURIComponent(url)

const shareUrls = {
  twitter: `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`,
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
  hackernews: `https://news.ycombinator.com/submitlink?u=${encodedUrl}&t=${encodedTitle}`
}
---

<div class="flex flex-col gap-3">
  <span class="font-sans text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">Share this post</span>
  <div class="flex flex-wrap gap-2.5">
    <a
      href={shareUrls.twitter}
      target="_blank"
      rel="noopener noreferrer"
      class="share-pill"
      aria-label={`Share "${title}" on X`}
    >
      X · Share
    </a>

    <a
      href={shareUrls.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="share-pill"
      aria-label={`Share "${title}" on LinkedIn`}
    >
      LinkedIn
    </a>

    <a
      href={shareUrls.hackernews}
      target="_blank"
      rel="noopener noreferrer"
      class="share-pill"
      aria-label={`Share "${title}" on Hacker News`}
    >
      Hacker News
    </a>
  </div>
</div>

<style>
  .share-pill {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--card-bg);
    color: var(--mut);
    padding: 6px 15px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }

  .share-pill:hover {
    border-color: var(--acc);
    color: var(--acc);
    background: var(--soft-hover);
  }
</style>
