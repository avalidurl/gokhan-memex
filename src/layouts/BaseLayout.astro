---
import { createHash } from 'node:crypto'
import { readFileSync } from 'node:fs'
import { resolve } from 'node:path'
import { personSchema } from '@/lib/person'
import { pageRevLabel } from '@/lib/post-dates'
import OfflineStatus from '@/components/OfflineStatus.astro'
import criticalStyles from '@/styles/critical.css?inline'
import '@/styles/globals.css'

/** Path of the generated page card. Journal posts pass `/og/<slug>.png` explicitly. */
function pageCardPath(pathname: string) {
  const clean = (pathname || '/').replace(/\/+/g, '/').replace(/^\//, '').replace(/\/$/, '') || 'home'
  const key = clean.replace(/[^a-zA-Z0-9/_-]+/g, '-').replace(/\//g, '--')
  return `/og/pages/${key}.png`
}

export interface Props {
  title: string
  description: string
  image?: string
  canonicalURL?: string
  type?: 'website' | 'article'
  robots?: string
  /** Hide breadcrumbs (kept so existing pages still typecheck). */
  showBreadcrumbs?: boolean
  /** Full breadcrumb trail; unused in the register chrome. */
  breadcrumbOverride?: { items: { href?: string; label: string }[]; currentPage: string }
  /** Hide footer subscribe when journal in-flow block is shown. */
  hideFooterSubscribe?: boolean
  /** Document number shown in the masthead (defaults to the section's number). */
  docOverride?: string
}

const {
  title,
  description,
  image = pageCardPath(Astro.url.pathname),
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
  type = 'website',
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  docOverride,
} = Astro.props

const siteName = 'Gökhan Turhan'
const fullTitle = title === siteName ? title : `${title} | ${siteName}`

const pathname = Astro.url.pathname
const path = pathname.endsWith('/') ? pathname : `${pathname}/`
const nav = [
  { name: 'About', href: '/about/', on: path.startsWith('/about') },
  { name: 'Links', href: '/links/', on: path.startsWith('/links') },
  { name: 'CV', href: '/cv/', on: path.startsWith('/cv') },
  { name: 'Index', href: '/', on: path === '/', hover: 'Home' },
  { name: 'Products', href: '/products/', on: path.startsWith('/products') },
  { name: 'Publishing', href: '/publishing/', on: path.startsWith('/publishing') },
  { name: 'Raises', href: '/raises/', on: path.startsWith('/raises') },
  { name: 'Agents', href: '/agents/', on: path.startsWith('/agents') },
  { name: 'Substack', href: 'https://gokhan.substack.com/', external: true },
  { name: 'Blog', href: '/journal/', on: path.startsWith('/journal') || path.startsWith('/archive') || path.startsWith('/writing'), hover: 'Journal' },
  { name: 'Blyg', href: 'https://blyg.gokhanturhan.com/', external: true, note: 'BLYG is not the main BLOG' },
]

const docSection = pathname.split('/').filter(Boolean)[0] ?? ''
const docMap: Record<string, string> = {
  '': 'MX-001',
  journal: 'MX-010',
  archive: 'MX-020',
  writing: 'MX-030',
  publishing: 'MX-040',
  products: 'MX-050',
  tools: 'MX-052',
  about: 'MX-002',
  art: 'MX-060',
  lists: 'MX-070',
  links: 'MX-080',
  newsletter: 'MX-081',
  haleanbar: 'MX-085',
  cv: 'MX-090',
  raises: 'MX-092',
  agents: 'MX-093',
  consulting: 'MX-091',
  privacy: 'MX-095',
  disclaimer: 'MX-096',
  offline: 'MX-098',
  '404': 'MX-099',
}
const docNo = docOverride ?? docMap[docSection] ?? 'MX-000'
const docRev = pageRevLabel(pathname)

/** Content hash of the collapse script, so an edit busts the 2h asset cache for every
 *  visitor. HTML is served max-age=0, so a changed ?v= always lands immediately. */
const collapseVersion = createHash('sha256')
  .update(readFileSync(resolve(process.cwd(), 'public/blog-collapse.js')))
  .digest('hex')
  .slice(0, 8)
const skinVersion = createHash('sha256')
  .update(readFileSync(resolve(process.cwd(), 'public/notes-skin.css')))
  .digest('hex')
  .slice(0, 8)
const tableDeskVersion = createHash('sha256')
  .update(readFileSync(resolve(process.cwd(), 'public/table-desk.js')))
  .digest('hex')
  .slice(0, 8)
---

<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href="/favicon-avatar.jpg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots.includes('noindex') ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:site_name" content={siteName} />
    <meta name="author" content={siteName} />
    <meta property="og:image:alt" content={fullTitle} />
    {(/\.(png|jpe?g|webp)(\?|$)/i.test(image) || image.includes('/og/')) && (
      <>
        <meta property="og:image:type" content={image.endsWith('.webp') ? 'image/webp' : image.endsWith('.jpg') || image.endsWith('.jpeg') ? 'image/jpeg' : 'image/png'} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@goekhan" />
    <meta name="twitter:creator" content="@goekhan" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:image:alt" content={fullTitle} />
    
    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Gökhan Turhan — Journal" href="/rss.xml" />
    
    <!-- PWA Manifest -->
    <link rel="manifest" href="/manifest.json" />
    
    <!-- PWA Meta Tags -->
    <meta name="application-name" content={siteName} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={siteName} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <meta name="msapplication-TileColor" content="#ffffff" />
    <meta name="theme-color" content="#ffffff" />
    <!-- Theme class before the critical sheet. Inline, so Rocket Loader cannot
         defer it. A stored gt-theme of ink or paper wins. With no stored choice
         the OS dark sheet stays on and .light is never added. -->
    <script is:inline data-cfasync="false">
      (function () {
        var root = document.documentElement;
        var theme = null;
        try { theme = localStorage.getItem("gt-theme"); } catch (e) {}
        var darkOS = false;
        try { darkOS = matchMedia("(prefers-color-scheme: dark)").matches; } catch (e) {}
        var ink = theme === "ink" || (theme !== "paper" && darkOS);
        root.classList.toggle("ink", ink);
        root.classList.toggle("dark", ink);
        root.classList.toggle("light", theme === "paper");
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", ink ? "#111214" : "#ffffff");
        var tile = document.querySelector('meta[name="msapplication-TileColor"]');
        if (tile) tile.setAttribute("content", ink ? "#111214" : "#ffffff");
      })();
    </script>
    
    <!-- Apple Touch Icons — root paths by convention (and outside the /icons/* edge cleanup rule) -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="/apple-touch-icon-152x152.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    
    <!-- Substack DNS prefetch for faster iframe loading -->
    <link rel="dns-prefetch" href="https://gokhan.substack.com" />
    <link rel="preconnect" href="https://gokhan.substack.com" />
    
    <!-- Critical CSS - Inlined for First Contentful Paint Optimization -->
    <style is:inline set:html={criticalStyles}></style>
    
    <!-- Per-page head content passed via slot="head" (Article JSON-LD, custom schemas, seoKeywords meta). -->
    <slot name="head" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://gokhanturhan.com/#website",
          "name": "Gökhan Turhan",
          "url": "https://gokhanturhan.com/",
          "inLanguage": "en",
          "publisher": { "@id": "https://gokhanturhan.com/#person" },
        },
        personSchema,
      ],
    })} />
    <link rel="stylesheet" href="/register.css?v=20261122-blyg" />
    <link rel="stylesheet" href={`/notes-skin.css?v=${skinVersion}`} />
  </head>

  <body class="register">
    <a class="skip" href="#main">Skip to the content</a>
    <div class="nav-wrap">
      <div class="reg-bar" id="reg-bar">
        <a class="home" href="/">Gökhan Turhan</a>
        <nav id="reg-nav" aria-label="Sections">
          {nav.map((item) => (
            item.hover
              ? <a href={item.href} class="nav-swap" aria-current={item.on ? 'page' : 'false'} aria-label={`${item.name} (${item.hover})`}><span class="sw-a" aria-hidden="true">{item.name}</span><span class="sw-b" aria-hidden="true">{item.hover}</span></a>
              : item.note
                ? <a href={item.href} class="nav-note" target="_blank" rel="noopener noreferrer" aria-describedby="blyg-note">{item.name}<span class="nav-pop" id="blyg-note" role="tooltip">{item.note}</span></a>
                : item.external
                  ? <a href={item.href} target="_blank" rel="noopener noreferrer">{item.name}</a>
                  : <a href={item.href} aria-current={item.on ? 'page' : 'false'}>{item.name}</a>
          ))}
        </nav>
        <div class="reg-tools">
          <button type="button" id="theme" class="reg-theme" aria-pressed="false" aria-label="Switch to dark mode">
            <svg class="theme-sun" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
              <circle cx="12" cy="12" r="4" fill="currentColor"></circle>
              <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.1 5.1l1.6 1.6M17.3 17.3l1.6 1.6M18.9 5.1l-1.6 1.6M6.7 17.3l-1.6 1.6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
            </svg>
            <svg class="theme-moon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
              <path fill="currentColor" d="M15.2 2.4a8.8 8.8 0 1 0 6.4 14.8A8.2 8.2 0 0 1 15.2 2.4z"></path>
            </svg>
          </button>
          <button type="button" class="reg-menu" id="reg-menu" aria-expanded="false" aria-controls="reg-nav" aria-label="Open menu">Menu</button>
        </div>
      </div>
    </div>
    <div class="reg-sheet">
      <header class="mast">
        <div class="reg-id">
          <div>
            <h1><a href="/">Gökhan Turhan</a></h1>
            <p class="reg-role">full-stack builder · generalist solopreneur · conceptual artist</p>
          </div>
          <p class="reg-doc"><b>{docNo}</b><span> · {docRev}</span></p>
        </div>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="reg-foot">
        <details class="cx foot fold" open aria-label="Site footer">
          <summary class="cx-h"><b>Reach</b><span>elsewhere and site files</span></summary>
          <div class="cx-r"><span>Channels</span><span class="reg-channels">
            <a href="https://x.com/goekhan">X</a><span class="reg-dot">/</span>
            <a href="https://t.me/goekhanturhan">Telegram</a><span class="reg-dot">/</span>
            <a href="https://www.linkedin.com/in/goekhanturhan/">LinkedIn</a><span class="reg-dot">/</span>
            <a href="https://github.com/avalidurl">GitHub</a><span class="reg-dot">/</span>
            <a href="https://huggingface.co/gokhanturhan">Hugging Face</a><span class="reg-dot">/</span>
            <a href="https://gokhan.substack.com/">Substack</a><span class="reg-dot">/</span>
            <a href="/journal/#subscribe">Newsletter</a><span class="reg-dot">/</span>
            <a href="/links/">All links</a>
          </span></div>
          <div class="cx-r"><span>Site</span><span class="reg-fine">
            <a href="/about/">About</a><span class="reg-dot">/</span>
            <a href="/products/">Projects &amp; Products</a><span class="reg-dot">/</span>
            <a href="/archive/tags/">Tags</a><span class="reg-dot">/</span>
            <a href="/tools/">Tools</a><span class="reg-dot">/</span>
            <a href="/api/">APIs</a><span class="reg-dot">/</span>
            <a href="/privacy/">Privacy</a><span class="reg-dot">/</span>
            <a href="/disclaimer/">Disclaimer</a>
          </span></div>
          <div class="cx-r"><span>Site files</span><span class="reg-fine">
            <a href="/sitemap-index.xml">Sitemap</a><span class="reg-dot">/</span>
            <a href="/robots.txt">robots.txt</a><span class="reg-dot">/</span>
            <a href="/llms.txt">llms.txt</a><span class="reg-dot">/</span>
            <a href="/api/apis.json">apis.json</a><span class="reg-dot">/</span>
            <a href="/api/openapi.json">openapi.json</a><span class="reg-dot">/</span>
            <a href="/llms-full.txt">llms-full.txt</a><span class="reg-dot">/</span>
            <a href="/rss.xml">RSS (journal)</a>
          </span></div>
        </details>
      </footer>
    </div>
    
    <!-- Offline Status Indicator -->
    <OfflineStatus />
    
    <!-- Lightbox for images - click to enlarge -->
    <div id="lightbox" style="display:none;position:fixed;inset:0;background:var(--paper);z-index:9999;cursor:zoom-out;overflow:auto" onclick="this.style.display='none'">
      <img id="lightbox-img" style="max-width:95%;max-height:95%;margin:auto;display:block;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);border:2px solid var(--ink)" />
      <span style="position:fixed;top:20px;right:30px;color:var(--ink);font-size:40px;cursor:pointer">&times;</span>
    </div>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const lightbox = document.getElementById('lightbox');
        const lightboxImg = document.getElementById('lightbox-img');
        document.querySelectorAll('article img, .prose img').forEach(img => {
          img.style.cursor = 'zoom-in';
          img.addEventListener('click', (e) => {
            e.preventDefault();
            lightboxImg.src = img.src;
            lightbox.style.display = 'block';
          });
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') lightbox.style.display = 'none';
        });
      });
    </script>
    <!-- Collapsible article headings (blog/journal only; no-ops elsewhere). -->
    <script is:inline src="/register.js?v=20261128-skin" defer></script>
    <script is:inline src={`/blog-collapse.js?v=${collapseVersion}`} defer></script>
    <script is:inline src={`/table-desk.js?v=${tableDeskVersion}`} defer></script>
  </body>
</html>

<style>
  /* Raise notice — booster docstrip metrics: mono 12.5px, 3px/1px rules. */
  .nrbar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.6ch;
    margin: 0;
    max-width: none;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-text);
    font-size: 12.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 8px 12px;
    border-top: 3px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }
  .nrbar-flag { font-weight: 700; }
  .nrbar-note { color: var(--dim); }
  .nrbar-link { color: var(--ink); text-decoration: none; text-underline-offset: 3px; }
  .nrbar-link:hover { text-decoration: underline; }
</style>
