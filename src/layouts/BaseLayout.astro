---
import { createHash } from 'node:crypto'
import { readFileSync } from 'node:fs'
import { resolve } from 'node:path'
import PrivacyNotice from '@/components/PrivacyNotice.astro'
import OfflineStatus from '@/components/OfflineStatus.astro'
import criticalStyles from '@/styles/critical.css?inline'
import '@/styles/globals.css'

export interface Props {
  title: string
  description: string
  image?: string
  canonicalURL?: string
  type?: 'website' | 'article'
  robots?: string
  /** Hide breadcrumbs (kept so existing pages still typecheck). */
  showBreadcrumbs?: boolean
  /** Full breadcrumb trail; unused in the register chrome. */
  breadcrumbOverride?: { items: { href?: string; label: string }[]; currentPage: string }
  /** Hide footer subscribe when journal in-flow block is shown. */
  hideFooterSubscribe?: boolean
  /** Document number shown in the masthead (defaults to the section's number). */
  docOverride?: string
}

const {
  title,
  description,
  image = '/og/gokhan-turhan-v2.png',
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
  type = 'website',
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  docOverride,
} = Astro.props

const siteName = 'Gökhan Turhan'
const fullTitle = title === siteName ? title : `${title} | ${siteName}`

const pathname = Astro.url.pathname
const path = pathname.endsWith('/') ? pathname : `${pathname}/`
const nav = [
  { name: 'Index', href: '/', on: path === '/' },
  { name: 'Journal', href: '/journal/', on: path.startsWith('/journal') || path.startsWith('/archive') || path.startsWith('/writing') },
  { name: 'Products', href: '/products/', on: path.startsWith('/products') },
  { name: 'Drafts', href: '/product-drafts/', on: path.startsWith('/product-drafts') },
  { name: 'Publishing', href: '/publishing/', on: path.startsWith('/publishing') },
  { name: 'CV', href: '/cv/', on: path.startsWith('/cv') },
  { name: 'Raises', href: '/#raises', on: false },
  { name: 'Agents', href: '/#agents', on: false },
]

const docSection = pathname.split('/').filter(Boolean)[0] ?? ''
const docMap: Record<string, string> = {
  '': 'MX-001',
  journal: 'MX-010',
  archive: 'MX-020',
  writing: 'MX-030',
  publishing: 'MX-040',
  products: 'MX-050',
  'product-drafts': 'MX-051',
  tools: 'MX-052',
  about: 'MX-002',
  art: 'MX-060',
  lists: 'MX-070',
  links: 'MX-080',
  newsletter: 'MX-081',
  haleanbar: 'MX-085',
  cv: 'MX-090',
  consulting: 'MX-091',
  privacy: 'MX-095',
  disclaimer: 'MX-096',
  offline: 'MX-098',
  '404': 'MX-099',
}
const docNo = docOverride ?? docMap[docSection] ?? 'MX-000'
const docRev = 'REV 2026-07-17'

/** Content hash of the collapse script, so an edit busts the 2h asset cache for every
 *  visitor. HTML is served max-age=0, so a changed ?v= always lands immediately. */
const collapseVersion = createHash('sha256')
  .update(readFileSync(resolve(process.cwd(), 'public/blog-collapse.js')))
  .digest('hex')
  .slice(0, 8)
const tableDeskVersion = createHash('sha256')
  .update(readFileSync(resolve(process.cwd(), 'public/table-desk.js')))
  .digest('hex')
  .slice(0, 8)
---

<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Theme: the OS preference is handled entirely in CSS (prefers-color-scheme
         in the inlined critical styles), so no JS is needed for the default.
         This script only stamps an explicit stored choice; data-cfasync keeps
         Rocket Loader from deferring it past first paint. -->
    <script is:inline src="/register-boot.js"></script>
    <link rel="icon" type="image/jpeg" href="/favicon-avatar.jpg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots.includes('noindex') ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:site_name" content={siteName} />
    <meta name="author" content={siteName} />
    <meta property="og:image:alt" content={fullTitle} />
    {image === "/og/gokhan-turhan-v2.png" && <>
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
    </>}
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@goekhan" />
    <meta name="twitter:creator" content="@goekhan" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:image:alt" content={fullTitle} />
    
    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    
    <!-- PWA Manifest -->
    <link rel="manifest" href="/manifest.json" />
    
    <!-- PWA Meta Tags -->
    <meta name="application-name" content={siteName} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={siteName} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <meta name="msapplication-TileColor" content="#FAFAF8" />
    <meta name="theme-color" content="#FAFAF8" />
    
    <!-- Apple Touch Icons — root paths by convention (and outside the /icons/* edge cleanup rule) -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="/apple-touch-icon-152x152.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    
    <!-- Substack DNS prefetch for faster iframe loading -->
    <link rel="dns-prefetch" href="https://gokhan.substack.com" />
    <link rel="preconnect" href="https://gokhan.substack.com" />
    
    <!-- Critical CSS - Inlined for First Contentful Paint Optimization -->
    <style is:inline set:html={criticalStyles}></style>
    
    <!-- Google Analytics - Load by Default -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-TSMR6G8LLL"></script>
    <script is:inline>
      // Initialize dataLayer and gtag function
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      
      // Initialize GA with timestamp
      gtag('js', new Date());
      
      // Check if user has opted out
      const privacyChoice = localStorage.getItem('privacy-choice');
      
      if (privacyChoice === 'declined') {
        // User has opted out - disable tracking
        gtag('config', 'G-TSMR6G8LLL', {
          'anonymize_ip': true,
          'allow_google_signals': false,
          'allow_ad_personalization_signals': false,
          'send_page_view': false
        });
      } else {
        // Default behavior - track all users
        gtag('config', 'G-TSMR6G8LLL', {
          'anonymize_ip': true,
          'allow_google_signals': false,
          'allow_ad_personalization_signals': false
        });
      }
      
      // Expose functions globally for privacy notice component
      window.enableGoogleAnalytics = function() {
        gtag('config', 'G-TSMR6G8LLL', {
          'anonymize_ip': true,
          'allow_google_signals': false,
          'allow_ad_personalization_signals': false
        });
        // Send current page view if it was disabled
        gtag('event', 'page_view', {
          page_title: document.title,
          page_location: window.location.href
        });
      };
      
      window.disableGoogleAnalytics = function() {
        gtag('config', 'G-TSMR6G8LLL', {
          'anonymize_ip': true,
          'allow_google_signals': false,
          'allow_ad_personalization_signals': false,
          'send_page_view': false
        });
      };
    </script>
    
    <!-- Structured Data - Person Schema -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Gökhan Turhan",
      "alternateName": "goekhan",
      "description": "T-shaped generalist founder, researcher, and Strategic Innovation Architect operating across fintech, deep tech, competitive governance, art markets, and investment strategies. His work sits at the junction of stablecoins, real-world assets, tokenization, cryptography, AGI timelines, and global systemic challenges—turning them into high-leverage opportunities through foresight, product growth strategy, and technology expertise.",
      "jobTitle": ["Strategic Innovation Architect", "Founder", "Researcher", "Conceptual Artist"],
      "url": "https://gokhanturhan.com",
      "sameAs": [
        "https://x.com/goekhan",
        "https://github.com/avalidurl",
        "https://linkedin.com/in/goekhanturhan",
        "https://warpcast.com/gokhan",
        "https://gokhan.substack.com",
        "https://t.me/goekhanturhan"
      ],
      "knowsAbout": [
        "Stablecoins", "Real World Assets", "RWA", "Tokenization", "Cryptography", 
        "Artificial General Intelligence", "AGI timelines", "Investment Strategy", 
        "Fintech", "Deep Tech", "Art Markets", "Information Markets", "Sabermetrics",
        "Competitive Governance", "Global Systemic Challenges", "Strategic Innovation",
        "Product Growth Strategy", "Technology Expertise", "Foresight"
      ],
      "hasOccupation": {
        "@type": "Occupation",
        "name": "Strategic Innovation Architect",
        "description": "Turning global systemic challenges into high-leverage opportunities through foresight, product growth strategy, and technology expertise across fintech and deep tech"
      }
    })} />

    <!-- Per-page head content passed via slot="head" (Article JSON-LD, custom schemas, seoKeywords meta). -->
    <slot name="head" />
    <link rel="stylesheet" href="/register.css" />
  </head>

  <body class="register">
    <div class="reg-sheet">
      <header class="mast">
        <div class="reg-id">
          <div>
            <h1><a href="/">Gökhan Turhan</a></h1>
            <p class="reg-role">Full-stack builder · generalist solopreneur · conceptual artist</p>
          </div>
          <p class="reg-doc"><b>{docNo}</b><span> · {docRev}</span></p>
        </div>
        <div class="reg-bar">
          <nav aria-label="Sections">
            {nav.map((item) => (
              <a href={item.href} aria-current={item.on ? 'page' : 'false'}>{item.name}</a>
            ))}
          </nav>
          <div class="reg-modes">
            <button type="button" id="theme" aria-pressed="false">Ink</button>
            <button type="button" id="face" aria-pressed="false">Sans</button>
          </div>
        </div>
      </header>

      <main>
        <slot />
      </main>

      <footer class="reg-foot">
        <div class="reg-rule"><span>Reach</span></div>
        <p class="reg-channels">
          <a href="https://x.com/goekhan">X</a><span class="reg-dot">/</span>
          <a href="https://t.me/goekhanturhan">Telegram</a><span class="reg-dot">/</span>
          <a href="https://www.linkedin.com/in/goekhanturhan/">LinkedIn</a><span class="reg-dot">/</span>
          <a href="https://github.com/avalidurl">GitHub</a><span class="reg-dot">/</span>
          <a href="https://gokhan.substack.com/">Substack</a><span class="reg-dot">/</span>
          <a href="/rss.xml">RSS</a><span class="reg-dot">/</span>
          <a href="/newsletter/">Newsletter</a>
        </p>
        <p class="reg-fine">
          <a href="/about/">About</a><span class="reg-dot">/</span>
          <a href="/product-drafts/">Drafts</a><span class="reg-dot">/</span>
          <a href="/archive/tags/">Tags</a><span class="reg-dot">/</span>
          <a href="/tools/">Tools</a><span class="reg-dot">/</span>
          <a href="https://api.gokhanturhan.com/">APIs</a><span class="reg-dot">/</span>
          <a href="/privacy/">Privacy</a><span class="reg-dot">/</span>
          <a href="/disclaimer/">Disclaimer</a>
        </p>
      </footer>
    </div>
    
    <!-- Privacy Notice -->
    <PrivacyNotice />
    
    <!-- Offline Status Indicator -->
    <OfflineStatus />
    
    <!-- Lightbox for images - click to enlarge -->
    <div id="lightbox" style="display:none;position:fixed;inset:0;background:var(--paper);z-index:9999;cursor:zoom-out;overflow:auto" onclick="this.style.display='none'">
      <img id="lightbox-img" style="max-width:95%;max-height:95%;margin:auto;display:block;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);border:2px solid var(--ink)" />
      <span style="position:fixed;top:20px;right:30px;color:var(--ink);font-size:40px;cursor:pointer">&times;</span>
    </div>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const lightbox = document.getElementById('lightbox');
        const lightboxImg = document.getElementById('lightbox-img');
        document.querySelectorAll('article img, .prose img').forEach(img => {
          img.style.cursor = 'zoom-in';
          img.addEventListener('click', (e) => {
            e.preventDefault();
            lightboxImg.src = img.src;
            lightbox.style.display = 'block';
          });
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') lightbox.style.display = 'none';
        });
      });
    </script>
    <!-- Collapsible article headings (blog/journal only; no-ops elsewhere). -->
    <script is:inline src="/register.js" defer></script>
    <script is:inline src={`/blog-collapse.js?v=${collapseVersion}`} defer></script>
    <script is:inline src={`/table-desk.js?v=${tableDeskVersion}`} defer></script>
  </body>
</html>

<style>
  /* Raise notice — booster docstrip metrics: mono 12.5px, 3px/1px rules. */
  .nrbar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.6ch;
    margin: 0;
    max-width: none;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 8px 12px;
    border-top: 3px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }
  .nrbar-flag { font-weight: 700; }
  .nrbar-note { color: var(--dim); }
  .nrbar-link { color: var(--ink); text-decoration: none; text-underline-offset: 3px; }
  .nrbar-link:hover { text-decoration: underline; }
</style>
