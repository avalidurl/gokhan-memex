---
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout
  title="Consulting"
  description="Strategic innovation and technology advisory."
>
  <div class="mx-auto max-w-3xl px-5 py-10 lg:py-14">
    <header class="mb-10 pb-8 border-b border-border">
      <div class="kicker-pill mb-3">Advisory</div>
      <h1 class="mb-3">Consulting</h1>
      <p class="font-serif text-[19px] text-muted-foreground m-0">
        Strategic innovation and technology advisory.
      </p>
    </header>

    <div class="grid gap-6 md:grid-cols-2">
      <section class="rounded-2xl border border-border bg-card p-6 border-l-[5px] border-l-primary">
        <h2 class="font-serif text-[22px] font-bold text-foreground mb-4">
          Services
        </h2>
        <ul class="space-y-2.5 text-foreground/90 pl-5 m-0">
          <li>DevOps &amp; Infrastructure Architecture</li>
          <li>Developer Relations Strategy</li>
          <li>Business Development</li>
          <li>Strategic Technology Advisory</li>
        </ul>
      </section>

      <section class="rounded-2xl border border-border bg-card p-6">
        <h2 class="font-serif text-[22px] font-bold text-foreground mb-4">
          Contact
        </h2>
        <p class="text-muted-foreground mb-5">
          Direct inquiries:
        </p>
        <a 
          href="mailto:contact@gokhan.vc"
          class="tile"
        >
          contact@gokhan.vc
        </a>
      </section>
    </div>
  </div>
</BaseLayout>
