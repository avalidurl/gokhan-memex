---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHead from '@/components/PageHead.astro'
---

<BaseLayout
  title="Consulting"
  description="Strategic innovation and technology advisory."
>
  <div class="es">
    <PageHead crumbs={[{ label: 'Index', href: '/' }, { label: 'Consulting' }]} title="Consulting" lead="Strategic innovation and technology advisory." />
    <section class="cx" aria-label="Services">
      <div class="cx-h"><b>Services</b><em>04</em></div>
      <div class="cx-r"><span>01</span><span>DevOps &amp; Infrastructure Architecture</span></div>
      <div class="cx-r"><span>02</span><span>Developer Relations Strategy</span></div>
      <div class="cx-r"><span>03</span><span>Business Development</span></div>
      <div class="cx-r"><span>04</span><span>Strategic Technology Advisory</span></div>
    </section>
    <section class="cx" aria-label="Contact">
      <div class="cx-h"><b>Contact</b></div>
      <div class="cx-r"><span>Email</span><span><a href="mailto:contact@gokhan.vc">contact@gokhan.vc</a></span></div>
    </section>
  </div>
</BaseLayout>
