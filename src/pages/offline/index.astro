---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHead from '@/components/PageHead.astro'
---

<BaseLayout
  title="Offline"
  description="You're currently offline"
>
  <div class="es">
    <PageHead crumbs={[{ label: 'Index', href: '/' }, { label: 'Offline' }]} title="You're offline" lead="Check your internet connection and try again.">
      <p><button type="button" class="stamp cur" onclick="window.location.reload()">Try again</button></p>
    </PageHead>
  </div>
</BaseLayout>
