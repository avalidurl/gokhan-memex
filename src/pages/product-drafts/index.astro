---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHead from '@/components/PageHead.astro'
import Tags from '@/components/Tags.astro'
import { drafts, draftTags, tagLabel } from '@/data/estate'

const facet = (k: 'status' | 'kind' | 'chain' | 'origin') =>
  [...new Set(drafts.map((d) => d[k]).filter(Boolean) as string[])].sort()
const facets = (['status', 'origin'] as const).map((k) => ({ k, v: facet(k) }))
const allTags = [...new Set(drafts.flatMap((d) => draftTags[d.slug] ?? []))].sort((a, b) => tagLabel(a).localeCompare(tagLabel(b)))
---

<BaseLayout
  title="Product drafts"
  description="Drafts, experiments and live tools: one line each, with tags for status, kind, chain and where it is published."
>
  <div class="es">
    <PageHead crumbs={[{ label: 'Index', href: '/' }, { label: 'one line each' }]} title="Product drafts" lead="Experiments, concepts and small live tools. One line each, tagged." />

    <section class="cx" aria-label="Tags">
      <div class="cx-h"><b>Tags</b><span>each opens a shared tag page</span></div>
      <div class="cx-r"><span>tags</span><span><Tags tags={allTags} /></span></div>
      {facets.map(({ k, v }) => (
        <div class="cx-r"><span>{k}</span><span>{v.join(' · ')}</span></div>
      ))}
    </section>

    <section class="cx draft" aria-label="Drafts">
      <div class="cx-h"><b>Register</b><span>name · line · tags</span><em>{String(drafts.length).padStart(2, '0')}</em></div>
      {drafts.map((d) => (
        <div class="cx-r" data-status={d.status} data-kind={d.kind} data-chain={d.chain ?? ''} data-origin={d.origin}>
          <span>{d.origin}</span>
          <span>
            <a class="nm" href={d.page ? `/${d.slug}/` : d.href}>{d.name}</a> — {d.line}{' '}
            <i>{d.status}</i><br /><Tags tags={draftTags[d.slug] ?? []} />
          </span>
        </div>
      ))}
    </section>
  </div>
</BaseLayout>
