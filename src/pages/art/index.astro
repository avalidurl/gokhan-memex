---
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout
  title="Art"
  description="Creative works and artistic explorations."
>
  <div class="mx-auto max-w-3xl px-5 py-10 lg:py-14">
    <header class="mb-10 pb-8 border-b border-border">
      <div class="kicker-pill mb-3">Studio &amp; Practice</div>
      <h1 class="mb-3">Art</h1>
      <p class="font-serif text-[19px] text-muted-foreground m-0">
        Creative works and artistic explorations.
      </p>
    </header>

    <div class="rounded-2xl border border-border bg-card p-10 text-center">
      <p class="font-serif text-[19px] text-muted-foreground mb-6">
        Gallery coming soon.
      </p>
      <a 
        href="/journal"
        class="tile"
      >
        ← Back to journal
      </a>
    </div>
  </div>
</BaseLayout>
