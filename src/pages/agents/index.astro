---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHead from '@/components/PageHead.astro'

const machine = "{\n  \"api_index\": \"https://api.gokhanturhan.com/apis.json\",\n  \"discovery\": {\n    \"index\": \"https://api.gokhanturhan.com/\",\n    \"openapi\": \"https://api.gokhanturhan.com/openapi.json\",\n    \"llms\": \"https://api.gokhanturhan.com/llms.txt\",\n    \"site_llms\": \"https://gokhanturhan.com/llms.txt\",\n    \"cv_md\": \"https://gokhanturhan.com/cv.md\",\n    \"feed_rss\": \"https://gokhanturhan.com/rss.xml\"\n  },\n  \"apis\": [\n    {\"slug\": \"feedhub\", \"name\": \"Estate gateway (feedhub)\", \"docs\": \"https://api.gokhanturhan.com/feedhub/\"},\n    {\"slug\": \"newsletter\", \"name\": \"Newsletter (email + XMTP)\", \"docs\": \"https://api.gokhanturhan.com/newsletter/\"},\n    {\"slug\": \"ishtar\", \"name\": \"Ishtar API\", \"docs\": \"https://api.gokhanturhan.com/ishtar/\"},\n    {\"slug\": \"curb\", \"name\": \"CURB clearing API\", \"docs\": \"https://api.gokhanturhan.com/curb/\"},\n    {\"slug\": \"curb-agents\", \"name\": \"CURB harness agents\", \"docs\": \"https://api.gokhanturhan.com/curb-agents/\"},\n    {\"slug\": \"launch\", \"name\": \"Launch router\", \"docs\": \"https://api.gokhanturhan.com/launch/\"},\n    {\"slug\": \"numetal-fees\", \"name\": \"Numetal fees and burns\", \"docs\": \"https://api.gokhanturhan.com/numetal-fees/\"},\n    {\"slug\": \"status\", \"name\": \"Numetal status\", \"docs\": \"https://api.gokhanturhan.com/status/\"},\n    {\"slug\": \"plaintext\", \"name\": \"Plaintext board\", \"docs\": \"https://api.gokhanturhan.com/plaintext/\"},\n    {\"slug\": \"accumulator\", \"name\": \"Accumulator waitlist + wishlist\", \"docs\": \"https://api.gokhanturhan.com/accumulator/\"},\n    {\"slug\": \"jesus\", \"name\": \"Personal Jesus waitlist\", \"docs\": \"https://api.gokhanturhan.com/jesus/\"},\n    {\"slug\": \"llmcraft\", \"name\": \"LLMCraft waitlist\", \"docs\": \"https://api.gokhanturhan.com/llmcraft/\"},\n    {\"slug\": \"apex\", \"name\": \"APEX Protocol\", \"docs\": \"https://api.gokhanturhan.com/apex/\"},\n    {\"slug\": \"xmtp\", \"name\": \"XMTP bot\", \"docs\": \"https://api.gokhanturhan.com/xmtp/\"},\n    {\"slug\": \"x402-live\", \"name\": \"x402 live panel\", \"docs\": \"https://api.gokhanturhan.com/x402-live/\"},\n    {\"slug\": \"assets\", \"name\": \"Asset host\", \"docs\": \"https://api.gokhanturhan.com/assets/\"}\n  ]\n}"
---

<BaseLayout
  title="For agents"
  description="API index and discovery files for agents: estate APIs, OpenAPI, llms.txt, cv.md and RSS."
>
  <div class="es">
    <PageHead crumbs={[{ label: 'Index', href: '/' }, { label: 'Agents' }]} title="For agents" lead="The estate APIs are documented in one index. Their docs are kept as they were; nothing below takes payment." />
      <div class="cx api">
        <div class="cx-h"><b>API index</b><span>gokhanturhan.com/api/</span><em>16</em></div>
        <a class="reg" href="/api/feedhub/"><span class="name">Estate gateway (feedhub)</span><span class="what">REST · OpenAPI · RSS/JSON Feed</span><span class="where">documented</span></a>
        <a class="reg" href="/api/newsletter/"><span class="name">Newsletter (email + XMTP)</span><span class="what">REST</span><span class="where">documented</span></a>
        <a class="reg" href="/api/ishtar/"><span class="name">Ishtar API</span><span class="what">REST · OpenAPI · MCP · x402</span><span class="where">documented</span></a>
        <a class="reg" href="/api/curb/"><span class="name">CURB clearing API</span><span class="what">REST · OpenAPI · MCP · x402</span><span class="where">documented</span></a>
        <a class="reg" href="/api/curb-agents/"><span class="name">CURB harness agents</span><span class="what">HTTP agents</span><span class="where">documented</span></a>
        <a class="reg" href="/api/launch/"><span class="name">Launch router</span><span class="what">REST · OpenAPI · MCP · x402 · MPP</span><span class="where">documented</span></a>
        <a class="reg" href="/api/numetal-fees/"><span class="name">Numetal fees and burns</span><span class="what">JSON</span><span class="where">documented</span></a>
        <a class="reg" href="/api/status/"><span class="name">Numetal status</span><span class="what">JSON · HTML</span><span class="where">documented</span></a>
        <a class="reg" href="/api/plaintext/"><span class="name">Plaintext board</span><span class="what">REST · MCP · RSS</span><span class="where">documented</span></a>
        <a class="reg" href="/api/accumulator/"><span class="name">Accumulator waitlist + wishlist</span><span class="what">JSON</span><span class="where">documented</span></a>
        <a class="reg" href="/api/jesus/"><span class="name">Personal Jesus waitlist</span><span class="what">form</span><span class="where">documented</span></a>
        <a class="reg" href="/api/llmcraft/"><span class="name">LLMCraft waitlist</span><span class="what">form</span><span class="where">documented</span></a>
        <a class="reg" href="/api/apex/"><span class="name">APEX Protocol</span><span class="what">llms.txt</span><span class="where">documented</span></a>
        <a class="reg" href="/api/xmtp/"><span class="name">XMTP bot</span><span class="what">bot</span><span class="where">documented</span></a>
        <a class="reg" href="/api/x402-live/"><span class="name">x402 live panel</span><span class="what">HTML/JSON</span><span class="where">retired</span></a>
        <a class="reg" href="/api/assets/"><span class="name">Asset host</span><span class="what">static files</span><span class="where">documented</span></a>
      </div>
      <a class="more" href="/api/">Open the API index</a>

      <div class="cx">
        <div class="cx-h"><b>Discovery</b><span>this site</span></div>
        <div class="cv-line"><span>Index</span><b><a href="/api/apis.json">apis.json</a> · <a href="/api/openapi.json">openapi.json</a> · <a href="/api/llms.txt">llms.txt</a></b></div>
        <div class="cv-line"><span>This site</span><b><a href="https://gokhanturhan.com/llms.txt">llms.txt</a> · <a href="https://gokhanturhan.com/cv.md">cv.md</a> · <a href="/rss.xml">RSS</a></b></div>
        <div class="cv-line"><span>Products</span><b><a href="/products/">current, studio and drafts</a></b></div>
      </div>

      <details class="cx fold" open>
        <summary class="cx-h"><b>Machine</b><span>agents.json — the API index, for agents</span></summary>
        <pre class="machine" id="agents-json" set:text={machine} />
      </details>
  </div>
</BaseLayout>
