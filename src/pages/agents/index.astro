---
import { readFileSync } from 'node:fs'
import { resolve } from 'node:path'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHead from '@/components/PageHead.astro'

type CatalogApi = {
  slug: string
  name: string
  domain: string
  former_base: string
  status: string
  tags: string[]
  protocols: string[]
  docs: string
  rail?: string
  base?: string
  check: { checked: string; method: string; result: string }
}
const register = JSON.parse(readFileSync(resolve(process.cwd(), 'public/api/apis.json'), 'utf8')) as {
  checked: string
  purpose_tags: string[]
  protocol_tags: string[]
  apis: CatalogApi[]
}
const published = register.apis.filter((a) => a.rail)
const domains = ['numetal.xyz', 'gokhan.vc']
const grouped = domains.map((domain) => ({
  domain,
  apis: register.apis.filter((a) => a.domain === domain),
}))
const machine = JSON.stringify({
  name: 'Gökhan Turhan',
  pages_accept_payment: false,
  contact: 'mailto:contact@gokhan.vc',
  checked: register.checked,
  api_index: 'https://api.gokhanturhan.com/apis.json',
  discovery: {
    index: 'https://api.gokhanturhan.com/',
    openapi: 'https://api.gokhanturhan.com/openapi.json',
    llms: 'https://api.gokhanturhan.com/llms.txt',
    agent: 'https://api.gokhanturhan.com/.well-known/agent.json',
    site_llms: 'https://gokhanturhan.com/llms.txt',
    site_agent: 'https://gokhanturhan.com/.well-known/agent.json',
    cv_md: 'https://gokhanturhan.com/cv.md',
    feed_rss: 'https://gokhanturhan.com/rss.xml',
  },
  purpose_tags: register.purpose_tags,
  protocol_tags: register.protocol_tags,
  published: published.map((a) => ({ slug: a.slug, name: a.name, rail: a.rail, base: a.base, status: a.status })),
  apis: register.apis.map((a) => ({
    slug: a.slug,
    name: a.name,
    domain: a.domain,
    former_base: a.former_base,
    rail: a.rail,
    base: a.base,
    status: a.status,
    tags: a.tags,
    protocols: a.protocols,
    docs: a.docs,
    check: a.check,
  })),
}, null, 2)
---

<BaseLayout
  title="For agents"
  description="API index and discovery files for agents: estate APIs, OpenAPI, llms.txt, cv.md and RSS."
>
  <div class="es">
    <PageHead crumbs={[{ label: 'Index', href: '/' }, { label: 'Agents' }]} title="For agents" lead="Seven APIs are published at api.gokhanturhan.com, above the archive of the domains they used to run on. A call under /ishtar, /curb, /launch, /plaintext, /accumulator, /numetal or /status is proxied to the live worker. These pages do not take a payment." />
      <div class="cx api">
        <div class="cx-h"><b>gokhanturhan.com</b><span>published on this host</span><em>{published.length}</em></div>
        {published.map((a) => (
          <a class="reg" href={`/api/${a.slug}/`}>
            <span class="name">{a.name}</span>
            <span class="what">{[...a.tags, ...a.protocols].join(' · ')}</span>
            <span class="where">{a.rail} · {a.status}</span>
          </a>
        ))}
      </div>
      {grouped.map((g) => (
        <div class="cx api">
          <div class="cx-h"><b>{g.domain}</b><span>former domain</span><em>{g.apis.length}</em></div>
          {g.apis.map((a) => (
            <a class="reg" href={`/api/${a.slug}/`}>
              <span class="name">{a.name}</span>
              <span class="what">{[...a.tags, ...a.protocols].join(' · ')}</span>
              <span class="where">{a.status}</span>
            </a>
          ))}
        </div>
      ))}
      <a class="more" href="https://api.gokhanturhan.com/">Open the API index</a>

      <div class="cx">
        <div class="cx-h"><b>Discovery</b><span>this site</span></div>
        <div class="cv-line"><span>Index</span><b><a href="https://api.gokhanturhan.com/apis.json">apis.json</a> · <a href="https://api.gokhanturhan.com/openapi.json">openapi.json</a> · <a href="https://api.gokhanturhan.com/llms.txt">llms.txt</a> · <a href="https://api.gokhanturhan.com/.well-known/agent.json">agent.json</a></b></div>
        <div class="cv-line"><span>This site</span><b><a href="https://gokhanturhan.com/llms.txt">llms.txt</a> · <a href="https://gokhanturhan.com/cv.md">cv.md</a> · <a href="/rss.xml">RSS</a></b></div>
        <div class="cv-line"><span>Products</span><b><a href="/products/">current, studio and drafts</a></b></div>
      </div>

      <details class="cx fold" open>
        <summary class="cx-h"><b>Machine</b><span>agents.json — the API index, for agents</span></summary>
        <pre class="machine" id="agents-json" set:text={machine} />
      </details>
  </div>
</BaseLayout>
