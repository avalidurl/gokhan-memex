---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHead from '@/components/PageHead.astro'
import WorksList from '@/components/publishing/WorksList.astro'
---

<BaseLayout title="Publishing" description="Digital editions, browser-readable texts, and downloadable e-books by Gökhan Turhan.">
  <div class="es">
    <PageHead crumbs={[{ label: 'Index', href: '/' }, { label: 'Publishing' }]} title="Publishing" lead="Digital editions, browser-readable texts, and downloadable e-books by Gökhan Turhan." />
    <WorksList kind="E-book" note="EPUB, browser edition and source text" index="/publishing/ebooks/" />
    <WorksList kind="Academic" note="chapters and theses" index="/publishing/academic/" />
    <WorksList kind="Experimental" note="sound, text and form" index="/publishing/experimental/" />
  </div>
</BaseLayout>
