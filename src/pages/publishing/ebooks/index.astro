---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { ebooks } from '@/data/ebooks'
---

<BaseLayout
  title="E-books"
  description="Downloadable EPUBs and browser-readable digital books by Gökhan Turhan."
>
  <div class="publishing-document mx-auto max-w-4xl px-5 py-10 lg:py-14">
    <header class="mb-10 pb-8 border-b border-border">
      <div class="kicker-pill mb-3">Publishing / E-books</div>
      <h1 class="mb-3">E-books</h1>
      <p class="font-serif text-[19px] max-w-2xl text-muted-foreground m-0">
        Browser-readable editions and downloadable EPUB files prepared as readable, printable web documents.
      </p>
    </header>

    <div class="space-y-6">
      {ebooks.map((ebook, index) => (
        <article class="grid gap-6 rounded-2xl border border-border bg-card p-6 md:grid-cols-[200px_1fr]">
          <a href={`/publishing/ebooks/${ebook.slug}/`} class="block">
            <img
              src={ebook.coverImage}
              alt={`Cover art for ${ebook.title}`}
              class="w-full rounded-xl border border-border object-cover"
              loading="lazy"
            />
          </a>

          <div class="flex flex-col">
            <div class="doc-eyebrow mb-2 flex flex-wrap items-center gap-x-4 gap-y-1">
              <span>E-book {String(index + 1).padStart(2, '0')}</span>
              <span>{ebook.pageCount} pages</span>
              <span>{new Date(ebook.publishedOn).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
            </div>
            <h2 class="mt-0 mb-1.5 font-serif text-[24px] font-bold">
              <a href={`/publishing/ebooks/${ebook.slug}/`} class="doc-heading-link">
                {ebook.title}
              </a>
            </h2>
            <p class="mb-3 text-[15.5px] text-muted-foreground">{ebook.subtitle}</p>
            <details class="ebook-item group" open>
              <summary class="list-none cursor-pointer mb-2 inline-flex items-center gap-1.5 text-xs font-semibold text-primary">
                <span>Summary &amp; editions</span>
                <span class="ebook-caret inline-block transition-transform">▼</span>
              </summary>

              <p class="font-serif mb-5 max-w-2xl text-[17px] text-foreground/90 pt-1">{ebook.blurb}</p>

              <div class="mt-auto flex flex-wrap gap-2.5">
                <a
                  href={ebook.browserEditionUrl}
                  class="inline-flex items-center rounded-full border border-[var(--btn-bg)] bg-[var(--btn-bg)] px-4 py-2 text-[13.5px] font-semibold text-[var(--btn-fg)] hover:bg-[var(--btn-hover)] hover:border-[var(--btn-hover)] no-underline hover:opacity-90 transition-opacity"
                >
                  Open HTML
                </a>
                <a
                  href={ebook.epubUrl}
                  class="tile"
                  download
                >
                  Download EPUB
                </a>
                <a
                  href={`/publishing/ebooks/${ebook.slug}/`}
                  class="inline-flex items-center rounded-full border border-border bg-background px-4 py-2 text-[13.5px] font-semibold text-muted-foreground no-underline hover:border-primary hover:text-primary transition-colors"
                >
                  View details
                </a>
              </div>
            </details>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .publishing-document { color: var(--ink); }
  .publishing-document .doc-eyebrow {
    color: var(--acc);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .publishing-document .doc-heading-link {
    color: var(--ink);
    text-decoration: none;
    transition: color 0.15s;
  }
  .publishing-document .doc-heading-link:hover { color: var(--acc); }
  .publishing-document details summary::-webkit-details-marker,
  .publishing-document details summary::marker { display: none; }
  .publishing-document .ebook-item[open] > summary .ebook-caret {
    transform: rotate(180deg);
  }
</style>
