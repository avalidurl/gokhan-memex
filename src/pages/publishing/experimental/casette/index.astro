---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { experimentalWorks } from '@/data/publishing'

const work = experimentalWorks.find((entry) => entry.detailHref === '/publishing/experimental/casette/')

if (!work) {
  throw new Error('CASSETTE entry not found in experimentalWorks')
}
---

<BaseLayout
  title="CASSETTE"
  description="Full cover and accompanying information text for CASSETTE by Gökhan Turhan."
>
  <div class="publishing-document mx-auto max-w-4xl px-5 py-10 lg:py-14">
    <header class="mb-10 pb-8 border-b border-border">
      <div class="kicker-pill mb-3">Publishing / Experimental / CASSETTE</div>
      <h1 class="mb-2">{work.title}</h1>
      <p class="font-serif text-[18px] text-muted-foreground m-0">
        {work.creators} · {work.year}
      </p>
    </header>

    <article class="space-y-7 rounded-2xl border border-border bg-card p-6 sm:p-9">
      <img
        src={work.coverImage}
        alt={work.coverAlt}
        class="w-full rounded-xl border border-border object-cover"
        loading="eager"
      />

      {work.commissionedByName && work.commissionedByHref && (
        <p class="text-[15.5px] text-muted-foreground m-0">
          Commissioned by <a href={work.commissionedByHref} class="doc-link" target="_blank" rel="noopener noreferrer">{work.commissionedByName}</a>.
        </p>
      )}
      {work.statusNote && (
        <p class="rounded-xl bg-muted px-4 py-3 text-sm text-muted-foreground m-0">{work.statusNote}</p>
      )}

      {(work.sourceHref || work.originalAudioHref) && (
        <div class="flex flex-wrap gap-2.5">
          {work.sourceHref && (
            <a href={work.sourceHref} class="tile" target="_blank" rel="noopener noreferrer">
              {work.sourceLabel ?? 'View source'} ↗
            </a>
          )}
          {work.originalAudioHref && (
            <a href={work.originalAudioHref} class="inline-flex items-center rounded-full border border-border bg-background px-4 py-2 text-[13.5px] font-semibold text-muted-foreground no-underline hover:border-primary hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">
              {work.originalAudioLabel ?? 'Original source'} ↗
            </a>
          )}
        </div>
      )}

      {work.audioHref && work.audioMimeType && (
        <audio controls preload="none" class="w-full max-w-2xl">
          <source src={work.audioHref} type={work.audioMimeType} />
        </audio>
      )}

      <div class="pt-4 border-t border-border">
        <h2 class="mb-4 font-serif text-[25px] font-bold">Information text</h2>
        <div class="space-y-4 font-serif text-[17.5px] leading-relaxed text-foreground/90">
          {work.accompanyingText.split('\n\n').map((paragraph) => (
            <p class="m-0">{paragraph}</p>
          ))}
        </div>
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .publishing-document { color: var(--ink); }
  .publishing-document .doc-link {
    color: var(--acc);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .publishing-document .doc-link:hover { color: var(--acc-dark); }
</style>
