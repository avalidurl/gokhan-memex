---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHead from '@/components/PageHead.astro'
import Tags from '@/components/Tags.astro'
import { experimentalWorks } from '@/data/publishing'
import { works } from '@/data/works'
import { cdnImage } from '@/lib/cdn-image'

const work = experimentalWorks.find((entry) => entry.detailHref === '/publishing/experimental/casette/')
if (!work) throw new Error('CASSETTE entry not found in experimentalWorks')
const w = works.find((x) => x.href === work.detailHref)!
const others = works.filter((x) => x !== w)
---

<BaseLayout title="CASSETTE" description="Full cover and accompanying information text for CASSETTE by Gökhan Turhan.">
  <div class="es">
    <PageHead crumbs={[{ label: 'Publishing', href: '/publishing/' }, { label: 'Experimental', href: '/publishing/experimental/' }, { label: work.title }]} title={work.title} lead={`${work.creators} · ${work.year}`} tags={w.tags} />
    <div class="pgrid">
      <div class="pmain">
        <section class="cx" aria-label="Cover">
          <div class="cx-h"><b>Cover</b><span>{work.coverAlt}</span></div>
          <div class="cx-b"><img src={cdnImage(work.coverImage, 1200)} alt={work.coverAlt} class="work-cover" loading="eager" /></div>
        </section>
        {work.audioHref && work.audioMimeType && (
          <section class="cx" aria-label="Listen">
            <div class="cx-h"><b>Listen</b><span>audio</span></div>
            <div class="cx-b"><audio controls preload="none"><source src={work.audioHref} type={work.audioMimeType} /></audio></div>
          </section>
        )}
        <section class="cx" aria-label="Information text">
          <div class="cx-h"><b>Information text</b></div>
          <div class="cx-b body">{work.accompanyingText.split('\n\n').map((p) => <p>{p}</p>)}</div>
        </section>
      </div>
      <aside class="pside">
        <section class="cx" aria-label="Facts">
          <div class="cx-h"><b>Facts</b><span>Experimental</span></div>
          <div class="cx-r"><span>By</span><span>{work.creators}</span></div>
          <div class="cx-r"><span>Year</span><span>{work.year}</span></div>
          {work.commissionedByName && <div class="cx-r"><span>Commission</span><span>{work.commissionedByHref ? <a href={work.commissionedByHref} target="_blank" rel="noopener noreferrer">{work.commissionedByName}</a> : work.commissionedByName}</span></div>}
          {work.sourceHref && <div class="cx-r"><span>Source</span><span><a href={work.sourceHref} target="_blank" rel="noopener noreferrer">{work.sourceLabel ?? 'View source'}</a></span></div>}
          {work.originalAudioHref && <div class="cx-r"><span>Audio</span><span><a href={work.originalAudioHref} target="_blank" rel="noopener noreferrer">{work.originalAudioLabel ?? 'Original source'}</a></span></div>}
          {work.statusNote && <div class="cx-r"><span>Note</span><span>{work.statusNote}</span></div>}
          <div class="cx-r"><span>Tags</span><span><Tags tags={w.tags} /></span></div>
        </section>
        <section class="cx" aria-label="More publishing">
          <div class="cx-h"><b>Publishing</b><span>other works</span></div>
          {others.map((x) => <div class="cx-r"><span>{x.kind}</span><span><a href={x.href}>{x.title}</a></span></div>)}
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>
