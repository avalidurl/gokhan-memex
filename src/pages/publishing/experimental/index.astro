---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { experimentalWorks } from '@/data/publishing'
---

<BaseLayout
  title="Experimental"
  description="Sound-led and hybrid experiments across writing, recording, and networked media by Gökhan Turhan."
>
  <div class="publishing-document mx-auto max-w-4xl px-5 py-10 lg:py-14">
    <header class="mb-10 pb-8 border-b border-border">
      <div class="kicker-pill mb-3">Publishing / Experimental</div>
      <h1 class="mb-3">Experimental</h1>
      <p class="font-serif text-[19px] max-w-2xl text-muted-foreground m-0">
        Sound-led and hybrid experiments across writing, recording, and networked media.
      </p>
    </header>

    <div class="space-y-8">
      {experimentalWorks.map((work) => (
        <article class="rounded-2xl border border-border bg-card p-6 sm:p-8">
          <div class="grid gap-6 md:grid-cols-[200px_1fr]">
            <a
              href={work.sourceHref ?? work.detailHref}
              class="block"
              target={work.sourceHref ? '_blank' : undefined}
              rel={work.sourceHref ? 'noopener noreferrer' : undefined}
            >
              <img
                src={work.coverImage}
                alt={work.coverAlt}
                class="w-full rounded-xl border border-border object-cover"
                loading="lazy"
              />
            </a>

            <div>
              <p class="doc-eyebrow mb-2">{work.type}</p>
              <h2 class="mt-0 mb-2 font-serif text-[25px] font-bold">
                <a href={work.detailHref} class="doc-heading-link">
                  {work.title}
                </a>
              </h2>
              <p class="mb-4 text-[15.5px] text-muted-foreground">
                {work.creators} · {work.year}
              </p>
              {work.commissionedByName && work.commissionedByHref && (
                <p class="mb-3 text-[15px] text-muted-foreground">
                  Commissioned by <a href={work.commissionedByHref} class="doc-link" target="_blank" rel="noopener noreferrer">{work.commissionedByName}</a>.
                </p>
              )}
              {work.statusNote && (
                <p class="mb-4 rounded-xl bg-muted px-4 py-3 text-sm text-muted-foreground">
                  {work.statusNote}
                </p>
              )}

              {(work.sourceHref || work.originalAudioHref) && (
                <div class="mb-6 flex flex-wrap gap-2.5">
                  {work.sourceHref && (
                    <a href={work.sourceHref} class="tile" target="_blank" rel="noopener noreferrer">
                      {work.sourceLabel ?? 'View source'} ↗
                    </a>
                  )}
                  {work.originalAudioHref && (
                    <a href={work.originalAudioHref} class="inline-flex items-center rounded-full border border-border bg-background px-4 py-2 text-[13.5px] font-semibold text-muted-foreground no-underline hover:border-primary hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">
                      {work.originalAudioLabel ?? 'Original source'} ↗
                    </a>
                  )}
                </div>
              )}

              {work.audioHref && work.audioMimeType && (
                <audio controls preload="none" class="mb-6 w-full max-w-2xl">
                  <source src={work.audioHref} type={work.audioMimeType} />
                </audio>
              )}

              <h3 class="mb-3 font-serif text-[20px] font-bold">Accompanying text</h3>
              <div class="space-y-4 font-serif text-[17px] leading-relaxed text-foreground/90">
                {work.accompanyingText.split('\n\n').map((paragraph) => (
                  <p class="m-0">{paragraph}</p>
                ))}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .publishing-document { color: var(--ink); }
  .publishing-document .doc-eyebrow {
    color: var(--acc);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .publishing-document .doc-heading-link {
    color: var(--ink);
    text-decoration: none;
    transition: color 0.15s;
  }
  .publishing-document .doc-heading-link:hover { color: var(--acc); }
  .publishing-document .doc-link {
    color: var(--acc);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .publishing-document .doc-link:hover { color: var(--acc-dark); }
</style>
