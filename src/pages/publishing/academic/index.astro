---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { academicPublications } from '@/data/publishing'
---

<BaseLayout
  title="Academic"
  description="Selected publications, chapters, and graduate work by Gökhan Turhan."
>
  <div class="publishing-document mx-auto max-w-4xl px-5 py-10 lg:py-14">
    <header class="mb-10 pb-8 border-b border-border">
      <div class="kicker-pill mb-3">Publishing / Academic</div>
      <h1 class="mb-3">Academic</h1>
      <p class="font-serif text-[19px] max-w-2xl text-muted-foreground m-0">
        Selected publications, chapters, and graduate work.
      </p>
    </header>

    <div class="space-y-6">
      {academicPublications.map((item) => (
        <article class="rounded-2xl border border-border bg-card p-6 sm:p-7">
          <p class="doc-eyebrow mb-2">{item.type}</p>
          <h2 class="mt-0 mb-2 font-serif text-[23px] font-bold leading-[1.28]">
            <a href={item.href} class="doc-heading-link" target="_blank" rel="noopener noreferrer">
              {item.title}
            </a>
          </h2>
          <p class="mb-4 text-[15.5px] text-muted-foreground">
            {item.venue} · {item.year}
          </p>
          <div class="flex flex-wrap items-center gap-4 text-sm">
            <span class="text-muted-foreground">{item.author}</span>
            <a href={item.href} class="tile" target="_blank" rel="noopener noreferrer">
              {item.linkLabel} ↗
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .publishing-document { color: var(--ink); }
  .publishing-document .doc-eyebrow {
    color: var(--acc);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .publishing-document .doc-heading-link {
    color: var(--ink);
    text-decoration: none;
    transition: color 0.15s;
  }
  .publishing-document .doc-heading-link:hover { color: var(--acc); }
</style>
