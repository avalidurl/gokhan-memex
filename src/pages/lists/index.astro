---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PostTitle from '@/components/PostTitle.astro'

const allPosts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf())

const musicPosts = allPosts.filter(
  (post) =>
    post.data.category === 'Music' ||
    post.data.category === 'sound' ||
    (post.data.tags && post.data.tags.includes('music'))
)
const bookPosts = allPosts.filter(post => 
  post.data.category === 'Books' || 
  (post.data.tags && post.data.tags.includes('books'))
)
---

<BaseLayout
  title="Lists"
  description="Curated collection of books and music content."
>
  <div class="mx-auto max-w-3xl px-5 py-10 lg:py-14">
    <header class="mb-10 pb-8 border-b border-border">
      <div class="kicker-pill mb-3">Curation</div>
      <h1 class="mb-3">Lists</h1>
      <p class="font-serif text-[19px] text-muted-foreground m-0">
        Curated books and music content I follow.
      </p>
    </header>

    <div class="space-y-6">
      {bookPosts.length > 0 && (
        <section id="books" class="rounded-2xl border border-border bg-card overflow-hidden">
          <details class="group" open>
            <summary class="flex items-center justify-between cursor-pointer list-none px-6 py-5 hover:bg-muted/40 transition-colors">
              <div>
                <h2 class="font-serif text-[23px] font-bold text-foreground m-0">
                  Books
                </h2>
                <p class="text-sm text-muted-foreground mt-1 mb-0">
                  Book reviews and reading reflections.
                </p>
              </div>
              <span class="rounded-full border border-border bg-muted px-3 py-1 text-xs font-semibold text-primary group-open:rotate-180 transition-transform">
                ▼
              </span>
            </summary>
            <div class="divide-y divide-border border-t border-border">
              {bookPosts.map(post => (
                <a 
                  href={`/journal/${post.slug}/`}
                  class="group/link flex items-baseline justify-between gap-4 px-6 py-3.5 no-underline hover:bg-muted/40 transition-colors"
                >
                  <PostTitle title={post.data.title} class="font-serif text-[17.5px] font-semibold text-foreground group-hover/link:text-primary transition-colors" />
                  <span class="text-sm text-muted-foreground shrink-0 tabular-nums">
                    {post.data.publishDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
                  </span>
                </a>
              ))}
            </div>
          </details>
        </section>
      )}

      {musicPosts.length > 0 && (
        <section id="music" class="rounded-2xl border border-border bg-card overflow-hidden">
          <details class="group" open>
            <summary class="flex items-center justify-between cursor-pointer list-none px-6 py-5 hover:bg-muted/40 transition-colors">
              <div>
                <h2 class="font-serif text-[23px] font-bold text-foreground m-0">
                  Music
                </h2>
                <p class="text-sm text-muted-foreground mt-1 mb-0">
                  Sound art, playlists, and musical explorations.
                </p>
              </div>
              <span class="rounded-full border border-border bg-muted px-3 py-1 text-xs font-semibold text-primary group-open:rotate-180 transition-transform">
                ▼
              </span>
            </summary>
            <div class="divide-y divide-border border-t border-border">
              {musicPosts.map(post => (
                <a 
                  href={`/journal/${post.slug}/`}
                  class="group/link flex items-baseline justify-between gap-4 px-6 py-3.5 no-underline hover:bg-muted/40 transition-colors"
                >
                  <PostTitle title={post.data.title} class="font-serif text-[17.5px] font-semibold text-foreground group-hover/link:text-primary transition-colors" />
                  <span class="text-sm text-muted-foreground shrink-0 tabular-nums">
                    {post.data.publishDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
                  </span>
                </a>
              ))}
            </div>
          </details>
        </section>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
  details summary::marker {
    display: none;
  }
</style>
