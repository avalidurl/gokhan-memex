---
import { type CollectionEntry, getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import SocialShare from '@/components/SocialShare.astro'
import PostTitle from '@/components/PostTitle.astro'
import ResponsiveImage from '@/components/ResponsiveImage.astro'
import SubscribeBlock from '@/components/SubscribeBlock.astro'
import { formatDate, humanizeKebab, plainPostTitle } from '@/lib/utils'

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => !post.data.draft)
  const ordered = [...posts].sort((a, b) => {
    const d = a.data.publishDate.getTime() - b.data.publishDate.getTime()
    return d !== 0 ? d : a.slug.localeCompare(b.slug)
  })
  const docNumber = new Map(ordered.map((p, i) => [p.slug, i + 1]))
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { ...post, docNumber: docNumber.get(post.slug) ?? 0 },
  }))
}

type Props = CollectionEntry<'blog'> & { docNumber: number }

const post = Astro.props
const { Content, headings } = await post.render()

const docId = `JOURNAL-${String(post.docNumber).padStart(3, '0')}`
const docCategory = post.data.category || 'Journal'
const docDate = post.data.publishDate.toISOString().slice(0, 10)

const defaultArticleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": plainPostTitle(post.data.title),
  "description": post.data.description,
  "author": {
    "@type": "Person",
    "name": post.data.author,
    "url": "https://gokhanturhan.com"
  },
  "publisher": {
    "@type": "Person",
    "name": "Gökhan Turhan",
    "url": "https://gokhanturhan.com"
  },
  "datePublished": post.data.publishDate.toISOString(),
  "url": `https://gokhanturhan.com/journal/${post.slug}/`,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://gokhanturhan.com/journal/${post.slug}/`
  },
  "image": post.data.heroImage ? `https://gokhanturhan.com${post.data.heroImage}` : "https://gokhanturhan.com/og-default.png",
  "articleSection": post.data.category,
  "keywords": post.data.tags?.join(', ') || ''
}

const customSchemas = post.data.schema ? (Array.isArray(post.data.schema) ? post.data.schema : [post.data.schema]) : []

const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3)
const showToc = tocHeadings.length >= 2
---

<BaseLayout
  title={plainPostTitle(post.data.title)}
  description={post.data.description}
  type="article"
  image={post.data.heroImage || `/og/${post.slug}.png`}
  canonicalURL={post.data.originalUrl}
  hideFooterSubscribe
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(defaultArticleSchema)} slot="head" />

  {customSchemas.map((schema: any) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      ...schema
    })} slot="head" />
  ))}

  {post.data.seoKeywords && (
    <meta name="keywords" content={post.data.seoKeywords.join(', ')} slot="head" />
  )}

  <div class="dispatch mx-auto max-w-3xl px-5 py-8 lg:py-12">
    <article>
      <!-- Meta strip -->
      <div class="docstrip">
        <span class="docstrip-id">{docId} · {docCategory}</span>
        <span class="docstrip-pub">Published {docDate}</span>
      </div>

      <!-- Article Header -->
      <header class="dispatch-header">
        {post.data.heroImage && (
          <div class="hero-img-frame mb-7">
            <ResponsiveImage
              src={post.data.heroImage}
              alt={post.data.heroImageAlt || plainPostTitle(post.data.title)}
              class="w-full"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        )}

        <div class="kicker-pill mb-3.5">{docCategory} · {docDate} · Gökhan Turhan</div>

        <PostTitle title={post.data.title} as="h1" class="dispatch-title" />

        {(post.slug === 'not-raising-a-preseed' || post.slug === 'universal-sex-layer') && (
          <p class="deck-links">
            <a class="deck-pdf" href="https://assets.numetal.xyz/deck/ishtar-deck-not-a-preseed.pdf" download>Download PDF</a>
            <a class="deck-pill" href="https://ishtar.numetal.xyz/deck/not-raising-a-preseed/">View deck →</a>
            <a class="deck-pill" href="https://ishtar.numetal.xyz/deck/not-raising-a-preseed/deck.md">deck.md</a>
          </p>
        )}

        {post.data.description && (
          <p class="dispatch-lede">{post.data.description}</p>
        )}

        {post.data.tags && post.data.tags.length > 0 && (
          <div class="dispatch-tags">
            {post.data.tags.map(tag => (
              <a
                href={`/archive/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`}
                class="dispatch-tag"
              >
                {humanizeKebab(tag)}
              </a>
            ))}
          </div>
        )}
      </header>

      {/* Soft rounded Contents card */}
      {showToc && (
        <details class="contents-box" open>
          <summary class="contents-label">Contents</summary>
          <ol class="contents-list">
            {tocHeadings.map((heading) => (
              <li class={heading.depth === 3 ? 'contents-item contents-item-nested' : 'contents-item'}>
                <a href={`#${heading.slug}`} class="contents-link">{heading.text}</a>
              </li>
            ))}
          </ol>
        </details>
      )}

      <!-- Article Content -->
      <div class="dispatch-prose prose dark:prose-invert max-w-none">
        <Content />
      </div>

      <!-- Social Share -->
      <div class="mt-12 pt-8 border-t border-border">
        <SocialShare
          title={plainPostTitle(post.data.title)}
          url={`${Astro.site?.origin || 'https://gokhanturhan.com'}${Astro.url.pathname}`}
          description={post.data.description}
        />
      </div>

      <!-- Article Footer -->
      <footer class="mt-8 pt-6 border-t border-border">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 text-sm text-muted-foreground">
          <span>
            Published on {formatDate(post.data.publishDate)}
          </span>
          <div class="flex items-center gap-3">
            <a
              href="/journal"
              class="tile"
            >
              ← All posts
            </a>
            <a
              href="/rss.xml"
              class="inline-flex items-center rounded-full border border-border bg-card px-4 py-2 text-[13.5px] font-semibold text-muted-foreground no-underline hover:border-primary hover:text-primary transition-colors"
            >
              RSS
            </a>
          </div>
        </div>
      </footer>
    </article>
  </div>
  <SubscribeBlock />
</BaseLayout>

<style>
  .docstrip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-sans);
    font-size: 12.5px;
    color: var(--mut);
  }
  .docstrip-id { font-weight: 600; color: var(--ink); }
  .docstrip-pub { color: var(--mut); }

  .dispatch-header {
    margin: 1.6rem 0 0;
  }

  .hero-img-frame {
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--soft);
  }

  .dispatch-title {
    font-family: var(--font-serif);
    font-size: clamp(32px, 5vw, 44px);
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 0 0 0.75rem;
  }

  .dispatch-lede {
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.58;
    color: var(--lead-ink);
    margin: 0.6rem 0 0;
    max-width: 62ch;
  }

  .deck-links {
    margin: 1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .deck-pdf {
    font-family: var(--font-sans);
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
    color: #ffffff;
    border: 1px solid var(--acc);
    border-radius: 999px;
    padding: 7px 16px;
    background: var(--acc);
    transition: background 0.15s;
  }
  .deck-pdf:hover {
    background: var(--acc-dark);
    border-color: var(--acc-dark);
    color: #ffffff;
  }
  .deck-pill {
    font-family: var(--font-sans);
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
    color: var(--acc);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 7px 15px;
    background: var(--card-bg);
    transition: border-color 0.15s, background 0.15s;
  }
  .deck-pill:hover {
    border-color: var(--acc);
    background: var(--soft-hover);
  }

  .dispatch-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 1.1rem;
  }
  .dispatch-tag {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    color: var(--mut);
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 11px;
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .dispatch-tag:hover {
    border-color: var(--acc);
    color: var(--acc);
    background: var(--soft-hover);
  }

  /* Contents card */
  .contents-box {
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--card-bg);
    margin: 1.8rem 0 0;
    padding: 0;
    overflow: hidden;
  }
  .contents-label {
    font-family: var(--font-sans);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--acc);
    background: var(--soft);
    padding: 0.7rem 1.1rem;
    border-bottom: 1px solid var(--line);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .contents-label::-webkit-details-marker { display: none; }
  .contents-label::before { content: "▸  "; color: var(--acc); }
  .contents-box[open] > .contents-label::before { content: "▾  "; }
  .contents-box:not([open]) > .contents-label { border-bottom: none; }

  .contents-list {
    list-style: none;
    counter-reset: contents;
    margin: 0;
    padding: 0.85rem 1.15rem 1rem;
    font-size: 15.5px;
  }
  .contents-item {
    counter-increment: contents;
    line-height: 1.5;
    margin: 0.32rem 0;
    display: flex;
    gap: 0.65rem;
  }
  .contents-item::before {
    content: counter(contents, decimal-leading-zero);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    color: var(--acc);
    flex: 0 0 auto;
    padding-top: 0.18em;
    font-variant-numeric: tabular-nums;
  }
  .contents-item-nested {
    padding-left: 1.4rem;
    counter-increment: none;
  }
  .contents-item-nested::before {
    content: "–";
    color: var(--mut);
  }
  .contents-link {
    color: var(--ink);
    text-decoration: none;
    transition: color 0.15s;
  }
  .contents-link:hover {
    color: var(--acc);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .dispatch-prose {
    margin-top: 2.2rem;
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1.72;
    color: var(--ink);
  }

  .dispatch-prose :global(.epigraph) {
    border-left: 4px solid var(--acc);
    background: var(--soft);
    border-radius: 0 14px 14px 0;
    padding: 0.85rem 1.2rem;
    margin: 0 0 1.5rem;
  }
  .dispatch-prose :global(.epigraph p) {
    font-style: italic;
    margin: 0 0 0.35rem;
  }
  .dispatch-prose :global(.epigraph .epigraph-cite),
  .dispatch-prose :global(.epigraph cite) {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    color: var(--mut);
    font-style: normal;
    margin: 0;
  }

  /* TL;DR card matching Turkish Art Blob funding/note cards */
  .dispatch-prose :global(.tldr) {
    border: 1px solid var(--line);
    border-left: 5px solid var(--acc);
    border-radius: 16px;
    background: var(--card-bg);
    padding: 18px 22px;
    margin: 0 0 28px;
    font-family: var(--font-sans);
  }
  .dispatch-prose :global(.tldr .tldr-k) {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--acc);
    background: var(--soft);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 2px 9px;
    margin-bottom: 10px;
  }
  .dispatch-prose :global(.tldr ul) { margin: 0; padding-left: 20px; }
  .dispatch-prose :global(.tldr li) { margin: 6px 0; font-size: 15.5px; line-height: 1.55; }

  .dispatch-prose :global(h1),
  .dispatch-prose :global(h2),
  .dispatch-prose :global(h3),
  .dispatch-prose :global(h4),
  .dispatch-prose :global(h5),
  .dispatch-prose :global(h6) {
    scroll-margin-top: 5rem;
  }

  .dispatch-prose :global(:where(p)) {
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1.72;
    margin: 0 0 1.05em;
    color: var(--ink);
  }
  .dispatch-prose :global(:where(li)) {
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1.7;
    margin: 0 0 0.55em;
    color: var(--ink);
  }

  .dispatch-prose :global(h2) {
    font-family: var(--font-serif);
    font-size: 27px;
    font-weight: 700;
    line-height: 1.22;
    letter-spacing: -0.01em;
    margin: 38px 0 14px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    border-bottom: 0;
    padding-bottom: 0;
    color: var(--ink);
  }
  .dispatch-prose :global(h2:first-child) {
    margin-top: 1rem;
    padding-top: 0;
    border-top: 0;
  }

  .dispatch-prose :global(h3) {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--ink);
    margin: 26px 0 10px;
  }

  .dispatch-prose :global(img) {
    border-radius: 14px;
    border: 1px solid var(--line);
  }

  .dispatch-prose :global(h1 a.anchor-link),
  .dispatch-prose :global(h2 a.anchor-link),
  .dispatch-prose :global(h3 a.anchor-link),
  .dispatch-prose :global(h4 a.anchor-link),
  .dispatch-prose :global(h5 a.anchor-link),
  .dispatch-prose :global(h6 a.anchor-link) {
    text-decoration: none !important;
    color: inherit;
  }

  .dispatch-prose :global(.superseded-content) {
    opacity: 0.72;
  }

  .dispatch-prose :global(.superseded-content :where(p, li, h2, h3, h4, h5, h6, a, strong, em, blockquote, td, th, figcaption)) {
    text-decoration: line-through;
    text-decoration-color: color-mix(in srgb, var(--mut) 55%, transparent);
  }

  @media (max-width: 640px) {
    .contents-list { padding: 0.7rem 0.9rem 0.85rem; }
    .contents-label { padding: 0.6rem 0.9rem; }
    .dispatch-prose :global(:where(p)),
    .dispatch-prose :global(:where(li)) { font-size: 17px; }
  }
</style>
