---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PostTitle from '@/components/PostTitle.astro'
import SubscribeBlock from '@/components/SubscribeBlock.astro'

const allPosts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf())

const postsByYear = allPosts.reduce((acc, post) => {
  const year = new Date(post.data.publishDate).getFullYear()
  if (!acc[year]) acc[year] = []
  acc[year].push(post)
  return acc
}, {} as Record<number, typeof allPosts>)

const years = Object.keys(postsByYear).map(Number).sort((a, b) => b - a)
---

<BaseLayout
  title="Journal"
  description="Latest thoughts on stablecoins, tokenization, AGI, investment strategies, and global systemic challenges."
  hideFooterSubscribe
>
  <div class="mx-auto max-w-3xl px-5 py-10 lg:py-14">
    <!-- Header -->
    <header class="mb-10 pb-8 border-b border-border">
      <div class="kicker-pill mb-3">Essays &amp; Dispatches</div>
      <h1 class="mb-3">Journal</h1>
      <p class="font-serif text-[19px] text-muted-foreground mb-4">
        {allPosts.length} posts on stablecoins, tokenization, AGI, and more.
      </p>
      <p class="text-sm text-muted-foreground mb-5">
        Read them here or → <a href="/newsletter" class="text-primary underline underline-offset-2 font-medium">subscribe</a> · <a href="/rss.xml" class="text-primary underline underline-offset-2 font-medium">RSS</a>
      </p>
      <div class="flex flex-wrap items-center gap-2.5">
        <a 
          href="/archive" 
          class="tile"
        >
          Browse by category →
        </a>
        <a 
          href="/rss.xml" 
          class="inline-flex items-center rounded-full border border-border bg-card px-4 py-2 text-[13.5px] font-semibold text-muted-foreground no-underline hover:border-primary hover:text-primary transition-colors"
        >
          RSS
        </a>
      </div>
    </header>

    <!-- Posts by Year -->
    <div class="space-y-10">
      {years.map(year => (
        <section>
          <div class="flex items-center justify-between mb-3">
            <h2 class="font-serif text-[24px] font-bold text-foreground m-0">
              {year}
            </h2>
            <span class="rounded-full border border-border bg-muted px-3 py-0.5 text-xs font-semibold text-primary">
              {postsByYear[year].length} {postsByYear[year].length === 1 ? 'post' : 'posts'}
            </span>
          </div>
          <div class="rounded-2xl border border-border bg-card overflow-hidden">
            <ul class="divide-y divide-border list-none p-0 m-0">
              {postsByYear[year].map(post => (
                <li class="m-0">
                  <a 
                    href={`/journal/${post.slug}/`}
                    class="group flex items-baseline justify-between gap-4 px-5 py-3.5 no-underline hover:bg-muted/50 transition-colors"
                  >
                    <PostTitle title={post.data.title} class="font-serif text-[17.5px] font-semibold text-foreground group-hover:text-primary transition-colors flex-1" />
                    <span class="text-[13px] font-sans text-muted-foreground shrink-0 tabular-nums">
                      {new Date(post.data.publishDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))}
    </div>

    {allPosts.length === 0 && (
      <div class="rounded-2xl border border-border bg-card p-10 text-center">
        <p class="text-lg text-muted-foreground mb-2">No posts found.</p>
        <p class="text-sm text-muted-foreground m-0">
          Content is being migrated. Check back soon!
        </p>
      </div>
    )}
  </div>
  <SubscribeBlock />
</BaseLayout>
