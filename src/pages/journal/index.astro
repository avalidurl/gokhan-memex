---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHead from '@/components/PageHead.astro'
import PostTitle from '@/components/PostTitle.astro'
import JournalSubscribe from '@/components/JournalSubscribe.astro'

// Every published post, newest first, filed by year.
const allPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf())

const iso = (d: Date | string) => new Date(d).toISOString().slice(0, 10)
const plain = (t: string) => t.replace(/<[^>]+>/g, '').replace(/[~*_`]/g, '').toLowerCase()

const postsByYear = allPosts.reduce((acc, post) => {
  const year = new Date(post.data.publishDate).getFullYear()
  ;(acc[year] ??= []).push(post)
  return acc
}, {} as Record<number, typeof allPosts>)
const years = Object.keys(postsByYear).map(Number).sort((a, b) => b - a)
---

<BaseLayout
  title="Journal"
  description="Essays and dispatches by Gökhan Turhan — agent-native markets, stablecoins, tokenization, AI, filed by year."
  hideFooterSubscribe
>
  <div class="es">
    <PageHead
      crumbs={[{ label: 'Index', href: '/' }, { label: 'Journal' }]}
      title="Journal"
      count={allPosts.length}
      lead={`${allPosts.length} posts, filed by year. Follow by email below or by RSS.`}
    />

    <section class="cx" aria-label="Subscribe">
      <div class="cx-h"><b>Subscribe</b><span>occasional, low-frequency</span><span><a href="/rss.xml">RSS</a></span><span><a href="/archive/">archive</a></span></div>
      <div class="cx-b"><JournalSubscribe where="index" /></div>
    </section>

    <div id="journal-list">
      <div class="findrow">
        <label for="jfind">Find</label>
        <input id="jfind" type="search" data-find="journal-list" placeholder="A title, a date" autocomplete="off" />
      </div>
      <p class="empty" data-empty hidden>Nothing filed under that.</p>
      {years.map((year) => (
        <details class="cx fold" id={`y${year}`} data-year open>
          <summary class="cx-h"><b><a href={`/journal/${year}/`}>{year}</a></b><em data-count>{postsByYear[year].length}</em></summary>
          <div data-list>
            {postsByYear[year].map((post) => (
              <a class="file" data-row={`${iso(post.data.publishDate)} ${plain(post.data.title)}`} href={`/journal/${post.slug}/`}>
                <span class="dt">{iso(post.data.publishDate)}</span>
                <PostTitle title={post.data.title} class="ttl" />
              </a>
            ))}
          </div>
        </details>
      ))}
    </div>

    {allPosts.length === 0 && <p class="note">No posts filed yet.</p>}
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const input = document.getElementById('jfind')
    if (!input) return
    const scope = document.getElementById(input.dataset.find)
    const boxes = [...scope.querySelectorAll('[data-year]')]
    const empty = scope.querySelector('[data-empty]')
    const run = () => {
      const q = input.value.trim().toLowerCase()
      let total = 0
      boxes.forEach((box) => {
        const rows = [...box.querySelectorAll('[data-row]')]
        rows.forEach((row) => { row.hidden = q.length > 0 && !row.dataset.row.includes(q) })
        const n = rows.filter((r) => !r.hidden).length
        total += n
        box.hidden = n === 0
        if (q) box.open = true
        const count = box.querySelector('[data-count]')
        if (count) count.textContent = String(n)
      })
      if (empty) empty.hidden = total !== 0
    }
    input.addEventListener('input', run)
    if (input.value) run()
  })()
</script>
