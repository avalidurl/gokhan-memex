---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHead from '@/components/PageHead.astro'
---

<BaseLayout
  title="Writing"
  description="Essays, research, and long-form analysis."
>
  <div class="es">
    <PageHead crumbs={[{ label: 'Journal', href: '/journal/' }, { label: 'Writing' }]} title="Writing" lead="Essays, research, and long-form analysis." />
    <section class="cx" aria-label="Writing">
      <div class="cx-h"><b>Where it lives</b></div>
      <div class="cx-r"><span><a href="/journal/">Journal</a></span><span>Every essay and dispatch, filed by year</span></div>
      <div class="cx-r"><span><a href="/publishing/">Publishing</a></span><span>E-books, academic and experimental work</span></div>
      <div class="cx-r"><span><a href="/archive/">Archive</a></span><span>Years, categories and tags</span></div>
    </section>
  </div>
</BaseLayout>
