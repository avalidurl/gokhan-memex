---
import { getCollection, type CollectionEntry } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PostTitle from '@/components/PostTitle.astro'
import PageHead from '@/components/PageHead.astro'
import { humanizeKebab } from '@/lib/utils'

type PostEntry = CollectionEntry<'blog'>

export const getStaticPaths: GetStaticPaths = async () => {
  const allPosts = (await getCollection('blog'))
    .filter((post: PostEntry) => !post.data.draft)

  const categories = [...new Set(allPosts.map((post: PostEntry) => post.data.category))]
  
  return categories.map((category: string) => ({
    params: { 
      category: category.toLowerCase().replace(/\s+/g, '-').replace(/&/g, 'and')
    }
  }))
}

const { category: categorySlug } = Astro.params as { category: string }

const allPosts = (await getCollection('blog'))
  .filter((post: PostEntry) => !post.data.draft)

const categoryMap = new Map<string, string>()
allPosts.forEach((post: PostEntry) => {
  const slug = post.data.category.toLowerCase().replace(/\s+/g, '-').replace(/&/g, 'and')
  categoryMap.set(slug, post.data.category)
})

const category = categoryMap.get(categorySlug) || categorySlug

const posts: PostEntry[] = allPosts
  .filter((post: PostEntry) => post.data.category === category)
  .sort((a: PostEntry, b: PostEntry) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf())
---

<BaseLayout
  title={`${humanizeKebab(category)} - Archive`}
  description={`${posts.length} posts in the ${category} category.`}
>
  <div class="es">
    <PageHead crumbs={[{ label: 'Archive', href: '/archive/' }, { label: 'Categories', href: '/archive/#categories' }]} title={humanizeKebab(category)} count={`${posts.length} post${posts.length !== 1 ? 's' : ''}`} />
    <details class="cx fold" open>
      <summary class="cx-h"><b>Posts</b><span>newest first</span><em>{String(posts.length).padStart(2, '0')}</em></summary>
      {posts.length > 0
        ? posts.map((post: PostEntry) => (
            <div class="cx-r"><span>{post.data.publishDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span><span><a href={`/journal/${post.slug}/`}><PostTitle title={post.data.title} /></a></span></div>
          ))
        : <div class="cx-b"><p>No posts in this category.</p></div>}
    </details>
    <section class="cx arch" aria-label="Back"><div class="cx-r" style="grid-template-columns:1fr"><span style="font-family:inherit;font-size:inherit"><a href="/archive/">← Back to the archive</a></span></div></section>
  </div>
</BaseLayout>
