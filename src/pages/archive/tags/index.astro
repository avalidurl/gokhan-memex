---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { humanizeKebab } from '@/lib/utils'

const allPosts = (await getCollection('blog'))
  .filter(post => !post.data.draft)

const tagMap = new Map<string, number>()
allPosts.forEach(post => {
  post.data.tags?.forEach(tag => {
    tagMap.set(tag, (tagMap.get(tag) ?? 0) + 1)
  })
})

const sortedTags = Array.from(tagMap.entries()).sort((a, b) => b[1] - a[1])
---

<BaseLayout
  title="All Tags"
  description={`Browse all ${sortedTags.length} tags`}
  robots="noindex, follow"
>
  <div class="mx-auto max-w-3xl px-5 py-10 lg:py-14">
    <header class="mb-10 pb-8 border-b border-border">
      <div class="kicker-pill mb-3">Archive</div>
      <h1 class="mb-2">Tags</h1>
      <p class="font-serif text-[18px] text-muted-foreground m-0">
        {sortedTags.length} tags across {allPosts.length} posts
      </p>
    </header>

    <div class="rounded-2xl border border-border bg-card p-6">
      <div class="flex flex-wrap gap-2">
        {sortedTags.map(([tag, count]) => (
          <a 
            href={`/archive/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`}
            class="inline-flex items-center gap-1 rounded-full border border-border bg-background px-3 py-1 text-[13px] font-medium text-muted-foreground no-underline hover:border-primary hover:text-primary transition-colors"
          >
            <span>{humanizeKebab(tag)}</span>
            <span class="text-[11px] opacity-70">({count})</span>
          </a>
        ))}
      </div>
    </div>

    <footer class="mt-10 pt-6 border-t border-border">
      <a 
        href="/archive"
        class="tile"
      >
        ← Back to Archive
      </a>
    </footer>
  </div>
</BaseLayout>
