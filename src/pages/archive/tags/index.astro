---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { tagIndex, total } from '@/lib/tags'

const idx = [...(await tagIndex()).values()]
const groups = [
  ['family', 'Family'], ['domain', 'Domain'], ['kind', 'Kind'], ['chain', 'Chain'], ['rail', 'Payment rail'],
] as const
const other = idx.filter((b) => !b.def).sort((a, b) => total(b) - total(a))
---

<BaseLayout title="Tags" description={`All ${idx.length} tags across products, journal posts, drafts, tools and APIs.`} robots="noindex, follow">
  <div class="es">
    <p class="crumb"><a href="/archive/">Archive</a> / Tags</p>
    <div class="intro">
      <h1>Tags</h1>
      <p class="lead">One set of tags for the whole site. Each opens a page with its products, posts, drafts, tools and APIs.</p>
    </div>
    <div class="dither"></div>
    {groups.map(([g, label]) => {
      const list = idx.filter((b) => b.def?.group === g).sort((a, b) => total(b) - total(a))
      return list.length > 0 && (
        <section class="cx" aria-label={label}>
          <div class="cx-h"><b>{label}</b><em>{String(list.length).padStart(2, '0')}</em></div>
          <div class="cx-b">{list.map((b) => <a class="tg" href={`/archive/tags/${b.slug}/`}>{b.label} · {total(b)}</a>)}</div>
        </section>
      )
    })}
    <section class="cx" aria-label="Journal tags">
      <div class="cx-h"><b>Journal tags</b><em>{String(other.length).padStart(2, '0')}</em></div>
      <div class="cx-b">{other.map((b) => <a class="tg" href={`/archive/tags/${b.slug}/`}>{b.label} · {total(b)}</a>)}</div>
    </section>
  </div>
</BaseLayout>
