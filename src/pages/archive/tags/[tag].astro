---
import { getCollection, type CollectionEntry } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PostTitle from '@/components/PostTitle.astro'
import { humanizeKebab } from '@/lib/utils'

type PostEntry = CollectionEntry<'blog'>

export const getStaticPaths: GetStaticPaths = async () => {
  const allPosts = (await getCollection('blog'))
    .filter((post: PostEntry) => !post.data.draft)

  const tagSet = new Set<string>()
  allPosts.forEach((post: PostEntry) => {
    post.data.tags?.forEach((tag: string) => {
      tagSet.add(tag)
    })
  })

  return Array.from(tagSet).map((tag: string) => ({
    params: {
      tag: tag.toLowerCase().replace(/\s+/g, '-')
    }
  }))
}

const { tag: tagSlug } = Astro.params as { tag: string }

const allPosts = (await getCollection('blog'))
  .filter((post: PostEntry) => !post.data.draft)

const tagMap = new Map<string, string>()
allPosts.forEach((post: PostEntry) => {
  post.data.tags?.forEach((tag: string) => {
    const slug = tag.toLowerCase().replace(/\s+/g, '-')
    tagMap.set(slug, tag)
  })
})

const tag = tagMap.get(tagSlug) || tagSlug
const displayTag = humanizeKebab(tag)

const posts: PostEntry[] = allPosts
  .filter((post: PostEntry) => post.data.tags?.some((t: string) =>
    t.toLowerCase().replace(/\s+/g, '-') === tagSlug
  ))
  .sort((a: PostEntry, b: PostEntry) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf())
---

<BaseLayout
  title={`${displayTag} - Archive`}
  description={`${posts.length} posts tagged with ${displayTag}.`}
  robots="noindex, follow"
>
  <div class="mx-auto max-w-3xl px-5 py-10 lg:py-14">
    <header class="mb-10 pb-8 border-b border-border">
      <div class="kicker-pill mb-3">Tag</div>
      <h1 class="mb-2">{displayTag}</h1>
      <p class="font-serif text-[18px] text-muted-foreground m-0">
        {posts.length} post{posts.length !== 1 ? 's' : ''}
      </p>
    </header>

    {posts.length > 0 ? (
      <div class="rounded-2xl border border-border bg-card overflow-hidden">
        <ul class="divide-y divide-border list-none p-0 m-0">
          {posts.map((post: PostEntry) => (
            <li class="m-0">
              <a 
                href={`/journal/${post.slug}/`}
                class="group flex items-baseline justify-between gap-4 px-5 py-3.5 no-underline hover:bg-muted/50 transition-colors"
              >
                <PostTitle title={post.data.title} class="font-serif text-[17.5px] font-semibold text-foreground group-hover:text-primary transition-colors flex-1" />
                <span class="text-sm text-muted-foreground shrink-0 tabular-nums">
                  {post.data.publishDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ) : (
      <p class="text-muted-foreground">No posts with this tag.</p>
    )}

    <div class="mt-10 pt-6 border-t border-border">
      <a 
        href="/archive"
        class="tile"
      >
        ← Back to archive
      </a>
    </div>
  </div>
</BaseLayout>
