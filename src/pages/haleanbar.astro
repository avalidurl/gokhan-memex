---
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout
  title="Hale Anbar"
  description="Artist and researcher exploring intersections of technology and creative practice"
>
  <div class="mx-auto max-w-3xl px-5 py-10 lg:py-14">
    <header class="mb-10 pb-8 border-b border-border">
      <div class="kicker-pill mb-3">Profile</div>
      <h1 class="mb-3">Hale Anbar</h1>
      <p class="font-serif text-[19px] text-muted-foreground m-0">
        Artist and researcher exploring intersections of technology and creative practice.
      </p>
    </header>

    <div class="rounded-2xl border border-border bg-card p-10 text-center">
      <p class="font-serif text-[19px] text-muted-foreground mb-6">
        Page coming soon.
      </p>
      <a 
        href="/lists"
        class="tile"
      >
        ← Back to lists
      </a>
    </div>
  </div>
</BaseLayout>
