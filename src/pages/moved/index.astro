---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHead from '@/components/PageHead.astro'
---

<BaseLayout
  title="Moved"
  description="numetal.xyz, gokhan.vc and their product subdomains now live on gokhanturhan.com."
  robots="noindex, follow"
>
  <div class="es">
    <PageHead crumbs={[{ label: 'Index', href: '/' }, { label: 'Moved' }]} title="Everything is now on gokhanturhan.com" lead="numetal.xyz, gokhan.vc and their product subdomains no longer serve their own pages. Old links forward here or to the matching page." />
      <div class="cx">
        <div class="cx-h"><b>Former addresses</b><span>now on this site</span></div>
        <div class="cv-line"><span>numetal.xyz</span><b><a href="/numetal/">Numetal</a></b></div>
        <div class="cv-line"><span>gokhan.vc</span><b><a href="/gokhan-vc/">Gökhan Ventures</a></b></div>
        <div class="cv-line"><span>*.numetal.xyz</span><b>Each product has its own page under <a href="/products/">Products</a></b></div>
      </div>

      <div class="cx">
        <div class="cx-h"><b>Where to go</b></div>
        <div class="cv-line"><span>Products</span><b><a href="/products/">current, studio and drafts</a></b></div>
        <div class="cv-line"><span>Journal</span><b><a href="/journal/">dispatches and essays</a></b></div>
        <div class="cv-line"><span>About</span><b><a href="/about/">this site</a> · <a href="/about/why-addresses-moved/">why addresses moved</a></b></div>
        <div class="cv-line"><span>Contact</span><b><a href="mailto:contact@gokhan.vc">contact@gokhan.vc</a></b></div>
      </div>
  </div>
</BaseLayout>
