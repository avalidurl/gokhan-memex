---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHead from '@/components/PageHead.astro'
import { explorers, parties } from '@/data/coins-wallets'

type Handle = { href: string; note: string }
type Group = { name: string; handles: Handle[] }
type Section = { id: string; title: string; hint: string; groups: Group[] }

const display = (href: string) => {
  if (href.startsWith('mailto:')) return href.slice(7)
  const u = new URL(href)
  return (u.host + u.pathname.replace(/\/+$/, '') + u.search).replace(/\/+$/, '')
}

