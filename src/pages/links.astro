const walletNetworks: { id: string; title: string; hint: string; items: typeof parties }[] = [
  {
    id: 'wallets-evm',
    title: 'Ethereum, Base & Robinhood Chain',
    hint: 'same address on each EVM network',
    items: parties.filter((p) => p.address && p.chain !== 'solana' && p.chain !== 'canton'),
  },
  {
    id: 'wallets-solana',
    title: 'Solana',
    hint: 'pump.fun @gokhan',
    items: parties.filter((p) => p.address && p.chain === 'solana'),
  },
  {
    id: 'wallets-canton',
    title: 'Canton',
    hint: 'Supanova',
    items: parties.filter((p) => p.address && p.chain === 'canton'),
  },
]

const nav = [
  ...sections.map((s) => ({ id: s.id, title: s.title })),
  { id: 'wallets', title: 'Wallets' },
  ...walletNetworks.map((n) => ({ id: n.id, title: n.title })),
]

const linkCount = sections.reduce((n, s) => n + s.groups.reduce((m, g) => m + g.handles.length, 0), 0)
const walletCount = walletNetworks.reduce((n, net) => n + net.items.length, 0)
---

<BaseLayout
  title="Links"
  description="Where to find Gökhan Turhan: social channels, writing, professional and academic profiles, decentralized social, multimedia, and wallet addresses."
  robots="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
>
  <div class="es">
    <PageHead
      crumbs={[{ label: 'Index', href: '/' }, { label: 'Links' }]}
      title="Links"
      lead="Where to find Gökhan Turhan elsewhere, and the wallet addresses published on this site."
      count={String(linkCount + walletCount).padStart(2, '0')}
    />

    <nav class="cx lk-nav" aria-label="On this page">
      <div class="cx-h"><b>On this page</b><span>jump to a section</span><em>{String(nav.length).padStart(2, '0')}</em></div>
      <div class="lk-toc">
        {nav.map((item) => (
          <a href={`#${item.id}`}>{item.title}</a>
        ))}
      </div>
    </nav>

    {sections.map((s) => (
      <section class="cx lk-sec" id={s.id} aria-labelledby={`${s.id}-heading`}>
        <div class="cx-h">
          <b id={`${s.id}-heading`}><a href={`#${s.id}`} class="lk-head">{s.title}</a></b>
          <span>{s.hint}</span>
          <button type="button" class="cr-copy lk-copy" data-hash={`#${s.id}`} aria-label={`Copy link to ${s.title}`}>Copy link</button>
          <em>{String(s.groups.reduce((n, g) => n + g.handles.length, 0)).padStart(2, '0')}</em>
        </div>
        {s.groups.map((g) => (
          <div class="cx-r">
            <span>{g.name}</span>
            <span class="lk">
              {g.handles.map((h) => (
                <span class="lk-i">
                  {h.href.startsWith('mailto:')
                    ? <a href={h.href}>{display(h.href)}</a>
                    : <a href={h.href} rel="me noopener">{display(h.href)}</a>
                  }
                  <i>{h.note}</i>
                </span>
              ))}
            </span>
          </div>
        ))}
      </section>
    ))}

    <section class="cx lk-sec" id="wallets" aria-labelledby="wallets-heading">
      <div class="cx-h">
        <b id="wallets-heading"><a href="#wallets" class="lk-head">Wallets</a></b>
        <span>addresses already published on this site, grouped by network — nothing invented</span>
        <button type="button" class="cr-copy lk-copy" data-hash="#wallets" aria-label="Copy link to Wallets">Copy link</button>
        <em>{String(walletCount).padStart(2, '0')}</em>
      </div>
      {walletNetworks.map((net) => (
        <div class="lk-net" id={net.id}>
          <div class="cx-h lk-sub">
            <b><a href={`#${net.id}`} class="lk-head">{net.title}</a></b>
            <span>{net.hint}</span>
            <button type="button" class="cr-copy lk-copy" data-hash={`#${net.id}`} aria-label={`Copy link to ${net.title}`}>Copy link</button>
            <em>{String(net.items.length).padStart(2, '0')}</em>
          </div>
          {net.items.map((p) => (
            <div class="cx-r lk-w">
              <span>{p.label || p.id}{p.note ? <i> {p.note}</i> : null}</span>
              <span class="lk-addr">
                <code class="lk-code">{p.address}</code>
                <button type="button" class="cr-copy" data-copy={p.address} aria-label={`Copy ${p.label || p.id} address`}>Copy</button>
                <span class="lk-ex">
                  {explorers(p).map((e) => (
                    <a href={e.href} rel="noopener">{e.short || e.label}</a>
                  ))}
                </span>
              </span>
            </div>
          ))}
        </div>
      ))}
    </section>
  </div>
</BaseLayout>

<style>
  .lk-nav { position: sticky; top: 0; z-index: 6; }
  .lk-toc { display: flex; flex-wrap: wrap; }
  .lk-toc a {
    font: 12.5px/1.35 var(--mono);
    padding: 7px 10px;
    color: var(--ink);
    text-decoration: none;
    border-right: 1px dotted var(--hair);
    border-bottom: 1px dotted var(--hair);
  }
  .lk-toc a:hover { color: var(--ikb); }
  .lk-sec { scroll-margin-top: 5.5rem; }
  .lk-net { scroll-margin-top: 5.5rem; }
  .lk-net + .lk-net { border-top: 1px solid var(--ink); }
  .lk-sub { border-top: 0; border-bottom: 1px solid var(--ink); }
  .lk-head { color: inherit; text-decoration: none; }
  .lk-head:hover { text-decoration: underline; text-underline-offset: 2px; }
  .cx-h .lk-copy { margin: 4px 0 4px auto; align-self: center; }
  .cx-h em { margin-left: 0; }
  .lk { display: flex; flex-direction: column; gap: 2px; }
  .lk-i { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 6px; }
  .lk-i i { margin-left: 0; }
  .lk-w > :first-child i { font: normal 11px var(--mono); color: var(--dim); }
  .lk-addr { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; min-width: 0; }
  .lk-code { font: 12.5px/1.45 var(--mono); overflow-wrap: anywhere; user-select: all; background: none; }
  .lk-ex { display: inline-flex; flex-wrap: wrap; gap: 8px; font: 11px/1 var(--mono); letter-spacing: .04em; }
  @media (max-width: 760px) {
    .lk-nav { position: static; }
    .lk-sec, .lk-net { scroll-margin-top: 0.5rem; }
    .cx-r.lk-w { grid-template-columns: 1fr; }
  }
</style>

<script>
  function copyText(value: string, btn: HTMLButtonElement, done = 'Copied') {
    const orig = btn.textContent
    const ok = () => { btn.textContent = done; setTimeout(() => { btn.textContent = orig }, 1400) }
    const fallback = () => {
      const ta = document.createElement('textarea')
      ta.value = value
      ta.setAttribute('readonly', '')
      ta.style.position = 'fixed'
      ta.style.left = '-9999px'
      document.body.appendChild(ta)
      ta.select()
      document.execCommand('copy')
      ta.remove()
    }
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(value).then(ok).catch(() => { fallback(); ok() })
    } else { fallback(); ok() }
  }
  document.querySelectorAll<HTMLButtonElement>('.cr-copy').forEach((b) => {
    b.addEventListener('click', () => {
      const hash = b.dataset.hash
      const value = hash
        ? new URL(hash, window.location.origin + window.location.pathname).href
        : b.dataset.copy || ''
      if (value) copyText(value, b)
    })
  })
</script>
