---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHead from '@/components/PageHead.astro'
import { explorers, parties, type Party } from '@/data/coins-wallets'

type Handle = { href: string; note?: string; label?: string; me?: boolean }
type Group = { name: string; tag?: string; handles: Handle[] }
type Section = { id: string; title: string; hint: string; groups: Group[] }
type WalletItem = {
  id: string
  label?: string
  address: string
  note?: string
  href?: string
  chain?: Party['chain'] | 'zcash'
  links?: { label: string; short?: string; href: string }[]
}

const display = (href: string) => {
  if (href.startsWith('mailto:')) return href.slice(7)
  const u = new URL(href)
  return (u.host + u.pathname.replace(/\/+$/, '') + u.search).replace(/\/+$/, '')
}

const isIdentity = (h: Handle) =>
  h.me !== false && !h.href.startsWith('mailto:') && !h.href.includes('/group_join/') && !h.href.includes('discord.gg')

const sections: Section[] = [
  {
    id: 'code',
    title: 'Code',
    hint: 'GitHub and Hugging Face',
    groups: [
      { name: 'GitHub', handles: [
        { href: 'https://github.com/avalidurl', note: 'personal bench' },
        { href: 'https://github.com/gokhan-vc', note: 'studio org' },
      ] },
      { name: 'Hugging Face', handles: [
        { href: 'https://huggingface.co/gokhanturhan' },
      ] },
    ],
  },
  {
    id: 'social-and-decentralized-social',
    title: 'Social & Decentralized Social',
    hint: 'X first; decentralized profiles are marked',
    groups: [
      { name: 'X', handles: [
        { href: 'https://x.com/goekhan', note: 'personal' },
        { href: 'https://x.com/goekhanvc', note: 'Gökhan Ventures' },
        { href: 'https://x.com/numetalxyz', note: 'Numetal · Ishtar · CURB' },
      ] },
      { name: 'Delve', tag: 'decentralized', handles: [
        { href: 'https://delve.town/profile/gokhan.delve.town', note: 'gokhan.delve.town' },
      ] },
      { name: 'Farcaster', tag: 'decentralized', handles: [
        { href: 'https://farcaster.xyz/gokhan', note: 'personal' },
      ] },
      { name: 'Lens', tag: 'decentralized', handles: [
        { href: 'https://hey.xyz/u/gokhaneth', note: 'gokhaneth' },
      ] },
      { name: 'Nostr', tag: 'decentralized', handles: [
        { href: 'https://primal.net/gokhan', note: 'gokhan' },
      ] },
      { name: 'Zora', tag: 'decentralized', handles: [
        { href: 'https://zora.co/@gokhan', note: '@gokhan' },
      ] },
      { name: 'ENS', handles: [
        { href: 'https://app.ens.domains/gokhan.eth', label: 'gokhan.eth' },
      ] },
      { name: 'EFP', handles: [
        { href: 'https://efp.app/0x36de990133d36d7e3df9a820aa3ede5a2320de71', note: 'Ethereum Follow Protocol — gokhan.eth' },
      ] },
      { name: 'zcash.me', handles: [
        { href: 'https://zcash.me/gokhan', note: 'profile' },
      ] },
      { name: 'Moltbook', handles: [
        { href: 'https://www.moltbook.com/m/courtship', note: "Ishtar's floor on the agent-only network — staffed by the intern" },
      ] },
      { name: 'Reddit', handles: [
        { href: 'https://www.reddit.com/user/toombak/', note: 'personal' },
      ] },
      { name: 'TikTok', handles: [
        { href: 'https://www.tiktok.com/@gokhan.eth', note: 'personal' },
      ] },
      { name: 'Truth Social', handles: [
        { href: 'https://truthsocial.com/@gokhanturhan', note: 'personal' },
      ] },
      { name: 'Bluesky', handles: [
        { href: 'https://bsky.app/profile/gokhan.substack.com', note: 'personal' },
      ] },
    ],
  },
  {
    id: 'chats-communities',
    title: 'Chats & Communities',
    hint: 'Telegram channels, Discord and the X Group',
    groups: [
      { name: 'Telegram', handles: [
        { href: 'https://t.me/marketresearchunit', note: 'Market Research Unit — main channel' },
        { href: 'https://t.me/goekhanturhan', note: 'personal' },
        { href: 'https://t.me/gokhanturhans', note: 'Research Log — channel' },
        { href: 'https://t.me/numetalxyz', note: 'Numetal' },
      ] },
      { name: 'Discord', handles: [
        { href: 'https://discord.com/users/468471856773464075', note: 'Discord, DM' },
        { href: 'https://discord.gg/ZcxcwRPT7R', note: 'Market Research Unit — server invite' },
        { href: 'https://discord.gg/MC4DYumPMz', note: 'Numetal — server invite' },
      ] },
      { name: 'X Group', handles: [
        { href: 'https://x.com/i/chat/group_join/g2109600261379367331/cEgOlxjpBN', note: 'X Group', me: false },
      ] },
    ],
  },
  {
    id: 'blogs-newsletters-writing',
    title: 'Blogs, Newsletters & Writing',
    hint: 'Substack first, then the other desks',
    groups: [
      { name: 'Substack', handles: [
        { href: 'https://gokhan.substack.com/', note: 'long-form research and analysis' },
      ] },
      { name: 'Medium', handles: [
        { href: 'https://goekhanturhan.medium.com/', note: 'writing' },
      ] },
      { name: 'Paragraph', handles: [
        { href: 'https://paragraph.com/@gokhan', note: 'writing' },
      ] },
      { name: 'Bear Blog', handles: [
        { href: 'https://gokhan.bearblog.dev/', note: 'writing' },
      ] },
      { name: 'Journal', handles: [
        { href: 'https://gokhanturhan.com/journal/', note: 'essays and notes on this site' },
      ] },
      { name: 'Cent', handles: [
        { href: 'https://beta.cent.co/goekhanturhan/', note: 'writing' },
      ] },
    ],
  },
  {
    id: 'professional-networking',
    title: 'Professional Networking',
    hint: 'LinkedIn and profile pages',
    groups: [
      { name: 'LinkedIn', handles: [
        { href: 'https://www.linkedin.com/in/goekhanturhan/', note: 'Gökhan Turhan' },
      ] },
      { name: 'Icebreaker', handles: [
        { href: 'https://app.icebreaker.xyz/profiles/N0nU43KFOTZ8geAxTRQAW', note: 'profile' },
      ] },
      { name: 'Talent Protocol', handles: [
        { href: 'https://talentprotocol.com/score/0x36de990133D36d7E3DF9a820aA3eDE5a2320De71?github=avalidurl', note: 'Builder Score' },
      ] },
    ],
  },
  {
    id: 'academic',
    title: 'Academic',
    hint: 'citations and research profiles',
    groups: [
      { name: 'Google Scholar', handles: [
        { href: 'https://scholar.google.com/citations?user=EgZE838AAAAJ', note: 'citations' },
      ] },
      { name: 'ResearchGate', handles: [
        { href: 'https://www.researchgate.net/profile/Goekhan-Turhan-2', note: 'profile' },
      ] },
      { name: 'ORCID', handles: [
        { href: 'https://orcid.org/0000-0002-1887-406X', note: '0000-0002-1887-406X' },
      ] },
    ],
  },
  {
    id: 'multimedia',
    title: 'Multimedia',
    hint: 'listening, reading and video',
    groups: [
      { name: 'Last.fm', handles: [
        { href: 'https://www.last.fm/user/gokhanturhan', note: 'listening' },
      ] },
      { name: 'Goodreads', handles: [
        { href: 'https://www.goodreads.com/user/show/104156530-g-khan', note: 'books and reading' },
      ] },
      { name: 'SoundCloud', handles: [
        { href: 'https://soundcloud.com/0xgokhan', note: 'audio' },
      ] },
      { name: 'Vimeo', handles: [
        { href: 'https://vimeo.com/0xgokhan', note: 'video' },
      ] },
    ],
  },
  {
    id: 'link-aggregators',
    title: 'Link Aggregators',
    hint: 'about.me and Linktree',
    groups: [
      { name: 'about.me', handles: [
        { href: 'https://about.me/gokhan0x', note: 'profile' },
      ] },
      { name: 'Linktree', handles: [
        { href: 'https://linktr.ee/0xgokhan', note: 'profile' },
      ] },
    ],
  },
]

const known = new Set(parties.map((p) => p.address?.toLowerCase()).filter(Boolean) as string[])
const fromParty = (p: Party): WalletItem | null =>
  p.address ? { id: p.id, label: p.label, address: p.address, note: p.note, chain: p.chain } : null

const profileEvm: WalletItem[] = [
  { id: 'ZORA-LINKED', label: 'Zora linked wallet', address: '0x4DF89a7437786eB8Af595979a638a4a9382c33D6', note: 'linked on zora.co/@gokhan' },
  { id: 'LENS-ACCOUNT', label: 'Lens account', address: '0xE8b26757Bc7429d1fD16233437121dE904dac806', note: 'hey.xyz/u/gokhaneth' },
].filter((p) => !known.has(p.address.toLowerCase()))

const walletNetworks: { id: string; title: string; hint: string; items: WalletItem[] }[] = [
  {
    id: 'wallets-ens',
    title: 'ENS',
    hint: '',
    items: [
      {
        id: 'ENS',
        label: 'ENS',
        address: 'gokhan.eth',
        href: 'https://app.ens.domains/gokhan.eth',
      },
    ],
  },
  {
    id: 'wallets-evm',
    title: 'Ethereum, Base & Robinhood Chain',
    hint: 'same address on each EVM network',
    items: [
      ...parties.filter((p) => p.address && p.chain !== 'solana' && p.chain !== 'canton').map((p) => fromParty(p)!),
      ...profileEvm,
    ],
  },
  {
    id: 'wallets-solana',
    title: 'Solana',
    hint: 'main address, then pump.fun @gokhan',
    items: parties.filter((p) => p.address && p.chain === 'solana').map((p) => fromParty(p)!),
  },
  {
    id: 'wallets-canton',
    title: 'Canton',
    hint: 'Supanova',
    items: parties.filter((p) => p.address && p.chain === 'canton').map((p) => fromParty(p)!),
  },
  {
    id: 'wallets-zcash',
    title: 'Zcash',
    hint: 'from zcash.me/gokhan',
    items: [
      {
        id: 'ZEC-UA',
        label: 'Unified',
        address: 'u172a6j85et6eglhc7wasffsl3l4n5jrwkx4tmtw4nmwzjgksrydevqzeqp83y8my33fnqp73tgaac57xtcel94qajn35eemv9jwd87jza69ey70weqwmspld3rm7q7dnnt5fgpq07p8fw48g7ew7hjecaud7nf0dwcfxu688a7yvajmnq',
        note: 'profile address on zcash.me/gokhan — a unified address, which receives shielded funds',
        chain: 'zcash',
        links: [{ label: 'zcash.me/gokhan', short: 'zcash.me', href: 'https://zcash.me/gokhan' }],
      },
    ],
  },
]

function walletLinks(p: WalletItem) {
  if (p.links) return p.links
  if (p.chain === 'zcash') return []
  return explorers({ id: p.id, address: p.address, short: p.address, chain: p.chain })
}

const nav = [
  ...sections.map((s) => ({ id: s.id, title: s.title })),
  { id: 'wallets', title: 'Wallets' },
  ...walletNetworks.map((n) => ({ id: n.id, title: n.title })),
]

const linkCount = sections.reduce((n, s) => n + s.groups.reduce((m, g) => m + g.handles.length, 0), 0)
const walletCount = walletNetworks.reduce((n, net) => n + net.items.length, 0)
---

<BaseLayout
  title="Links"
  description="Where to find Gökhan Turhan: social and decentralized profiles, chats, writing, professional and academic profiles, multimedia, link aggregators, and wallet addresses."
  robots="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
>
  <div class="es">
    <PageHead
      crumbs={[{ label: 'Index', href: '/' }, { label: 'Links' }]}
      title="Links"
      lead="Where to find Gökhan Turhan elsewhere, and the wallet addresses published on this site and on his public profiles."
      count={String(linkCount + walletCount).padStart(2, '0')}
    />

    <nav class="cx lk-nav" aria-label="On this page">
      <div class="cx-h">
        <b>On this page</b>
        <span>jump to a section</span>
        <button type="button" class="lk-all" id="lk-all">Collapse all</button>
        <em>{String(nav.length).padStart(2, '0')}</em>
      </div>
      <div class="lk-toc">
        {nav.map((item) => (
          <a href={`#${item.id}`}>{item.title}</a>
        ))}
      </div>
    </nav>

    <div id="contact" class="lk-alias" aria-hidden="true"></div>

    {sections.map((s) => (
      <details class="cx lk-sec fold" id={s.id} open>
        {s.id === 'social-and-decentralized-social' && (
          <>
            <div id="social-media-platforms" class="lk-alias" aria-hidden="true"></div>
            <div id="decentralized-social" class="lk-alias" aria-hidden="true"></div>
          </>
        )}
        <summary class="cx-h lk-sum">
          <b id={`${s.id}-heading`}><a href={`/links/#${s.id}`} class="lk-head">{s.title}</a></b>
          {s.hint ? <span>{s.hint}</span> : null}
          <a class="lk-copy" href={`/links/#${s.id}`} aria-label={`Copy link to ${s.title}`} title={`Copy link to ${s.title}`}>
            <svg class="lk-ico lk-chain" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            <svg class="lk-ico lk-check" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.75.75 0 0 1 1.06-1.06L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z"/></svg>
          </a>
          <em>{String(s.groups.reduce((n, g) => n + g.handles.length, 0)).padStart(2, '0')}</em>
        </summary>
        {s.groups.map((g) => (
          <div class:list={["cx-r", { "lk-name": g.name === "ENS" }]}>
            <span>{g.name}{g.tag ? <i class="lk-tag">{g.tag}</i> : null}</span>
            <span class="lk">
              {g.handles.map((h) => (
                <span class="lk-i">
                  {isIdentity(h)
                    ? <a href={h.href} rel="me noopener">{h.label || display(h.href)}</a>
                    : <a href={h.href} rel="noopener">{h.label || display(h.href)}</a>
                  }
                  {h.note ? <i>{h.note}</i> : null}
                </span>
              ))}
            </span>
          </div>
        ))}
      </details>
    ))}

    <details class="cx lk-sec fold" id="wallets" open>
      <summary class="cx-h lk-sum">
        <b id="wallets-heading"><a href="/links/#wallets" class="lk-head">Wallets</a></b>
        <span>addresses published on this site and on his public profiles, grouped by network — nothing invented</span>
        <a class="lk-copy" href="/links/#wallets" aria-label="Copy link to Wallets" title="Copy link to Wallets">
          <svg class="lk-ico lk-chain" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          <svg class="lk-ico lk-check" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.75.75 0 0 1 1.06-1.06L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z"/></svg>
        </a>
        <em>{String(walletCount).padStart(2, '0')}</em>
      </summary>
      {walletNetworks.map((net) => (
        <details class="cx lk-net fold" id={net.id} open>
          <summary class="cx-h lk-sum lk-sub">
            <b><a href={`/links/#${net.id}`} class="lk-head">{net.title}</a></b>
            {net.hint ? <span>{net.hint}</span> : null}
            <a class="lk-copy" href={`/links/#${net.id}`} aria-label={`Copy link to ${net.title}`} title={`Copy link to ${net.title}`}>
              <svg class="lk-ico lk-chain" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              <svg class="lk-ico lk-check" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.75.75 0 0 1 1.06-1.06L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z"/></svg>
            </a>
            <em>{String(net.items.length).padStart(2, '0')}</em>
          </summary>
          {net.items.map((p) => (
            p.href ? (
              <div class="cx-r lk-name">
                <span>{p.label || p.id}</span>
                <span class="lk"><a href={p.href} rel="me noopener">{p.address}</a></span>
              </div>
            ) : (
            <div class="cx-r lk-w">
              <span>{p.label || p.id}{p.note ? <i> {p.note}</i> : null}</span>
              <span class="lk-addr">
                <code class="lk-code">{p.address}</code>
                <button type="button" class="cr-copy" data-copy={p.address} aria-label={`Copy ${p.label || p.id} address`}>Copy</button>
                <span class="lk-ex">
                  {walletLinks(p).map((e) => (
                    <a href={e.href} rel="noopener">{e.short || e.label}</a>
                  ))}
                </span>
              </span>
            </div>
            )
          ))}
        </details>
      ))}
    </details>
  </div>
</BaseLayout>

<style>
  .lk-nav { position: sticky; top: 0; z-index: 6; }
  .lk-toc { display: flex; flex-wrap: wrap; }
  .lk-toc a {
    font: 12.5px/1.35 var(--mono);
    padding: 7px 10px;
    color: var(--ink);
    text-decoration: none;
    border-right: 1px dotted var(--hair);
    border-bottom: 1px dotted var(--hair);
  }
  .lk-toc a:hover { color: var(--ikb); }
  .lk-sec { scroll-margin-top: 5.5rem; }
  .lk-net { scroll-margin-top: 5.5rem; }
  .lk-net + .lk-net { border-top: 1px solid var(--ink); }
  .lk-sub { border-top: 0; border-bottom: 1px solid var(--ink); }
  .lk-head { color: inherit; text-decoration: none; }
  .lk-tag {
    font: 10px/1.2 var(--mono);
    font-style: normal;
    letter-spacing: .06em;
    color: var(--ikb);
    margin-left: 0.5em;
    white-space: nowrap;
  }
  .lk-alias { scroll-margin-top: 5.5rem; height: 0; }
  .lk-head:hover { text-decoration: underline; text-underline-offset: 2px; }
  /* Plain sitemap-style headers: no inverted black label, red triangle, count. */
  details.lk-sec.fold,
  details.lk-net.fold {
    position: relative;
    border: 0;
    background: transparent;
    margin: 0;
    border-top: 1px solid var(--ink);
  }
  details.lk-sec.fold > summary.lk-sum,
  details.lk-net.fold > summary.lk-sum {
    display: flex;
    align-items: baseline;
    justify-content: flex-start;
    gap: 0.65rem 1rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
    border: 0;
    background: transparent;
    padding: 0.85rem 0;
    font: inherit;
    letter-spacing: 0;
    text-transform: none;
  }
  details.lk-sec.fold > summary.lk-sum::-webkit-details-marker,
  details.lk-sec.fold > summary.lk-sum::marker,
  details.lk-net.fold > summary.lk-sum::-webkit-details-marker,
  details.lk-net.fold > summary.lk-sum::marker { display: none; content: none; }
  details.lk-sec.fold > summary.lk-sum::before,
  details.lk-net.fold > summary.lk-sum::before {
    content: "▸";
    display: inline-block;
    width: 1.1em;
    flex: none;
    padding: 0;
    color: var(--red);
    font-family: var(--sans);
    font-weight: 400;
    font-size: 1.05rem;
    line-height: 1;
    letter-spacing: 0;
    text-transform: none;
  }
  details.lk-sec.fold[open] > summary.lk-sum::before,
  details.lk-net.fold[open] > summary.lk-sum::before { content: "▾"; }
  details.lk-sec.fold > summary.lk-sum b,
  details.lk-net.fold > summary.lk-sum b {
    background: transparent;
    color: var(--ink);
    padding: 0;
    border: 0;
    font-family: var(--sans);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.01em;
    text-transform: none;
  }
  details.lk-sec.fold > summary.lk-sum span,
  details.lk-net.fold > summary.lk-sum span {
    padding: 0;
    color: var(--dim);
    font-family: var(--read);
    font-size: 0.92rem;
    letter-spacing: 0;
    text-transform: none;
  }
  details.lk-sec.fold > summary.lk-sum em,
  details.lk-net.fold > summary.lk-sum em {
    margin-left: auto;
    padding: 0;
    border: 0;
    font-family: var(--mono);
    font-size: 0.8rem;
    font-style: normal;
    font-weight: 500;
    color: var(--ikb);
    letter-spacing: 0;
    text-transform: none;
  }
  details.lk-net.fold { margin-left: 1.15rem; border-top: 1px solid var(--hair); }
  details.lk-sec.fold:not([open]) > summary.lk-sum,
  details.lk-net.fold:not([open]) > summary.lk-sum { border-bottom: 0; }
  .lk-all {
    appearance: none;
    margin-left: auto;
    align-self: center;
    padding: 0.35rem 0.55rem;
    border: 0;
    background: transparent;
    color: var(--ikb);
    font: 500 11px/1 var(--mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    min-height: 32px;
  }
  .lk-all:hover { text-decoration: underline; text-underline-offset: 2px; }
  .lk-all:focus-visible { outline: 2px solid var(--ikb); outline-offset: 2px; }
  body.register main a.lk-copy,
  a.lk-copy {
    all: unset;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 4px 0 4px auto;
    align-self: center;
    width: 32px;
    height: 32px;
    min-width: 32px;
    min-height: 32px;
    cursor: pointer;
    color: var(--dim);
    border-radius: 0;
    text-decoration: none;
  }
  body.register main a.lk-copy:hover,
  body.register main a.lk-copy:focus-visible,
  a.lk-copy:hover,
  a.lk-copy:focus-visible { color: var(--ikb); }
  a.lk-copy:focus-visible { outline: 2px solid var(--ikb); outline-offset: 1px; }
  .lk-ico { display: block; }
  .lk-copy .lk-check { display: none; }
  .lk-copy.is-copied { color: var(--ikb); }
  .lk-copy.is-copied .lk-chain { display: none; }
  .lk-copy.is-copied .lk-check { display: block; }
  details.lk-sec.fold > summary.lk-sum .lk-copy,
  details.lk-net.fold > summary.lk-sum .lk-copy { margin: 0 0 0 auto; }
  details.lk-sec.fold > summary.lk-sum:has(.lk-copy) em,
  details.lk-net.fold > summary.lk-sum:has(.lk-copy) em { margin-left: 0; }
  .lk { display: flex; flex-direction: column; gap: 2px; }
  .lk-i { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 6px; }
  .lk-i i { margin-left: 0; }
  .lk-w > :first-child i { font: normal 11px var(--mono); color: var(--dim); }
  .lk-addr { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; min-width: 0; }
  .lk-code { font: 12.5px/1.45 var(--mono); overflow-wrap: anywhere; user-select: all; background: none; }
  .lk-ex { display: inline-flex; flex-wrap: wrap; gap: 8px; font: 11px/1 var(--mono); letter-spacing: .04em; }
  .cx-r.lk-name { align-items: baseline; }
  .cx-r.lk-name .lk { white-space: nowrap; }

  @media (max-width: 760px) {
    .lk-nav { position: static; }
    .lk-sec, .lk-net { scroll-margin-top: 0.5rem; }
    .cx-r.lk-w { grid-template-columns: 1fr; }
    .cx-r.lk-name { grid-template-columns: auto 1fr !important; align-items: baseline; }
    .cx-r.lk-name .lk, .cx-r.lk-name a { white-space: nowrap; }
    details.lk-sec > summary.lk-sum,
    details.lk-net > summary.lk-sum {
      flex-wrap: nowrap;
      align-items: center;
    }
    details.lk-sec > summary.lk-sum > span,
    details.lk-net > summary.lk-sum > span { display: none; }
    details.lk-sec > summary.lk-sum > b,
    details.lk-net > summary.lk-sum > b {
      flex: 1 1 auto;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    details.lk-sec > summary.lk-sum .lk-copy,
    details.lk-net > summary.lk-sum .lk-copy { margin: 0; flex: none; }
    details.lk-sec > summary.lk-sum em,
    details.lk-net > summary.lk-sum em { flex: none; margin-left: 0; padding: 0 0 0 7px; }
    .lk-nav .cx-h { flex-wrap: wrap; }
    .lk-nav .cx-h > span { display: none; }
    .lk-all { margin-left: auto; }
  }
</style>

<script>
  function copyValue(value: string, btn: HTMLButtonElement) {
    const fallback = () => {
      const ta = document.createElement('textarea')
      ta.value = value
      ta.setAttribute('readonly', '')
      ta.style.position = 'fixed'
      ta.style.left = '-9999px'
      document.body.appendChild(ta)
      ta.select()
      document.execCommand('copy')
      ta.remove()
    }
    const run = () => {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        return navigator.clipboard.writeText(value).catch(() => fallback())
      }
      fallback()
      return Promise.resolve()
    }
    const orig = btn.textContent
    run().then(() => {
      btn.textContent = 'Copied'
      window.setTimeout(() => { btn.textContent = orig }, 1400)
    })
  }

  document.querySelectorAll<HTMLButtonElement>('.cr-copy[data-copy]').forEach((b) => {
    b.addEventListener('click', (event) => {
      event.preventDefault()
      event.stopPropagation()
      const value = b.dataset.copy || ''
      if (value) copyValue(value, b)
    })
  })

  const mq = window.matchMedia('(max-width: 720px)')
  const folds = () => document.querySelectorAll<HTMLDetailsElement>('details.lk-sec, details.lk-net')
  const allBtn = document.getElementById('lk-all') as HTMLButtonElement | null

  function anyOpen() {
    return Array.from(folds()).some((d) => d.open)
  }

  function syncAll() {
    if (!allBtn) return
    const open = anyOpen()
    allBtn.textContent = open ? 'Collapse all' : 'Expand all'
    allBtn.setAttribute('aria-expanded', String(open))
  }

  document.querySelectorAll<HTMLDetailsElement>('details.lk-sec, details.lk-net').forEach((d) => {
    const head = d.querySelector<HTMLElement>(':scope > summary.lk-sum')
    head?.addEventListener('click', (event) => {
      const t = event.target
      if (!(t instanceof Element)) return
      // Links and copy keep their own action; don't also toggle the section.
      if (t.closest('a, button, .cr-copy')) event.preventDefault()
    })
    d.addEventListener('toggle', syncAll)
  })

  allBtn?.addEventListener('click', (event) => {
    event.preventDefault()
    event.stopPropagation()
    const label = (allBtn.textContent || '').trim().toLowerCase()
    const shouldOpen = label.startsWith('expand') || !anyOpen()
    folds().forEach((d) => { d.open = shouldOpen })
    syncAll()
  })

  function openForHash(hash: string) {
    const id = decodeURIComponent((hash || '').replace(/^#/, ''))
    if (!id || id === 'contact') return
    const el = document.getElementById(id)
    if (!el) return
    if (el instanceof HTMLDetailsElement) el.open = true
    const parent = el.closest('details')
    if (parent instanceof HTMLDetailsElement) parent.open = true
    // Nested wallet network: also open the wallets section
    const outer = parent?.parentElement?.closest('details')
    if (outer instanceof HTMLDetailsElement) outer.open = true
  }

  function applyDefaults() {
    // Desktop starts open, mobile starts collapsed. Later viewport changes
    // must not reopen (or close) sections the reader already toggled.
    if (!mq.matches) folds().forEach((d) => { d.open = true })
    else folds().forEach((d) => { d.open = false })
    openForHash(location.hash)
  }

  applyDefaults()
  syncAll()
  mq.addEventListener('change', () => { openForHash(location.hash); syncAll() })
  window.addEventListener('hashchange', () => { openForHash(location.hash); syncAll() })
  document.querySelectorAll<HTMLAnchorElement>('.lk-toc a, a.lk-head').forEach((a) => {
    a.addEventListener('click', () => {
      const href = a.getAttribute('href') || ''
      const hash = href.includes('#') ? `#${href.split('#').pop()}` : href
      if (hash.startsWith('#')) openForHash(hash)
      syncAll()
    })
  })
</script>
