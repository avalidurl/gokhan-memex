---
import BaseLayout from '@/layouts/BaseLayout.astro'

const subscribeAction = 'https://api.gokhan.vc/newsletter/subscribe'
---

<BaseLayout
  title="Newsletter"
  description="Subscribe to the Numetal / Ishtar / CURB / studio estate newsletter. One list, signal only."
  hideFooterSubscribe
>
  <div class="nl mx-auto max-w-3xl px-5 py-10 lg:py-14">
    <div class="kicker-pill mb-3">Doc MX-090 · Open list</div>
    <h1 class="mb-3">Newsletter</h1>
    <p class="mb-8 max-w-2xl font-serif text-[19px] text-muted-foreground">
      One estate list across Numetal / Ishtar / CURB / the studio. Signal only. Double opt-in.
    </p>

    <form class="nl-form" method="POST" action={subscribeAction}>
      <input type="hidden" name="site" value="memex" />
      <label class="nl-label" for="email">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        required
        placeholder="you@example.com"
        autocomplete="email"
        class="nl-input"
      />
      <div class="cf-turnstile" data-sitekey="0x4AAAAAAEG8CWZN8yq8G3kt" data-theme="auto" data-size="flexible"></div>
      <button type="submit" class="nl-btn" title="Subscribe via api.gokhan.vc (site=memex)">Subscribe</button>
    </form>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>

    <div class="nl-note mt-8">
      <p class="m-0 text-sm text-muted-foreground">
        Latest: <a
          href="/journal/complementary-substitutions/"
          class="doc-link"
          data-latest-post>Complementary Substitutions</a>
        · <a href="/journal/" class="doc-link">All posts</a>.
        Public contact: <a href="mailto:contact@gokhan.vc" class="doc-link">contact@gokhan.vc</a>.
      </p>

      <p class="mt-2 mb-0 text-sm text-muted-foreground">
        Feeds: <a href="/rss.xml" class="doc-link">this site</a>
        · <a href="https://api.gokhan.vc/feed.xml" class="doc-link">everything</a>.
      </p>
    </div>
    <script src="/newsletter-latest.js" defer is:inline></script>
  </div>
</BaseLayout>

<style>
  .nl {
    color: var(--ink);
  }

  .nl-form {
    max-width: 540px;
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-left: 5px solid var(--acc);
    border-radius: 18px;
    padding: 24px 26px;
  }

  .nl-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--acc);
    margin: 0 0 0.5rem;
  }

  .nl-form :global(.cf-turnstile),
  .nl-form :global(.cf-turnstile iframe) {
    display: block;
    width: 100%;
    max-width: 100%;
    margin-bottom: 0.9rem;
  }

  .nl-input {
    width: 100%;
    padding: 11px 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 15px;
    margin-bottom: 0.9rem;
  }

  .nl-input:focus-visible {
    outline: 2px solid var(--acc);
    outline-offset: 1px;
    border-color: var(--acc);
  }

  .nl-btn {
    padding: 10px 24px;
    border: 1px solid var(--btn-bg);
    border-radius: 999px;
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }

  .nl-btn:hover,
  .nl-btn:focus-visible {
    background: var(--btn-hover);
    border-color: var(--btn-hover);
  }

  .nl-note {
    max-width: 540px;
    background: var(--soft);
    border-radius: 14px;
    padding: 14px 18px;
  }

  .nl .doc-link {
    color: var(--acc);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .nl .doc-link:hover {
    color: var(--acc-dark);
  }
</style>
