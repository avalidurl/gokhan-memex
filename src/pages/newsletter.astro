---
import BaseLayout from '@/layouts/BaseLayout.astro'

const subscribeAction = 'https://api.gokhan.vc/newsletter/subscribe'
---

<BaseLayout
  title="Newsletter"
  description="Subscribe to the Numetal / Ishtar / CURB / studio estate newsletter. One list, signal only."
  hideFooterSubscribe
>
  <div class="nl mx-auto max-w-2xl px-6 py-12 lg:py-16">
    <p class="doc-eyebrow mb-3">Doc MX-090 · Open list</p>
    <h1 class="mb-3">Newsletter</h1>
    <p class="mb-8 max-w-2xl text-lg text-foreground/90">
      One estate list across Numetal / Ishtar / CURB / the studio. Signal only. Double opt-in.
    </p>

    <form class="nl-form" method="POST" action={subscribeAction}>
      <input type="hidden" name="site" value="memex" />
      <label class="nl-label" for="email">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        required
        placeholder="you@example.com"
        autocomplete="email"
        class="nl-input"
      />
      <div class="cf-turnstile" data-sitekey="0x4AAAAAAEG8CWZN8yq8G3kt" data-theme="auto" data-size="flexible"></div>
      <button type="submit" class="nl-btn" title="Subscribe via api.gokhan.vc (site=memex)">Subscribe</button>
    </form>
      <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>

    <p class="nl-more mt-8 text-sm text-muted-foreground">
      Latest: <a
        href="/journal/complementary-substitutions/"
        class="doc-link"
        data-latest-post>Complementary Substitutions</a>
      · <a href="/journal/" class="doc-link">All posts</a>.
      Public contact: <a href="mailto:contact@gokhan.vc" class="doc-link">contact@gokhan.vc</a>.
    </p>

    <p class="nl-more mt-3 text-sm text-muted-foreground">
      Feeds: <a href="/rss.xml" class="doc-link">this site</a>
      · <a href="https://api.gokhan.vc/feed.xml" class="doc-link">everything</a>.
    </p>
    <script src="/newsletter-latest.js" defer is:inline></script>
  </div>
</BaseLayout>

<style>
  .nl {
    color: var(--ink);
    /* R2 — running prose. The R4 identifiers inside (eyebrows, doc numbers,
       line numbers, labels) re-assert the data face themselves. */
    font-family: var(--font-text);
  }

  :global(.dark) .nl {
    color: hsl(var(--foreground));
  }

  .nl .doc-eyebrow {
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  :global(.dark) .nl .doc-eyebrow {
    color: hsl(var(--muted-foreground));
  }

  .nl-form {
    max-width: 520px;
    border: 2px solid var(--ink);
    padding: 1.25rem;
  }

  /* R4 — a field label is a control identifier. */
  .nl-label {
    display: block;
    font-family: var(--font-data);
    font-size: 12.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dim);
    margin: 0 0 0.5rem;
  }

  :global(.dark) .nl-label {
    color: hsl(var(--muted-foreground));
  }

  .nl-form :global(.cf-turnstile),
  .nl-form :global(.cf-turnstile iframe) {
    display: block;
    width: 100%;
    max-width: 100%;
    margin-bottom: 0.9rem;
  }

  .nl-input {
    width: 100%;
    padding: 10px 12px;
    border: 2px solid var(--ink);
    background: transparent;
    color: inherit;
    font-family: var(--font-data);
    font-size: 15px;
    letter-spacing: 0.06em;
    margin-bottom: 0.9rem;
  }

  .nl-input:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  .nl-btn {
    padding: 12px 26px;
    border: 2px solid var(--ink);
    background: transparent;
    color: var(--ink);
    font-family: var(--font-data);
    font-size: 15px;
    letter-spacing: 0.06em;
    font-weight: 700;
    cursor: pointer;
  }

  .nl-btn:hover,
  .nl-btn:focus-visible {
    background: var(--ink);
    color: var(--paper);
  }

  .nl .doc-link {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }

  :global(.dark) .nl .doc-link {
    color: hsl(var(--primary));
  }
</style>
