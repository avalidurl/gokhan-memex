---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHead from '@/components/PageHead.astro'
import Tags from '@/components/Tags.astro'
import { catalog, catalogByCategory } from '@/data/estate'

// One listing for every project and product, in the site's established order,
// grouped by category. Categories follow the position of their first item.
const groups = catalogByCategory()
---

<BaseLayout
  title="Projects & Products"
  description="Every project and product, grouped by category: art, fiction and publishing, dating and matching, agent commerce, studios, markets and research, and learning tools. Each has its own page, tagged."
>
  <div class="es">
    <PageHead crumbs={[{ label: 'Index', href: '/' }, { label: 'Projects & Products' }]} title="Projects & Products" count={catalog.length} lead="Every project and product has its own page here, with its site, docs and data. Tags open a shared page with the projects, posts and APIs that carry them.">
      <p class="lead">Grouped by category. Every tag is on <a href="/archive/tags/">Tags</a>.</p>
    </PageHead>
    <section class="cx" aria-label="Jump to">
      <div class="cx-h"><b>Jump to</b><span>categories</span></div>
      <div class="cx-b"><span class="tags">{groups.map((g) => <a class="tg" href={`#${g.id}`}>{g.name}</a>)}</span></div>
    </section>

    {groups.map((g) => (
      <details class="cx fold" aria-label={g.name} id={g.id} open>
        <summary class="cx-h"><b>{g.name}</b><span>{g.note}</span><em>{String(g.items.length).padStart(2, '0')}</em></summary>
        {g.items.map((p) => (
          <div class="cx-r">
            <span>{p.href.startsWith('/journal/') ? 'journal' : <a href={p.href}>gokhanturhan.com{p.href.replace(/\/$/, '')}/</a>}{p.former && <><br /><i>formerly {p.former}</i></>}</span>
            <span>
              <a class="nm" href={p.href}>{p.name}</a> — {p.line}
              {p.subs.length > 0 && (
                <><br /><i>also: {p.subs.map((c, j) => (<>{j > 0 && ' · '}<a href={c.href}>{c.name}</a></>))}</i></>
              )}
              {p.tags.length > 0 && <><br /><Tags tags={p.tags} /></>}
            </span>
          </div>
        ))}
      </details>
    ))}
  </div>
</BaseLayout>
