---
import { type CollectionEntry, getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'

export async function getStaticPaths() {
  const projects = await getCollection('projects')
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: project,
  }))
}

type Props = CollectionEntry<'projects'>

const project = Astro.props
const { Content } = await project.render()

const publishDate = new Date(project.data.publishDate)
const formattedDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long'
})
---

<BaseLayout 
  title={project.data.title} 
  description={project.data.description}
>
  <article class="mx-auto max-w-3xl px-5 py-10 lg:py-14">
    <header class="mb-10 pb-8 border-b border-border">
      <div class="kicker-pill mb-3">Project File · {formattedDate}</div>
      <h1 class="mb-3">{project.data.title}</h1>
      <p class="font-serif text-[19px] text-muted-foreground mb-5">
        {project.data.description}
      </p>
      
      {(project.data.projectUrl || project.data.githubUrl) && (
        <div class="flex flex-wrap gap-3">
          {project.data.projectUrl && (
            <a 
              href={project.data.projectUrl}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center rounded-full border border-primary bg-primary px-5 py-2 font-sans text-[14px] font-semibold text-primary-foreground no-underline hover:opacity-90 transition-opacity"
            >
              View project ↗
            </a>
          )}
          {project.data.githubUrl && (
            <a 
              href={project.data.githubUrl}
              target="_blank"
              rel="noopener"
              class="tile"
            >
              Source ↗
            </a>
          )}
        </div>
      )}
    </header>

    <div class="rounded-2xl border border-border bg-card p-6 sm:p-9">
      <div class="prose dark:prose-invert max-w-none">
        <Content />
      </div>
    </div>

    <footer class="mt-10 pt-6 border-t border-border">
      <a 
        href="/projects"
        class="tile"
      >
        ← Back to projects
      </a>
    </footer>
  </article>
</BaseLayout>
