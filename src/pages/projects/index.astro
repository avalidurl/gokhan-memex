---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { registerProjects as projects, projectIndex } from '@/data/projects'
---

<BaseLayout
  title="Projects"
  description="Every project, filed & live — one person, a fleet of agents. Agent-native venues, rails, benchmarks, and dashboards: Ishtar, CURB, HeartBench, CLINAMEN/$UBU, Plaintext, Reclaim, and more."
>
  <div class="proj-wrap">
    <header class="pintro">
      <div class="kicker-pill mb-3">Project register · live products &amp; builds</div>
      <h1 class="h">Projects</h1>
      <p class="lead">
        Everything filed &amp; live — one person, a fleet of agents. The index below jumps
        straight to the flagship products; the full register lists every build, from the
        agent-native venues and rails to the dashboards and the local project files.
      </p>
    </header>

    <div class="section-rule"></div>
    <section class="pindex-section" aria-label="Project index">
      <h2 class="idxh">Project index</h2>
      <nav class="pindex">
        {projectIndex.map((it) => (
          <a
            class="pirow"
            href={it.href}
            target={it.external ? '_blank' : undefined}
            rel={it.external ? 'noopener' : undefined}
          >
            <span class="pi-no">{it.no}</span>
            <span class="pi-name">{it.name}</span>
            <span class="pi-note">{it.note}</span>
            <span class="pi-arrow" aria-hidden="true">{it.external ? '↗' : '→'}</span>
          </a>
        ))}
      </nav>
    </section>

    <div class="section-rule"></div>
    <section class="register" id="register">
      <h2 class="idxh">Project register — filed &amp; live</h2>
      <div class="reg-grid">
        {projects.map((pr, i) => (
          <a
            class="reg-card"
            href={pr.href}
            target={pr.href.startsWith('http') ? '_blank' : undefined}
            rel={pr.href.startsWith('http') ? 'noopener' : undefined}
          >
            <div class="k">{String(i + 1).padStart(2, '0')} · {pr.where}</div>
            <div class="v">{pr.name}<small>{pr.desc}</small></div>
          </a>
        ))}
      </div>
    </section>
  </div>

  <style>
    .proj-wrap {
      max-width: 1100px;
      margin: 0 auto;
      padding: 32px 20px 64px;
      color: var(--ink);
    }

    .pintro {
      max-width: 68ch;
    }

    .h {
      margin: 0 0 14px;
    }

    .lead {
      font-family: var(--font-serif);
      font-size: 19px;
      line-height: 1.6;
      margin: 0;
      color: var(--lead-ink);
    }

    .section-rule {
      height: 0;
      margin: 38px 0;
      border-top: 1px solid var(--line);
    }

    .idxh {
      font-family: var(--font-serif);
      font-size: 26px;
      font-weight: 700;
      margin: 0 0 14px;
      color: var(--ink);
    }

    .pindex-section { max-width: 100%; }
    .pindex {
      background: var(--card-bg);
      border: 1px solid var(--line);
      border-radius: 18px;
      overflow: hidden;
    }

    .pirow {
      display: grid;
      grid-template-columns: 3rem minmax(9rem, max-content) 1fr 1.6rem;
      gap: 16px;
      align-items: baseline;
      padding: 13px 20px;
      border-bottom: 1px solid var(--line);
      color: var(--ink);
      text-decoration: none;
      transition: background 0.15s;
    }

    .pirow:last-child { border-bottom: 0; }
    .pirow:hover { background: var(--soft-hover); }
    .pirow:hover .pi-name { color: var(--acc); }

    .pi-no {
      font-family: var(--font-sans);
      font-size: 12.5px;
      font-weight: 700;
      color: var(--acc);
      font-variant-numeric: tabular-nums;
    }

    .pi-name {
      font-family: var(--font-serif);
      font-weight: 700;
      font-size: 17px;
      color: var(--ink);
    }

    .pi-note {
      font-family: var(--font-sans);
      font-size: 14.5px;
      color: var(--mut);
    }

    .pi-arrow {
      text-align: right;
      color: var(--acc);
      font-size: 15px;
    }

    .register { max-width: 100%; }
    .reg-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 16px;
    }

    .reg-card {
      background: var(--card-bg);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 18px 20px;
      display: block;
      color: var(--ink);
      text-decoration: none;
      transition: border-color 0.15s, box-shadow 0.15s;
    }

    .reg-card:hover {
      border-color: var(--acc);
      box-shadow: 0 8px 24px rgba(42, 26, 30, 0.06);
    }

    .reg-card:hover .v {
      color: var(--acc);
    }

    .reg-card .k {
      font-family: var(--font-sans);
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--acc);
      margin-bottom: 6px;
    }

    .reg-card .v {
      font-family: var(--font-serif);
      font-size: 20px;
      font-weight: 700;
      line-height: 1.25;
      color: var(--ink);
    }

    .reg-card .v small {
      display: block;
      margin-top: 6px;
      font-family: var(--font-sans);
      font-size: 14px;
      font-weight: 400;
      color: var(--mut);
      line-height: 1.48;
    }

    @media (max-width: 680px) {
      .proj-wrap { padding: 22px 16px 48px; }
      .reg-grid { grid-template-columns: 1fr; }
      .pirow { grid-template-columns: 2.4rem 1fr auto; gap: 12px; padding: 12px 16px; }
      .pi-note { display: none; }
    }
  </style>
</BaseLayout>
