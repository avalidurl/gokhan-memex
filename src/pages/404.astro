---
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist."
>
  <div class="mx-auto max-w-2xl px-5 py-20 lg:py-28">
    <div class="rounded-3xl border border-border bg-card p-10 sm:p-14 text-center shadow-sm">
      <div class="kicker-pill mb-4">Error 404</div>
      <p class="font-serif text-7xl font-bold text-primary mb-4">404</p>
      <h1 class="mb-3">Page not found</h1>
      <p class="font-serif text-[18px] text-muted-foreground mb-8 mx-auto max-w-md">
        The page you're looking for doesn't exist or has been moved.
      </p>
      
      <div class="space-y-5">
        <a 
          href="/"
          class="inline-flex items-center rounded-full border border-primary bg-primary px-6 py-2.5 font-sans text-[14px] font-semibold text-primary-foreground no-underline hover:opacity-90 transition-opacity"
        >
          ← Back to home
        </a>
        
        <div class="flex flex-wrap justify-center gap-5 pt-2 text-sm">
          <a href="/journal" class="text-muted-foreground hover:text-primary underline underline-offset-2">
            Journal
          </a>
          <a href="/archive" class="text-muted-foreground hover:text-primary underline underline-offset-2">
            Archive
          </a>
          <a href="/lists" class="text-muted-foreground hover:text-primary underline underline-offset-2">
            Lists
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
