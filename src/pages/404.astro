---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHead from '@/components/PageHead.astro'
---

<BaseLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist."
  robots="noindex, follow"
>
  <div class="es">
    <PageHead crumbs={[{ label: 'Index', href: '/' }, { label: '404' }]} title="Page not found" lead="The page you're looking for doesn't exist or has been moved." />
    <section class="cx" aria-label="Where to go">
      <div class="cx-h"><b>Try</b><span>the main sections</span></div>
      <div class="cx-r"><span><a href="/">Index</a></span><span>Home</span></div>
      <div class="cx-r"><span><a href="/journal/">Journal</a></span><span>Every post, filed by year</span></div>
      <div class="cx-r"><span><a href="/products/">Products</a></span><span>Current, studio and drafts</span></div>
      <div class="cx-r"><span><a href="/cv/">CV</a></span><span>The full record</span></div>
      <div class="cx-r"><span><a href="/archive/">Archive</a></span><span>Years, categories and tags</span></div>
      <div class="cx-r"><span><a href="/about/why-addresses-moved/">Why addresses moved</a></span><span>Old links and where they went</span></div>
    </section>
  </div>
</BaseLayout>
