---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PostTitle from '@/components/PostTitle.astro'
import PortfolioBoard from '@/components/PortfolioBoard.astro'
import { registerProjects as projects, projectIndex } from '@/data/projects'
import { getCollection } from 'astro:content'

const essays = (await getCollection('blog'))
  .filter(
    (p) =>
      !p.data.draft &&
      p.data.category.toLowerCase() !== 'interviews' &&
      p.data.category !== 'Links'
  )
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 6)

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
---

<BaseLayout
  title="Gökhan Turhan"
  description="Full-stack builder — one person, a fleet of agents. Agent-native venues, rails, and benchmarks live in production on x402: Ishtar, CURB, HeartBench. Journal, CV, publishing."
>
  <div class="home-wrap">
    <!-- Hero — editorial split with subtle static rose orb accent -->
    <header class="hero-card">
      <div class="hero-copy">
        <div class="kicker-pill">Full-stack builder · fintech × AI × agent-native markets</div>
        <h1 class="hero-title">Gökhan Turhan<span class="rose-dot" aria-hidden="true">.</span></h1>
        <p class="hero-stamp">Live in production — taking real machine payments</p>
        <div class="hero-actions">
          <a class="btn-pill primary" href="/journal/">Read the journal →</a>
          <a class="btn-pill" href="/projects/">Project files</a>
          <a class="btn-pill" href="/cv/">CV</a>
        </div>
        <div class="hero-contacts">
          <span>Contact:</span>
          <a href="https://x.com/goekhan" target="_blank" rel="noopener">X</a>
          <span aria-hidden="true">·</span>
          <a href="https://t.me/goekhanturhan" target="_blank" rel="noopener">Telegram</a>
          <span aria-hidden="true">·</span>
          <a href="https://linkedin.com/in/goekhanturhan" target="_blank" rel="noopener">LinkedIn</a>
          <span aria-hidden="true">·</span>
          <a href="mailto:contact@gokhan.vc">Email</a>
        </div>
      </div>

      <div class="orb-panel" aria-hidden="true">
        <div class="orb-stage">
          <div class="rose-orb"></div>
        </div>
      </div>
    </header>

    <!-- Lede & Project Index -->
    <div class="lede-row">
      <details class="lede-card" open>
        <summary class="lede-summary">
          <span class="lede-summary-t">One person, a fleet of agents</span>
          <span class="lede-toggle" aria-hidden="true"></span>
        </summary>
        <div class="lede-body">
          <p class="lead">
            I'm a <b>full-stack builder</b> — one person, a fleet of agents, everything
            shipped end to end. I design the product, write the code, wire the payments,
            run the security program, and operate what ships: Ishtar, a venue where agents
            court and humans meet; CURB, a rail where agents trade inference for USDC;
            HeartBench, HeartPrefs, and the pipes that meter the x402 economy. All of it is
            <b>live, in production, taking real machine payments</b>. Fintech is still the
            substrate — custody, tokenization, market structure — I've just stopped
            explaining it in decks and started clearing it in prod. I also make conceptual
            art; it keeps me honest about naming and compression.
          </p>
          <p class="p-sub">
            What I want more of is <b>acceleration you can weigh</b>: gigawatts, foundries,
            compute, mass to orbit. Hard tech, deep tech, manufacturing, spaceflight —
            capacity, not adjectives; the base the big problems don't get solved without.
            Governance should compete for that base like any other vendor: jurisdictions
            running different rules, rewarded on outcomes, not paperwork theater. My corner
            of it is the market plumbing — software that buys, sells, and settles with
            other software, fast enough to keep up with the factories we still have to
            build.
          </p>
        </div>
      </details>

      <section class="pindex-section" aria-label="Project index">
        <div class="idxh">Project index</div>
        <nav class="pindex">
          {projectIndex.map((it) => (
            <a
              class="pirow"
              href={it.href}
              target={it.external ? '_blank' : undefined}
              rel={it.external ? 'noopener' : undefined}
            >
              <span class="pi-no">{it.no}</span>
              <span class="pi-text">
                <span class="pi-name">{it.name}</span>
                <span class="pi-note">{it.note}</span>
              </span>
              <span class="pi-arrow" aria-hidden="true">{it.external ? '↗' : '→'}</span>
            </a>
          ))}
        </nav>
      </section>
    </div>

    <div class="section-rule"></div>
    <PortfolioBoard />

    <div class="section-rule"></div>
    <section class="register">
      <div class="idxh">Project register — filed &amp; live</div>
      <div class="reg-grid">
        {projects.map((pr, i) => (
          <a
            class="reg-card"
            href={pr.href}
            target={pr.href.startsWith('http') ? '_blank' : undefined}
            rel={pr.href.startsWith('http') ? 'noopener' : undefined}
          >
            <div class="k">{String(i + 1).padStart(2, '0')} · {pr.where}</div>
            <div class="v">{pr.name}<small>{pr.desc}</small></div>
          </a>
        ))}
      </div>
      <a class="more-link" href="/projects/">All project files →</a>
    </section>

    {essays.length > 0 && (
      <>
        <div class="section-rule"></div>
        <section class="recent">
          <div class="idxh">Recent from the journal</div>
          <div class="rlist-card">
            <ul class="rlist">
              {essays.map((post) => (
                <li>
                  <a href={`/journal/${post.slug}/`}>
                    <PostTitle title={post.data.title} class="rt" />
                    <span class="rd">{fmt(post.data.publishDate)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <a class="more-link" href="/journal/">All essays →</a>
        </section>
      </>
    )}
  </div>

  <style>
    .home-wrap {
      max-width: 1100px;
      margin: 0 auto;
      padding: 34px 20px 64px;
      color: var(--ink);
    }

    /* Hero section matching Turkish Art Blob layout */
    .hero-card {
      display: grid;
      grid-template-columns: 1.25fr 0.75fr;
      gap: 32px;
      align-items: center;
      padding-bottom: 36px;
      border-bottom: 1px solid var(--line);
    }

    .hero-title {
      font-family: var(--font-serif);
      font-size: clamp(44px, 6.5vw, 66px);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.06;
      margin: 14px 0 12px;
      color: var(--ink);
    }

    .rose-dot {
      color: var(--acc);
    }

    .hero-stamp {
      font-family: var(--font-serif);
      font-size: 19px;
      line-height: 1.52;
      color: var(--lead-ink);
      margin: 0 0 20px;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
      margin-bottom: 18px;
    }

    .btn-pill {
      display: inline-block;
      border: 1px solid var(--acc);
      color: var(--acc);
      background: var(--card-bg);
      border-radius: 999px;
      padding: 9px 18px;
      font-family: var(--font-sans);
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      transition: background 0.15s, color 0.15s, border-color 0.15s;
    }

    .btn-pill:hover {
      background: var(--acc);
      color: #ffffff;
    }

    .btn-pill.primary {
      background: var(--acc);
      color: #ffffff;
    }

    .btn-pill.primary:hover {
      background: var(--acc-dark);
      border-color: var(--acc-dark);
      color: #ffffff;
    }

    .hero-contacts {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px 8px;
      font-family: var(--font-sans);
      font-size: 14px;
      color: var(--mut);
    }

    .hero-contacts a {
      color: var(--acc);
      text-decoration: underline;
      text-underline-offset: 3px;
      font-weight: 500;
    }

    .hero-contacts a:hover {
      color: var(--acc-dark);
    }

    /* Static subtle rose orb accent matching Turkish Art Blob fallback orb */
    .orb-panel {
      display: flex;
      justify-content: center;
    }

    .orb-stage {
      width: 100%;
      max-width: 340px;
      height: 260px;
      border-radius: 24px;
      background: radial-gradient(circle at 50% 44%, var(--card-bg) 0%, var(--soft) 62%, var(--line) 100%);
      border: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .rose-orb {
      width: 156px;
      height: 146px;
      border-radius: 54% 46% 49% 51% / 47% 55% 45% 53%;
      background: radial-gradient(circle at 36% 32%, #ffe9e6 0%, #ef9ba0 38%, #cf5b6e 76%, #8f2d3e 100%);
      box-shadow: inset -14px -18px 30px rgba(102, 22, 38, 0.34),
                  inset 12px 12px 22px rgba(255, 255, 255, 0.62),
                  0 22px 44px rgba(168, 70, 86, 0.24);
    }

    /* Lede row */
    .lede-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 360px;
      gap: 28px;
      align-items: start;
      margin-top: 34px;
    }

    .lede-card {
      background: var(--card-bg);
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 22px 26px;
      margin: 0;
    }

    .lede-summary {
      list-style: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      font-family: var(--font-serif);
      font-size: 22px;
      font-weight: 700;
      color: var(--ink);
    }

    .lede-summary::-webkit-details-marker { display: none; }
    .lede-summary:hover .lede-summary-t { color: var(--acc); }

    .lede-toggle {
      font-family: var(--font-sans);
      font-size: 12px;
      font-weight: 600;
      color: var(--acc);
      background: var(--soft);
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 3px 11px;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .lede-toggle::after { content: 'Collapse'; }
    .lede-card:not([open]) .lede-toggle::after { content: 'Expand'; }

    .lede-body {
      padding-top: 16px;
      margin-top: 14px;
      border-top: 1px solid var(--line);
    }

    .lead {
      font-family: var(--font-serif);
      font-size: 18px;
      line-height: 1.66;
      margin: 0;
      color: var(--ink);
      max-width: 65ch;
    }

    .lead b, .p-sub b { font-weight: 700; }

    .p-sub {
      margin: 18px 0 0;
      font-size: 16px;
      line-height: 1.62;
      color: var(--lead-ink);
      border-left: 4px solid var(--acc);
      background: var(--soft);
      border-radius: 0 12px 12px 0;
      padding: 13px 16px;
      max-width: 65ch;
    }

    .section-rule {
      height: 0;
      margin: 42px 0;
      border-top: 1px solid var(--line);
    }

    .idxh {
      font-family: var(--font-serif);
      font-size: 26px;
      font-weight: 700;
      letter-spacing: -0.01em;
      color: var(--ink);
      margin-bottom: 14px;
    }

    /* Project index card */
    .pindex-section { max-width: 100%; min-width: 0; }
    .pindex {
      background: var(--card-bg);
      border: 1px solid var(--line);
      border-radius: 18px;
      overflow: hidden;
    }

    .pirow {
      display: grid;
      grid-template-columns: 2.1rem 1fr 1.2rem;
      gap: 10px;
      align-items: baseline;
      padding: 11px 16px;
      border-bottom: 1px solid var(--line);
      text-decoration: none;
      color: var(--ink);
      transition: background 0.15s;
    }

    .pirow:last-child { border-bottom: 0; }
    .pirow:hover { background: var(--soft-hover); }
    .pirow:hover .pi-name { color: var(--acc); }

    .pi-no {
      font-family: var(--font-sans);
      font-size: 12px;
      font-weight: 700;
      color: var(--acc);
      font-variant-numeric: tabular-nums;
    }

    .pi-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .pi-name { font-family: var(--font-sans); font-weight: 700; font-size: 14.5px; color: var(--ink); }
    .pi-note { font-family: var(--font-sans); font-size: 12.5px; color: var(--mut); line-height: 1.38; }
    .pi-arrow { text-align: right; color: var(--mut); font-size: 13px; }

    /* Project register cards */
    .register { max-width: 100%; }
    .reg-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 16px;
    }

    .reg-card {
      background: var(--card-bg);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 18px 20px;
      display: block;
      text-decoration: none;
      color: var(--ink);
      transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
    }

    .reg-card:hover {
      border-color: var(--acc);
      box-shadow: 0 8px 24px rgba(42, 26, 30, 0.06);
    }

    .reg-card:hover .v {
      color: var(--acc);
    }

    .reg-card .k {
      font-family: var(--font-sans);
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--acc);
      margin-bottom: 6px;
    }

    .reg-card .v {
      font-family: var(--font-serif);
      font-size: 20px;
      font-weight: 700;
      line-height: 1.25;
      color: var(--ink);
    }

    .reg-card .v small {
      display: block;
      margin-top: 6px;
      font-family: var(--font-sans);
      font-size: 14px;
      font-weight: 400;
      color: var(--mut);
      line-height: 1.48;
    }

    .more-link {
      display: inline-block;
      margin-top: 18px;
      font-family: var(--font-sans);
      font-size: 14px;
      font-weight: 600;
      color: var(--acc);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .more-link:hover {
      color: var(--acc-dark);
    }

    /* Recent journal */
    .recent { max-width: 780px; }
    .rlist-card {
      background: var(--card-bg);
      border: 1px solid var(--line);
      border-radius: 18px;
      overflow: hidden;
    }

    .recent .rlist { list-style: none; padding: 0; margin: 0; }
    .recent li + li { border-top: 1px solid var(--line); }

    .recent li a {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 16px;
      padding: 14px 20px;
      text-decoration: none;
      color: var(--ink);
      transition: background 0.15s;
    }

    .recent li a:hover { background: var(--soft-hover); }
    .recent li a:hover .rt { color: var(--acc); }

    .recent .rt {
      font-family: var(--font-serif);
      font-size: 17.5px;
      font-weight: 600;
      line-height: 1.38;
    }

    .recent .rd {
      font-family: var(--font-sans);
      font-size: 13px;
      color: var(--mut);
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }

    @media (max-width: 920px) {
      .hero-card {
        grid-template-columns: 1fr;
        gap: 24px;
      }
      .orb-stage {
        max-width: 100%;
        height: 200px;
      }
      .lede-row {
        grid-template-columns: 1fr;
        gap: 22px;
      }
    }

    @media (max-width: 640px) {
      .home-wrap {
        padding: 24px 16px 48px;
      }
      .lede-card {
        padding: 18px 20px;
      }
      .reg-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
