---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { API_INDEX } from '@/data/estate'

type Item = { label: string; href?: string; note?: string }
const quads: { key: string; title: string; mode: string; items: Item[] }[] = [
  {
    key: 'tutorials', title: 'Tutorials', mode: 'learning · do this with me',
    items: [
      { label: 'Read the site in ten minutes', href: '/', note: 'Index, then Journal, then Products' },
      { label: 'Your first agent call', href: `${API_INDEX}/`, note: 'start from the API index' },
    ],
  },
  {
    key: 'how-to', title: 'How-to guides', mode: 'tasks · help me do this',
    items: [
      { label: 'Find an old project', href: '/products/#archived' },
      { label: 'Unsubscribe from the newsletter', href: '/newsletter/' },
      { label: 'Cite or link a page', note: 'every page has a stable URL and a document number' },
      { label: 'Contact, raise or press', href: '/#raises' },
    ],
  },
  {
    key: 'explanation', title: 'Explanation', mode: 'understanding · tell me about it',
    items: [
      { label: 'What this site is', note: 'one person’s register: writing, products, publishing and CV' },
      { label: 'How the products are organised', href: '/products/', note: 'current, archived, drafts, tools' },
      { label: 'Design notes', note: 'register sheet, document numbers, boxed containers' },
    ],
  },
  {
    key: 'reference', title: 'Reference', mode: 'information · give me the facts',
    items: [
      { label: 'Products', href: '/products/' },
      { label: 'Product drafts', href: '/product-drafts/' },
      { label: 'APIs', href: `${API_INDEX}/` },
      { label: 'Tools', href: '/tools/' },
      { label: 'Feeds and files', href: '/rss.xml', note: 'RSS, sitemap, llms.txt' },
      { label: 'Colophon', note: 'Astro on Cloudflare Pages' },
    ],
  },
]
---

<BaseLayout title="About" description="How to find your way around this site: tutorials, how-to guides, explanation and reference.">
  <div class="es">
    <div class="meta">About · four ways in</div>
    <div class="dither"></div>
    <div class="intro">
      <h1>About</h1>
      <p class="lead">Four ways in, depending on what you need right now.</p>
    </div>
    <div class="quad">
      {quads.map((q) => (
        <section class="cx" id={q.key} aria-label={q.title}>
          <div class="cx-h"><b>{q.title}</b><span>{q.mode}</span></div>
          {q.items.map((it) => (
            <div class="cx-r" style="grid-template-columns:1fr">
              <span style="font-family:inherit;font-size:inherit">
                {it.href ? <a href={it.href}>{it.label}</a> : it.label}
                {it.note && <><br /><i>{it.note}</i></>}
              </span>
            </div>
          ))}
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
