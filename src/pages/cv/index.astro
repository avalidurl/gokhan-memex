---
import BaseLayout from '@/layouts/BaseLayout.astro'
import CvSheet from '@/components/CvSheet.astro'
import {
  contact,
  cvJsonLd,
  cvMeta,
  education,
  experience,
  languages,
  profile,
  publications,
  skillGroups,
} from '@/data/cv'

const site = Astro.site ?? new URL('https://gokhanturhan.com')
const jsonLd = cvJsonLd(site)
const description =
  `${cvMeta.name} — ${cvMeta.title}. ${cvMeta.tagline.slice(0, 155)}…`
---

<BaseLayout
  title={`${cvMeta.name} — CV`}
  description={description}
  robots="index, follow, max-image-preview:large, max-snippet:-1"
  breadcrumbOverride={{ items: [], currentPage: 'CV' }}
>
  <div class="cv-document cv-screen mx-auto max-w-3xl px-5 py-10 lg:py-14">
    <article itemscope itemtype="https://schema.org/Person">
      <meta itemprop="name" content={cvMeta.name} />
      <meta itemprop="email" content="contact@gokhan.vc" />

      <header class="cv-hero mb-10">
        <div class="kicker-pill mb-3">Curriculum vitae</div>
        <h1 class="mb-2" itemprop="name">
          {cvMeta.name}
        </h1>
        <p class="mb-2 font-serif text-[20px] text-primary font-semibold" itemprop="jobTitle">{cvMeta.title}</p>
        <p class="mb-5 max-w-2xl font-serif text-[17.5px] leading-relaxed text-foreground/90" itemprop="description">
          {cvMeta.tagline}
        </p>

        <div class="flex flex-wrap items-center gap-2.5 no-print mb-4">
          <a href={cvMeta.pdfUrl} class="cv-btn primary" download={cvMeta.pdfFileName}>
            Download PDF ↓
          </a>
          <a href="/cv.json" class="cv-btn">JSON</a>
          <a href="/cv/plain.txt" class="cv-btn">Plain text</a>
          <a href="/cv/raw.html" class="cv-btn">Raw HTML</a>
        </div>

        <p class="m-0 text-xs text-muted-foreground no-print">
          Updated {cvMeta.lastUpdated}
        </p>
      </header>

      <section class="cv-card" aria-labelledby="contact-heading">
        <h2 id="contact-heading" class="cv-sec-title">
          Contact
        </h2>
        <address class="not-italic text-foreground/90">
          <ul class="grid gap-2.5 sm:grid-cols-2 list-none p-0 m-0 text-[15px]">
            {contact.map((c) => (
              <li class="m-0">
                <span class="text-muted-foreground font-medium">{c.label}:</span>{' '}
                {c.url ? (
                  <a href={c.url} class="doc-link" rel="noopener noreferrer">
                    {c.value}
                  </a>
                ) : (
                  c.value
                )}
              </li>
            ))}
          </ul>
        </address>
      </section>

      <section class="cv-card" aria-labelledby="profile-heading">
        <h2 id="profile-heading" class="cv-sec-title">
          Profile
        </h2>
        <div class="space-y-4 font-serif text-[17.5px] leading-relaxed text-foreground/90">
          {profile.map((p) => (
            <p class="m-0">{p}</p>
          ))}
        </div>
      </section>

      <section class="cv-card" aria-labelledby="exp-heading">
        <h2 id="exp-heading" class="cv-sec-title">
          Experience
        </h2>
        <div class="space-y-7">
          {experience.map((job) => (
            <div class="cv-job">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="m-0 font-serif text-[19px] font-bold text-foreground">
                  {job.role}
                  <span class="font-normal text-muted-foreground"> — {job.org}</span>
                </h3>
                <span class="rounded-full border border-border bg-muted px-3 py-0.5 text-xs font-semibold text-primary">
                  <time datetime={job.start}>{job.start}</time>
                  {' – '}
                  <time datetime={job.end}>{job.end}</time>
                </span>
              </div>
              {job.location && (
                <p class="mt-1 mb-0 text-xs uppercase tracking-[0.06em] text-muted-foreground">{job.location}</p>
              )}
              <ul class="mt-3 list-disc space-y-1.5 pl-5 text-[15.5px] leading-relaxed text-foreground/90 mb-0">
                {job.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section class="cv-card" aria-labelledby="edu-heading">
        <h2 id="edu-heading" class="cv-sec-title">
          Education
        </h2>
        <ul class="space-y-5 list-none p-0 m-0">
          {education.map((ed) => (
            <li class="m-0 pb-4 border-b border-border last:border-b-0 last:pb-0">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <p class="m-0 font-serif text-[18px] font-bold text-foreground">
                  {ed.degree}
                  {'honors' in ed && ed.honors ? ` — ${ed.honors}` : ''}
                </p>
                <span class="text-xs font-semibold text-primary">{ed.years}</span>
              </div>
              <p class="m-0 mt-0.5 text-[15px] text-muted-foreground">{ed.school}</p>
              {'detail' in ed && ed.detail && <p class="mt-2 mb-0 text-[15px] text-foreground/90">{ed.detail}</p>}
              {'link' in ed && ed.link && (
                <p class="mt-1.5 mb-0 text-sm">
                  <a href={ed.link} class="doc-link" rel="noopener noreferrer">
                    {ed.linkLabel ?? 'Link'}
                  </a>
                </p>
              )}
            </li>
          ))}
        </ul>
      </section>

      <section class="cv-card" aria-labelledby="pub-heading">
        <h2 id="pub-heading" class="cv-sec-title">
          Publications &amp; exhibitions
        </h2>
        <ul class="list-disc space-y-2 pl-5 text-[15.5px] text-foreground/90 m-0">
          {publications.map((p) => (
            <li>{p}</li>
          ))}
        </ul>
      </section>

      <section class="cv-card" aria-labelledby="skills-heading">
        <h2 id="skills-heading" class="cv-sec-title">
          Skills &amp; tooling
        </h2>
        <div class="grid gap-5 md:grid-cols-2">
          {skillGroups.map((g) => (
            <div class="rounded-xl border border-border bg-background p-4">
              <h3 class="mt-0 mb-2 font-sans text-xs font-bold uppercase tracking-[0.07em] text-primary">
                {g.name}
              </h3>
              <ul class="space-y-1.5 text-[14px] leading-snug text-foreground/90 list-disc pl-4 m-0">
                {g.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section class="cv-card" aria-labelledby="lang-heading">
        <h2 id="lang-heading" class="cv-sec-title">
          Languages
        </h2>
        <div class="flex flex-wrap gap-3">
          {languages.map((l) => (
            <div class="rounded-full border border-border bg-muted px-4 py-1.5 text-sm">
              <strong class="text-foreground">{l.name}</strong>
              <span class="text-muted-foreground"> · {l.level}</span>
            </div>
          ))}
        </div>
      </section>
    </article>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </div>

  {/* Print-only: identical layout to the downloadable PDF (Cmd+P === Download PDF) */}
  <div class="cv-print" aria-hidden="true"><CvSheet /></div>
</BaseLayout>

<style>
  .cv-document {
    color: var(--ink);
  }

  .cv-hero {
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-left: 5px solid var(--acc);
    border-radius: 20px;
    padding: 26px 28px;
  }

  .cv-btn {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    color: var(--acc);
    padding: 7px 15px;
    font-family: var(--font-sans);
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }

  .cv-btn:hover {
    border-color: var(--acc);
    background: var(--soft-hover);
  }

  .cv-btn.primary {
    background: var(--btn-bg);
    border-color: var(--btn-bg);
    color: var(--btn-fg);
  }

  .cv-btn.primary:hover {
    background: var(--btn-hover);
    border-color: var(--btn-hover);
    color: var(--btn-fg);
  }

  .cv-card {
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 24px 26px;
    margin-bottom: 18px;
  }

  .cv-sec-title {
    margin: 0 0 16px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 700;
    color: var(--ink);
  }

  .cv-job + .cv-job {
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .cv-document .doc-link {
    color: var(--acc);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cv-document .doc-link:hover {
    color: var(--acc-dark);
  }

  @media (max-width: 640px) {
    .cv-hero,
    .cv-card {
      padding: 20px;
    }
  }
</style>

<style is:global>
  .cv-print { display: none; }

  @media print {
    @page { margin: 0; }
    html, body { margin: 0 !important; padding: 0 !important; background: #ffffff !important; }

    body > *:not(.relative):not(.cv-print) { display: none !important; }
    nav, header, footer, .cv-screen, .no-print { display: none !important; }

    .cv-print {
      display: block !important;
      position: fixed !important;
      inset: 0 !important;
      margin: 0 !important;
      background: #ffffff !important;
      z-index: 2147483647 !important;
    }
  }
</style>
