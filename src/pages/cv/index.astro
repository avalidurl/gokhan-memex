---
import BaseLayout from '@/layouts/BaseLayout.astro'
import CvSheet from '@/components/CvSheet.astro'
import PageHead from '@/components/PageHead.astro'
import {
  contact,
  cvJsonLd,
  cvMeta,
  education,
  experience,
  languages,
  profile,
  publications,
  skillGroups,
} from '@/data/cv'

const site = Astro.site ?? new URL('https://gokhanturhan.com')
const jsonLd = cvJsonLd(site)
const description =
  `${cvMeta.name} — ${cvMeta.title}. ${cvMeta.tagline.slice(0, 155)}…`
import { works, workByTitle } from '@/data/works'
const ORG_PAGE: Record<string, string> = { 'Gökhan Ventures': '/gokhan-vc/', Numetal: '/numetal/' }
const thesis = works.find((w) => w.kind === 'Academic' && /Media Laboratories/.test(w.title))
const pubRows: { label: string; href?: string; meta?: string }[] = [
  ...publications.map((p) => ({ label: p, href: workByTitle(p.replace(/^"|"$/g, ''))?.href })),
  ...works.filter((w) => !publications.some((p) => p.includes(w.title))).map((w) => ({ label: w.title, href: w.href, meta: `${w.kind}, ${w.year}` })),
]
---

<BaseLayout
  title={`${cvMeta.name} — CV`}
  description={description}
  robots="index, follow, max-image-preview:large, max-snippet:-1"
  breadcrumbOverride={{ items: [], currentPage: 'CV' }}
>
  <div class="es cv-screen">
    <div class="cv-person" itemscope itemtype="https://schema.org/Person">
      <meta itemprop="name" content={cvMeta.name} />
      <meta itemprop="email" content="contact@gokhan.vc" />
      <meta itemprop="jobTitle" content={cvMeta.title} />
      <meta itemprop="description" content={cvMeta.tagline} />

      <PageHead crumbs={[{ label: 'Index', href: '/' }, { label: 'Curriculum vitae' }]} title={cvMeta.name} lead={cvMeta.title}>
        <p class="cv-tag">{cvMeta.tagline}</p>
      </PageHead>

      <section class="cx no-print" aria-label="Download">
        <div class="cx-h"><b>Files</b><span>PDF, Markdown and machine-readable copies</span></div>
        <div class="cx-b cv-actions">
          <a href={cvMeta.pdfUrl} class="cv-pdf" download={cvMeta.pdfFileName}>
            <span class="cv-pdf-k">PDF</span><span class="cv-pdf-v">Download CV <small>Gokhan_Turhan_CV.pdf</small></span><span aria-hidden="true">↓</span>
          </a>
          <a href="/cv.md" class="cv-md">CV as Markdown <small>/cv.md · for agents</small></a>
        </div>
        <div class="cx-r"><span>Machine-readable</span><span><a href="/cv.json">JSON</a> · <a href="/cv/plain.txt">Plain text</a> · <a href="/cv/raw.html">Raw HTML</a> · <a href="/cv.md">Markdown</a></span></div>
        <div class="cx-r"><span>Updated</span><span>{cvMeta.lastUpdated}</span></div>
      </section>

      <section class="cx" id="contact" aria-labelledby="contact-heading">
        <div class="cx-h"><b id="contact-heading">Contact</b><span>DMs are open</span><em>{String(contact.length).padStart(2, '0')}</em></div>
        <address class="cv-addr">
          {contact.map((c) => (
            <div class="cx-r"><span>{c.label}</span><span>{c.url ? <a href={c.url} rel="noopener noreferrer">{c.value}</a> : c.value}</span></div>
          ))}
          <div class="cx-b">DMs are open.</div>
        </address>
      </section>

      <section class="cx" aria-labelledby="profile-heading">
        <div class="cx-h"><b id="profile-heading">Profile</b></div>
        <div class="cx-b cv-prose">{profile.map((p) => <p>{p}</p>)}</div>
      </section>

      <section class="cx" aria-labelledby="exp-heading">
        <div class="cx-h"><b id="exp-heading">Experience</b><span>roles, newest first</span><em>{String(experience.length).padStart(2, '0')}</em></div>
        {experience.map((job) => (
          <div class="cx-r cv-row">
            <span><time datetime={job.start}>{job.start}</time> – <time datetime={job.end}>{job.end}</time></span>
            <span>
              <strong>{job.role}</strong> — {ORG_PAGE[job.org] ? <a href={ORG_PAGE[job.org]}>{job.org}</a> : job.org}
              {job.location && <i class="cv-loc">{job.location}</i>}
              <ul class="cv-list">{job.bullets.map((b) => <li>{b}</li>)}</ul>
            </span>
          </div>
        ))}
      </section>

      <section class="cx" aria-labelledby="edu-heading">
        <div class="cx-h"><b id="edu-heading">Education</b><em>{String(education.length).padStart(2, '0')}</em></div>
        {education.map((ed) => (
          <div class="cx-r cv-row">
            <span>{ed.years}</span>
            <span>
              <strong>{ed.degree}{'honors' in ed && ed.honors ? ` — ${ed.honors}` : ''}</strong><br />{ed.school}
              {'detail' in ed && ed.detail && <><br />{thesis ? <a href={thesis.href}>{ed.detail}</a> : ed.detail}</>}
              {'link' in ed && ed.link && <><br /><a href={ed.link} rel="noopener noreferrer">{ed.linkLabel ?? 'Link'}</a></>}
            </span>
          </div>
        ))}
      </section>

      <section class="cx" aria-labelledby="pub-heading">
        <div class="cx-h"><b id="pub-heading">Publications &amp; exhibitions</b><em>{String(pubRows.length).padStart(2, '0')}</em></div>
        {pubRows.map((r, i) => (
          <div class="cx-r cv-row"><span>{String(i + 1).padStart(2, '0')}</span><span>{r.href ? <a href={r.href}>{r.label}</a> : r.label}{r.meta && <> — {r.meta}</>}</span></div>
        ))}
      </section>

      <section class="cx" aria-labelledby="skills-heading">
        <div class="cx-h"><b id="skills-heading">Skills &amp; tooling</b><em>{String(skillGroups.length).padStart(2, '0')}</em></div>
        {skillGroups.map((g) => (
          <div class="cx-r cv-row"><span>{g.name}</span><span><ul class="cv-list plain">{g.items.map((item) => <li>{item}</li>)}</ul></span></div>
        ))}
      </section>

      <section class="cx" aria-labelledby="lang-heading">
        <div class="cx-h"><b id="lang-heading">Languages</b><em>{String(languages.length).padStart(2, '0')}</em></div>
        {languages.map((l) => (
          <div class="cx-r"><span>{l.name}</span><span>{l.level}</span></div>
        ))}
      </section>
    </div>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </div>

  {/* Print-only: identical layout to the downloadable PDF (Cmd+P === Download PDF) */}
  <div class="cv-print" aria-hidden="true"><CvSheet /></div>
</BaseLayout>

<style>
  .cv-tag { margin: .6rem 0 0; color: var(--dim); }
  .cv-actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: stretch; border-bottom: 1px dotted var(--ink); }
  .cv-pdf { display: inline-flex; align-items: stretch; border: 2px solid var(--ink, currentColor); background: var(--ink, #111); color: var(--paper, #fff) !important; text-decoration: none !important; font: 600 15px/1 var(--mono, ui-monospace, monospace); letter-spacing: .04em; }
  .cv-pdf > span { display: inline-flex; align-items: center; padding: 12px 14px; }
  .cv-pdf-k { background: var(--red, #d0021b); color: #fff; }
  .cv-pdf-v small { font-weight: 400; opacity: .75; margin-left: .6em; font-size: 12px; }
  .cv-pdf:hover { background: var(--ikb, #002fa7); border-color: var(--ikb, #002fa7); }
  .cv-md { display: inline-flex; align-items: center; padding: 12px 14px; border: 2px solid var(--ink, currentColor); color: var(--ink) !important; text-decoration: none !important; font: 600 14px/1 var(--mono, ui-monospace, monospace); }
  .cv-md small { font-weight: 400; opacity: .7; margin-left: .6em; font-size: 12px; }
  .cv-md:hover { background: var(--ink, #111); color: var(--paper, #fff) !important; }
  .cv-addr { font-style: normal; }
  .cv-addr .cx-b { border-top: 1px dotted var(--ink); }
  .cv-prose p { margin: 0 0 .8em; }
  .cv-prose p:last-child { margin-bottom: 0; }
  .cv-loc { display: block; font: normal 11px var(--mono); color: var(--dim); margin-top: 2px; }
  .cv-list { margin: .45rem 0 0; padding-left: 1.1rem; list-style: square; }
  .cv-list li + li { margin-top: .3rem; }
  .cv-list.plain { margin: 0; padding: 0; list-style: none; }
  .cv-row > :first-child { font-variant-numeric: tabular-nums; }
</style>

<style is:global>
  /* The print sheet is a copy of the downloadable PDF layout; hidden on screen. */
  .cv-print { display: none; }

  @media print {
    @page { margin: 0; }
    html, body { margin: 0 !important; padding: 0 !important; background: var(--paper) !important; }

    /* Hide everything except the embedded print sheet:
       - body-level overlays (theme/cookie/offline/lightbox) that aren't the layout wrapper
       - site chrome (nav/footer) and the on-screen CV */
    body > *:not(.relative):not(.cv-print) { display: none !important; }
    nav, header, footer, .cv-screen, .no-print { display: none !important; }

    /* Lift the sheet to the page origin, independent of layout wrappers.
       The downloadable PDF is generated by printing this same page. */
    .cv-print {
      display: block !important;
      position: fixed !important;
      inset: 0 !important;
      margin: 0 !important;
      background: var(--paper) !important;
      z-index: 2147483647 !important;
    }
  }
</style>
