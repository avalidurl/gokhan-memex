---
import { cdnImage, cdnSrcset } from '@/lib/cdn-image'
const src = '/images/cf-images-sync-test.png'
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>cf-images sync test</title>
  </head>
  <body>
    <img
      src={cdnImage(src, 800)}
      srcset={cdnSrcset(src)}
      sizes="32px"
      width="32"
      height="32"
      alt="cf-images sync test"
    />
  </body>
</html>
