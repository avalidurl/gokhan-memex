---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHead from '@/components/PageHead.astro'
import Tags from '@/components/Tags.astro'
import { tools, toolTags } from '@/data/estate'

const groups = [
  { id: 'personal', label: 'Personal', note: 'my own day-to-day tools' },
  { id: 'estate-admin', label: 'Product admin', note: 'operator consoles for the products' },
  { id: 'research', label: 'Research', note: 'working research tools' },
] as const
const slugOf = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
---

<BaseLayout
  title="Tools"
  description="The private tools I use: a personal reader, a dealflow inbox, product admin consoles and research tools. They sit behind sign-in, so only what each one does is listed."
>
  <div class="es">
    <PageHead crumbs={[{ label: 'Index', href: '/' }, { label: 'private, behind sign-in' }]} title="Tools" count={tools.length} lead="The private tools behind my work. Each one sits behind sign-in, so this page says what it does and leaves out where it lives." />

    {groups.map((g) => {
      const list = tools.filter((t) => t.group === g.id)
      return list.length > 0 && (
        <section class="cx tools" id={g.id} aria-label={g.label}>
          <div class="cx-h"><b>{g.label}</b><span>{g.note}</span><em>{String(list.length).padStart(2, '0')}</em></div>
          {list.map((t) => (
            <div class="cx-r" id={slugOf(t.name)}>
              <span>{t.name}</span>
              <span>
                {t.line}
                {t.see && <> Related: <a href={t.see.href}>{t.see.label}</a>.</>}
                <br /><Tags tags={toolTags[t.name] ?? []} />
              </span>
            </div>
          ))}
        </section>
      )
    })}

    <section class="cx arch" aria-label="Access">
      <div class="cx-h"><b>Access</b></div>
      <div class="cx-b"><p>These tools are for my own use and are not open for sign-up. Public work lives on <a href="/products/">Products</a>, <a href="/product-drafts/">Drafts</a> and the <a href="/api/">API index</a>.</p></div>
    </section>
  </div>
</BaseLayout>
